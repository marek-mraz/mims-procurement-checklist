    req("R1.2",
      tr: "Der findes en måde at hente oplysninger om en entitet på ved at slå identifikatoren op i et system",
      en: "There exists a way to retrieve information about an entity by looking up the identifier within a system"),
    req("R1.3",
      tr: "hvis en unik identifikator peger på den samme entitet i flere systemer, er det muligt at udlede måden at slå oplysninger op om den i hvert af disse systemer",
      en: "if a unique identifier points to the same entity within multiple systems, it is possible to derive the way to look up information about it in each of these systems"),
    req("R1.4",
      tr: "hvis flere unikke identifikatorer peger på den samme entitet, er det muligt at kortlægge dem indbyrdes",
      en: "if a multiple [sic] unique identifiers point to the same entity, it is possible to map them"),
    req("R1.5",
      tr: "Det er muligt at oprette identifikatorer, der er persistente over tid",
      en: "It is possible to create identifiers that are persistent over time"),
    capability("C2", "Entities can be typed",
      tr: "Entiteter kan typespecificeres"),
    req("R2.1",
      tr: "Der er en måde at hente semantikken for en entitet på udelukkende ved brug af dens unikke identifikator",
      en: "There is a way to retreive [sic] the semantics of an entity, only using its unique identifier"),
    req("R2.2",
      tr: "Denne semantik er beskrevet i et maskinlæsbart format",
      en: "These semantics are described in a machine-readable format"),
    capability("C3", "Entities can be (de)referenced",
      tr: "Entiteter kan (de)refereres"),
    req("R3.1",
      tr: "Der findes en måde at dereferere en relation defineret på en entitet",
      en: "There exists a way to dereference a relation defined on an entity"),
    req("R3.2",
      tr: "Der findes en måde at anvende yderligere semantik på en eksisterende ontologi",
      en: "There exists a way to apply additional semantics to an existing ontology"),
    capability("M1", "Mechanism 1, section 3.1: Entity Identification with Globally Unique IRIs",
      tr: "Mekanisme 1, afsnit 3.1: Entitetsidentifikation med globalt unikke IRI'er"),
    req("§3.1",
      tr: "IRI'en behandles som den kanoniske identifikator i alle nedstrømssystemer; implementationer MÅ IKKE generere IRI'er, der indlejrer ustabile implementationsdetaljer såsom databaserække-id'er eller serverværtsnavne.",
      en: "The IRI is treated as the canonical identifier in all downstream systems; implementations MUST NOT generate IRIs that embed volatile implementation details such as database row IDs or server hostnames."),
  )

  #spec-link("Komplet specifikation:", "https://mims.oascities.org/interlinking-data")
]
