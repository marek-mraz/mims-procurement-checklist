    req("R4.1",
      tr: "LDT podpira delovne tokove, ki povezujejo vire podatkov, preoblikovanja podatkov, izvajanje modelov, simulacijske procese in izhode.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "LDT veriži korake delovnega toka, pri čemer se izhod enega koraka lahko uporabi kot vhod za drugega.",
