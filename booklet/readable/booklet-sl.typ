#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Kaj pravi specifikacija",
    leadin: "Vsaka zahteva tega MIM, dobesedno iz MIMs Plus 9.0: Specifikacija obstaja samo v angleščini: slovensko besedilo je neuradni prevod avtorja tega priročnika; izvirno angleško besedilo pod njim je zavezujoče.",
    back:   "nazaj na kontrolni seznam",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Pravila upravljanja za ekosistem deljenja podatkov je mogoče določiti"),
    req("RC1.1",
      tr: "Orkestrator podatkovnega ekosistema naj ima možnost opredeliti model upravljanja (npr. pravilnik), ki določa pravila članstva, vloge, odgovornosti in obveznosti udeležencev ekosistema ter splošna načela, ki urejajo izmenjavo podatkov med njimi.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Člani, ki sodelujejo v podatkovnem ekosistemu, naj bodo seznanjeni z njegovim modelom upravljanja in vsemi spremembami le-tega.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Model upravljanja naj bo zlahka razumljiv vsem udeležencem ekosistema.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Pogoje za deljenje podatkov je mogoče določiti"),
    req("RC2.1",
      tr: "Ponudniki podatkov lahko prosto določijo pogoje, pod katerimi želijo, da se njihovi podatki izmenjujejo. (Opomba: Pred deljenjem podatkovnih sredstev naj ponudniki podatkov zagotovijo, da imajo ustrezno dovoljenje lastnikov podatkov.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Pogoji za izmenjavo podatkov naj bodo opisani jasno in nedvoumno, tako da so zlahka razumljivi uporabnikom podatkov.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Pogoji za izmenjavo podatkov naj bodo izraženi s podatkovnimi licencami ali sporazumi o deljenju podatkov, ki temeljijo na natančno določenih predlogah ali standardih.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Pogoji naj bodo v skladu s celotnim modelom upravljanja podatkovnega ekosistema in z njim ne smejo biti v nasprotju. (Opomba: Ponudnik podatkov se lahko odloči, da ne bo sodeloval v podatkovnem ekosistemu, če je temeljni model upravljanja preveč omejevalen ali preveč dopustilen.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Skladnost s pogoji deljenja podatkov je mogoče preveriti"),
    req("RC3.1",
      tr: "Orkestrator podatkovnega ekosistema mora imeti možnost ugotavljanja skladnosti svojih udeležencev s temeljnim modelom upravljanja.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Ponudniki podatkov naj imajo možnost ugotavljanja, ali je uporaba podatkov s strani uporabnika podatkov v skladu s predhodno dogovorjenimi pogoji.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Uporabniki podatkov naj imajo možnost ugotavljanja, ali ponudnikovo zagotavljanje podatkov sledi predhodno dogovorjenim pogojem.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Razpoložljiva podatkovna sredstva je mogoče odkriti"),
    req("RC4.1",
      tr: "Uporabniki podatkov naj imajo možnost odkriti, kateri podatki so na voljo v ekosistemu deljenja podatkov, ne da bi o tem predhodno vedeli.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Podatkovna sredstva naj bodo ustrezno opisana z metapodatki, da lahko uporabniki podatkov sprejemajo zanesljive odločitve o njihovi nadaljnji predvideni uporabi.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Metapodatki, uporabljeni za opis podatkovnih sredstev, naj temeljijo na dobro opredeljenih, lahko razumljivih opisnih formatih, ki so tako človeško kot strojno berljivi.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Udeležence ekosistema je mogoče odkriti"),
    req("RC5.1",
      tr: "Udeleženci ekosistema (npr. uporabniki in ponudniki podatkov) naj imajo možnost odkriti drug drugega v ekosistemu deljenja podatkov.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
