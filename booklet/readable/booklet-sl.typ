#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "Kaj pravi specifikacija",
    leadin: "Vsaka zahteva tega MIM, dobesedno iz MIMs Plus 9.0: Specifikacija obstaja samo v angleščini: slovensko besedilo je neuradni prevod avtorja tega priročnika; izvirno angleško besedilo pod njim je zavezujoče.",
    back:   "nazaj na kontrolni seznam",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Vse entitete, vključene v vire podatkov, so opisane z doslednimi podatkovnimi modeli, da se omogoči interoperabilnost aplikacij in sistemov"),
    req("R1.1",
      tr: "Podatkovni modeli, uporabljeni za vse entitete v katerem koli viru podatkov, morajo biti izrecno navedeni. Biti morajo dobro dokumentirani in imeti opisne metapodatke, pri čemer morajo biti uporabljeni izrazi semantično nedvoumni. Za atribute, povezane z merskimi enotami, časovnimi formati itd., morajo biti uporabljene enote, formati itd. izrecno navedeni. Podatkovni modeli naj bodo katalogizirani, da jih je mogoče zlahka najti.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "Uporabljeni podatkovni modeli morajo (kjer koli je mogoče) temeljiti na splošno priznanih standardiziranih podatkovnih modelih, kot so navedeni spodaj",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Kjer ni mogoče uporabiti obstoječih standardiziranih podatkovnih modelov, si je treba prizadevati za razširitev obstoječih standardiziranih podatkovnih modelov, ki so najbolj usklajeni, ali za opredelitev novih, ob upoštevanju najboljših praks in dogovorov skupnosti ali organizacije, ki opredeljuje podatkovne modele.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "Uporabljeni podatkovni modeli morajo podpirati izmenjavo podatkov z uporabo ustreznih zahtev MIM o dostopu do podatkov in povezovanju podatkov",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Različne podatkovne modele za isto entiteto, ki se uporabljajo v skupnem ekosistemu za deljenje podatkov, bi moralo biti mogoče zlahka preoblikovati v skupni podatkovni model"),
    req("R2.1",
      tr: "Za vsak podatkovni ekosistem naj se razvije skupni podatkovni model za vsako ključno entiteto. Ta skupni podatkovni model naj vsebuje vsa polja, vključena v različne podatkovne modele za to entiteto, ki se uporabljajo v tem podatkovnem ekosistemu. Vsak različen podatkovni model, uporabljen v tem podatkovnem ekosistemu, bi se nato lahko preoblikoval v skupni podatkovni model.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Vse podatke in z njimi povezane metapodatke je mogoče deliti v odprtih, standardiziranih formatih za prenos podatkov, tako da si lahko različna orodja in implementacije izmenjujejo ter dosledno razlagajo podatke"),
    req("R3.1",
      tr: "Vsak uporabljeni podatkovni model mora imeti vsaj en opredeljen strojno berljiv format za prenos podatkov (»serializacijo«), ki je odprt, javno dostopen in neodvisen od izvedbe.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "Dokumentacija formata za prenos podatkov naj zadošča za omogočanje izdelave nelastniške aplikacije ali tolmača, ki je sposoben rekonstruirati vse podatke, shranjene v takem podatkovnem formatu.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Kjer je za isti podatkovni model podprtih več formatov za prenos podatkov, morajo ti dosledno in brez izgube pomena predstavljati isto vsebinsko informacijo.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "Predstavitev naj podpira preverjanje veljavnosti z uporabo javno objavljenih shem, gramatik ali enakovrednih strojno berljivih omejitev, kjer takšni mehanizmi preverjanja za izbrani format obstajajo.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "Kadar je to koristno, naj bo mogoče za podatkovni model ustvariti »aplikacijske profile«, tako da se lahko dodajo ali določijo atributi, specifični za primer uporabe, ne da bi se spremenil temeljni podatkovni model"),
    req("R4.1",
      tr: "Aplikacijski profili, ki razširjajo podatkovni model, naj ne vplivajo na že obstoječi model in njegove uporabnike",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "Specializacije ali razširitve, uvedene v aplikacijskem profilu modela, naj bodo dobro dokumentirane, ločeno od osnovnega podatkovnega modela",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("Celotna specifikacija:", "https://mims.oascities.org/representing-data")
]
