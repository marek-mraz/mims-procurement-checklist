    refs: "MIM1 R1.2, R2.1, R2.2",
    num:  "1.2")

  #item("Kun sama reaalimaailman kohde esiintyy useissa järjestelmissä, tunnisteet voidaan kohdistaa toisiinsa.",
    why:  "Paikkatietojärjestelmän ja energiajärjestelmän rakennus voidaan osoittaa samaksi rakennukseksi.",
    refs: "MIM1 R1.3, R1.4",
    num:  "1.3")

  #item("Tunnisteet eivät sisällä toimittajan sisäisiä rakenteita (tietokannan rivitunnisteita, palvelinten nimiä).",
    why:  "Muutoin tunnisteet lakkaavat toimimasta sopimuksen päättyessä.",
    refs: "MIM1 M1 §3.1",
    num:  "1.4")

  #panels(
    why:   ("Miksi asialla on merkitystä", (
      "Kymmenen vuoden mittaukset pysyvät kytkettyinä oikeaan valaisinpylvääseen.",
      "Hallintokunnat lakkaavat ylläpitämästä viittä keskenään ristiriitaista rekisteriä samoista kohteista.",
      "Tietoaineistojen linkittämisestä tulee kysely eikä konsulttihanke.",
    )),
    flags: ("Varoitusmerkit", (
      "”Tunnisteet ovat alustamme sisäisiä.”",
      "Tunnisteet luodaan uudelleen jokaisessa datamigraatiossa.",
    )),
  )
]
