    law("Avoimen datan direktiivi", "Direktiivi (EU) 2019/1024",
      "arvokkaat tietoaineistot julkaistaan maksutta, koneluettavassa muodossa rajapintojen (API) kautta."),
    law("NIS2-direktiivi", "Direktiivi (EU) 2022/2555",
      "kyberturvallisuuden vähimmäistaso; kansallinen lainsäädäntö ratkaisee, miten laajasti se koskee paikallishallintoa."),
    law("GDPR", "Asetus (EU) 2016/679",
      "henkilötiedot kaupungin järjestelmissä (pysäköinti, kamerat, liikkuminen)."),
    law("Tekoälysäädös", "Asetus (EU) 2024/1689",
      "tekoälyjärjestelmiä koskevat säännöt; merkityksellinen digitaalisten kaksosten tekoälymalleille."),
