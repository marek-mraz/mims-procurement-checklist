//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Mitä määritys sanoo",
    leadin: "Tämän MIM-mekanismin jokainen vaatimus, suoraan MIMs Plus 9.0 -määrityksestä: Määritys on saatavilla vain englanniksi: suomenkielinen teksti on tämän oppaan laatijan epävirallinen käännös; sen alla oleva englanninkielinen alkuperäisteksti on sitova.",
    back:   "takaisin tarkistuslistaan",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Datanjakoekosysteemin hallintasäännöt voidaan määritellä"),
    req("RC1.1",
      tr: "Dataekosysteemin orkestroijan tulisi kyetä määrittelemään hallintamalli (esim. sääntökirja), jossa esitetään jäsenyyssäännöt, ekosysteemin osallistujien roolit, vastuut ja velvoitteet sekä yleiset periaatteet, jotka ohjaavat heidän välistään datanvaihtoa.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Dataekosysteemiin osallistuvien jäsenten tulisi olla tietoisia sen hallintamallista ja siihen tehdyistä muutoksista.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Hallintamallin tulisi olla helposti ymmärrettävissä kaikille ekosysteemin osallistujille.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Datanjaon ehdot voidaan määritellä"),
    req("RC2.1",
      tr: "Datan tarjoajat voivat vapaasti määritellä ehdot, joiden mukaisesti ne haluavat dataansa vaihdettavan. (Huomautus: Ennen data-aineistojen jakamista datan tarjoajien tulisi varmistaa, että niillä on asianmukainen lupa datan omistajilta.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Datanvaihdon ehdot tulisi kuvata selkeästi ja yksiselitteisesti, jotta ne ovat helposti ymmärrettävissä datan käyttäjille.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Datanvaihdon ehdot tulisi ilmaista datalisensseillä tai datanjakosopimuksilla, jotka perustuvat selkeästi määriteltyihin malleihin tai standardeihin.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Ehtojen tulisi olla linjassa dataekosysteemin yleisen hallintamallin kanssa eivätkä ne saa olla ristiriidassa sen kanssa. (Huomautus: Datan tarjoaja voi päättää olla osallistumatta dataekosysteemiin, jos taustalla oleva hallintamalli on liian rajoittava tai liian salliva.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Datanjaon ehtojen noudattaminen voidaan vahvistaa"),
    req("RC3.1",
      tr: "Dataekosysteemin orkestroijan on kyettävä varmistamaan osallistujiensa vaatimustenmukaisuus suhteessa taustalla olevaan hallintamalliin.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Datan tarjoajien tulisi kyetä varmistamaan, että datan käyttäjän suorittama datan käyttö noudattaa aiemmin sovittuja ehtoja.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Datan käyttäjien tulisi kyetä varmistamaan, että datan tarjoajan suorittama datan toimitus noudattaa aiemmin sovittuja ehtoja.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Saatavilla olevat data-aineistot voidaan löytää"),
    req("RC4.1",
      tr: "Datan käyttäjien tulisi kyetä löytämään, mitä dataa datanjakoekosysteemissä on saatavilla, ilman ennakkotietoa siitä.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Data-aineistot tulisi kuvata riittävästi metatiedoilla, jotta datan käyttäjät voivat tehdä luotettavia päätöksiä niiden aiotusta jatkokäytöstä.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
