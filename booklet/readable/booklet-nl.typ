    name:     "Georuimtelijke data",
    question: "Werkt het op een kaart?",
    url:      "https://mims.oascities.org/geospatial-data",
    intro:    "Vrijwel elk gemeentelijk object heeft een ruimtelijke locatie. MIM7 waarborgt dat die locatie geen statische afbeelding is: geodata wordt ontsloten via gestandaardiseerde OGC-interfaces, in open formaten en met een expliciet gedeclareerd coördinatenstelsel — zodat elke kaartlaag die u inkoopt naadloos past op de kaarten die u al heeft.",
    list:     "Checklist",
  )

  #item("Georuimtelijke data wordt ontsloten via op open standaarden gebaseerde interfaces (OGC API Features, SensorThings; WFS acceptabel voor bestaande systemen).",
    why:  "Elk gangbaar GIS-pakket kan de gegevens direct en zonder conversie inlezen.",
    refs: "MIM7 R1.1",
    num:  "7.1")

  #item("Georuimtelijke data is gecodeerd in open standaarden (GeoJSON, CityJSON; GML/CityGML waar vereist).",
    why:  "Geen conversielicenties, geen doodlopende wegen.",
    refs: "MIM7 R2.1",
    num:  "7.2")

  #item("Het coördinatenreferentiesysteem is altijd expliciet gedeclareerd (EPSG-code) en data is transformeerbaar naar een gemeenschappelijk CRS.",
    why:  "Kaartlagen uit verschillende bronnen sluiten geografisch exact op elkaar aan.",
    refs: "MIM7 R5.1",
    num:  "7.3")

  #item("Ruimtelijke objecten dragen dezelfde persistente identificatiecodes als vereist onder MIM1.",
    why:  "Het punt op de digitale kaart en het object in de beheeradministratie zijn gegarandeerd hetzelfde object.",
    refs: "MIM7 R4.1",
    num:  "7.4")

  #panels(
    why:   ("Waarom dit van belang is", (
      "Eén stadskaart in plaats van tien viewers van leveranciers.",
      "Het voldoen aan de verplichtingen van INSPIRE en nationale geoportalen wordt eenvoudiger.",
      "3D- en BIM-data kunnen later hetzelfde beeld aanvullen.",
    )),
    flags: ("Alarmsignalen", (
      "Kaartdata is uitsluitend te raadplegen in de viewer van de leverancier.",
      "“Exporteren als PDF/schermafbeelding.”",
    )),
  )
]
