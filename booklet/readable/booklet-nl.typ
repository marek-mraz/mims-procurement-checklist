      en: "if a multiple [sic] unique identifiers point to the same entity, it is possible to map them"),
    req("R1.5",
      tr: "Het is mogelijk om identificatiecodes aan te maken die persistent zijn over de tijd",
      en: "It is possible to create identifiers that are persistent over time"),
    capability("C2", "Entities can be typed",
      tr: "Entiteiten kunnen worden getypeerd"),
    req("R2.1",
      tr: "Er is een methode om de semantiek van een entiteit op te halen, uitsluitend met gebruik van haar unieke identificatiecode",
      en: "There is a way to retreive [sic] the semantics of an entity, only using its unique identifier"),
    req("R2.2",
      tr: "Deze semantiek is beschreven in een machineleesbaar formaat",
      en: "These semantics are described in a machine-readable format"),
    capability("C3", "Entities can be (de)referenced",
      tr: "Entiteiten kunnen worden (ge)derefereerd"),
    req("R3.1",
      tr: "Er bestaat een methode om een relatie die op een entiteit is gedefinieerd te derefereren",
      en: "There exists a way to dereference a relation defined on an entity"),
    req("R3.2",
      tr: "Er bestaat een methode om aanvullende semantiek toe te passen op een bestaande ontologie",
      en: "There exists a way to apply additional semantics to an existing ontology"),
    capability("M1", "Mechanism 1, section 3.1: Entity Identification with Globally Unique IRIs",
      tr: "Mechanisme 1, paragraaf 3.1: Entiteitsidentificatie met wereldwijd unieke IRI's"),
    req("§3.1",
      tr: "De IRI wordt behandeld als de canonieke identificatiecode in alle downstream-systemen; implementaties MOGEN GEEN IRI's genereren die vluchtige implementatiedetails zoals database-rij-ID's of server-hostnamen bevatten.",
      en: "The IRI is treated as the canonical identifier in all downstream systems; implementations MUST NOT generate IRIs that embed volatile implementation details such as database row IDs or server hostnames."),
  )

  #spec-link("Volledige specificatie:", "https://mims.oascities.org/interlinking-data")
]
