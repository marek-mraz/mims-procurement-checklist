#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Wat de specificatie voorschrijft",
    leadin: "Elke eis van deze MIM, letterlijk overgenomen uit MIMs Plus 9.0: De specificatie is uitsluitend beschikbaar in het Engels: de Nederlandse tekst betreft een niet-officiële vertaling van de auteur van deze gids; het onderstaande Engelse origineel is juridisch bindend.",
    back:   "terug naar de checklist",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Governanceregels voor het ecosysteem voor gegevensuitwisseling kunnen worden gedefinieerd"),
    req("RC1.1",
      tr: "De beheerder van een data-ecosysteem zou in staat moeten zijn een governancemodel (bijv. een reglement) vast te stellen dat de lidmaatschapsregels, de rollen, verantwoordelijkheden en verplichtingen van deelnemers aan het ecosysteem, en de algemene principes die de gegevensuitwisseling tussen hen beheersen, uiteenzet.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Deelnemers die deelnemen aan een data-ecosysteem zouden op de hoogte moeten zijn van het governancemodel en eventuele daarin aangebrachte wijzigingen.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Het governancemodel zou gemakkelijk begrijpelijk moeten zijn voor alle deelnemers aan het ecosysteem.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Voorwaarden voor gegevensuitwisseling kunnen worden gedefinieerd"),
    req("RC2.1",
      tr: "Dataleveranciers zijn vrij om de voorwaarden te bepalen waaronder zij willen dat hun data wordt uitgewisseld. (Opmerking: Voordat data-assets worden gedeeld, zouden dataleveranciers moeten controleren of zij over adequate toestemming van de data-eigenaren beschikken.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Voorwaarden voor een gegevensuitwisseling zouden duidelijk en ondubbelzinnig moeten worden beschreven, zodat ze gemakkelijk begrijpelijk zijn voor datagebruikers.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Voorwaarden voor een gegevensuitwisseling zouden moeten worden uitgedrukt via datalicenties of overeenkomsten voor gegevensuitwisseling gebaseerd op duidelijk gedefinieerde formats of standaarden.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Voorwaarden zouden in overeenstemming moeten zijn met het overkoepelende governancemodel van het data-ecosysteem en mogen er niet mee in strijd zijn. (Opmerking: Een dataleverancier kan besluiten niet deel te nemen aan een data-ecosysteem als het onderliggende governancemodel te restrictief of te permissief is.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Naleving van voorwaarden voor gegevensuitwisseling kan worden gevalideerd"),
    req("RC3.1",
      tr: "De beheerder van een data-ecosysteem moet in staat zijn de naleving door de deelnemers van het onderliggende governancemodel te verifiëren.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Dataleveranciers zouden in staat moeten zijn te verifiëren dat het gebruik van data door een datagebruiker voldoet aan vooraf overeengekomen voorwaarden.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Datagebruikers zouden in staat moeten zijn te verifiëren dat de levering van data door de dataleverancier voldoet aan vooraf overeengekomen voorwaarden.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Beschikbare data-assets kunnen worden ontdekt"),
    req("RC4.1",
      tr: "Datagebruikers zouden moeten kunnen ontdekken welke data beschikbaar is in een ecosysteem voor gegevensuitwisseling zonder voorafgaande kennis daarvan.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Data-assets zouden adequaat moeten worden beschreven met metadata, zodat datagebruikers betrouwbare beslissingen kunnen nemen over het beoogde verdere gebruik ervan.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Metadata die wordt gebruikt om data-assets te beschrijven, zou moeten worden gebaseerd op duidelijk gedefinieerde, gemakkelijk te begrijpen beschrijvingsformaten die zowel mens- als machineleesbaar zijn.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Deelnemers aan het ecosysteem kunnen worden ontdekt"),
    req("RC5.1",
      tr: "Deelnemers aan het ecosysteem (bijv. datagebruikers en dataleveranciers) zouden elkaar moeten kunnen vinden binnen een ecosysteem voor gegevensuitwisseling.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Er zou voldoende metadata over elke deelnemer aan het ecosysteem beschikbaar moeten zijn om hun betrouwbaarheid met betrekking tot gegevensuitwisseling te verifiëren.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Dataleveranciers zouden in staat moeten zijn datagebruikers die toegang willen tot hun data-assets betrouwbaar te identificeren en hun metadata te verifiëren alvorens toegang te verlenen.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Datagebruikers zouden in staat moeten zijn dataleveranciers die data delen in een data-ecosysteem te identificeren alvorens die data te openen of te gebruiken.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Deelnemers aan het ecosysteem mogen er ook voor kiezen anoniem te blijven als het governancemodel van het ecosysteem voor gegevensuitwisseling dit toestaat. In dat geval kan RC5.1 tot en met RC5.4 worden genegeerd.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Data-uitwisseling kan worden overeengekomen"),
    req("RC6.1",
      tr: "Datagebruikers en dataleveranciers zouden moeten kunnen instemmen met een gegevensuitwisseling en de daaraan verbonden voorwaarden (bijv. aanvaarding van voorwaarden, juridische ondertekening van een overeenkomst, of onderhandeling).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Datagebruikers en dataleveranciers zouden een eerder overeengekomen gegevensuitwisseling moeten kunnen beëindigen in overeenstemming met de daaraan verbonden voorwaarden.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Waar mogelijk mogen elektronische middelen voor de instemming met en de beëindiging van een gegevensuitwisseling worden geboden.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Nieuwe data die momenteel niet beschikbaar is kan worden aangevraagd"),
    req("RC7.1",
      tr: "Datagebruikers zouden hun belangstelling moeten kunnen kenbaar maken voor data-assets die momenteel niet beschikbaar zijn in het ecosysteem voor gegevensuitwisseling.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Dataleveranciers zouden verzoeken van datagebruikers om nieuwe data-assets moeten kunnen ontvangen.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Volledige specificatie:", "https://mims.oascities.org/exchanging-data")
]
