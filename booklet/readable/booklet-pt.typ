#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "O que diz a especificação",
    leadin: "Todos os requisitos deste MIM, transcritos integralmente dos MIMs Plus 9.0: A especificação existe apenas em inglês: a versão em português (Portugal) é uma tradução não oficial da responsabilidade do autor deste guia; o texto original inglês apresentado abaixo prevalece.",
    back:   "voltar à lista de verificação",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Todas as entidades constantes das fontes de dados são descritas mediante modelos de dados consistentes, de modo a assegurar a interoperabilidade entre sistemas e aplicações"),
    req("R1.1",
      tr: "Os modelos de dados utilizados para todas as entidades em qualquer fonte de dados devem ser explicitados. Devem encontrar-se devidamente documentados e dispor de metadados descritivos, nos quais os termos utilizados devem ser semanticamente inequívocos. No que respeita aos atributos relativos a unidades de medida, formatos temporais, etc., as unidades, formatos, etc. utilizados devem ser formalmente explicitados. Os modelos de dados deveriam estar catalogados por forma a assegurar a sua fácil localização.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "Os modelos de dados utilizados devem basear-se (sempre que viável) em modelos de dados normalizados de uso corrente, conforme identificados infra",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Nas situações em que não seja possível utilizar modelos de dados normalizados existentes, devem ser desenvolvidos esforços no sentido de alargar os modelos normalizados existentes que apresentem maior aproximação estrutural ou definir novos modelos, observando as melhores práticas e convenções da comunidade ou organismo responsável pela sua definição.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "Os modelos de dados adotados devem suportar a troca de informação com base na aplicação dos requisitos pertinentes dos MIMs sobre Acesso aos Dados e Interligação de Dados",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Os diferentes modelos de dados associados a uma mesma entidade utilizados num ecossistema de partilha deveriam ser facilmente convertíveis para um modelo de dados comum"),
    req("R2.1",
      tr: "Deveria ser desenvolvido um modelo de dados comum para cada entidade estruturante em qualquer ecossistema de dados. Esse modelo de dados comum deveria contemplar a totalidade dos campos integrantes dos diversos modelos de dados dessa entidade em utilização no âmbito desse ecossistema. Cada modelo de dados distinto utilizado nesse ecossistema de dados poderia, assim, ser objeto de conversão para o modelo de dados comum.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Quaisquer dados e respetivos metadados associados podem ser partilhados através de formatos de transporte normalizados e abertos, garantindo a sua troca e interpretação coerente entre ferramentas e implementações técnicas distintas"),
    req("R3.1",
      tr: "Cada modelo de dados em utilização deve dispor de, pelo menos, um formato estruturado de transporte de dados («serialização») legível por máquina que seja aberto, de acesso público e independente de implementações técnicas proprietárias.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "A documentação técnica do formato de transporte de dados deveria apresentar detalhe suficiente para permitir o desenvolvimento de aplicações ou módulos de interpretação não proprietários capazes de reconstituir integralmente os dados armazenados no referido formato.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Sempre que sejam suportados múltiplos formatos de transporte para o mesmo modelo de dados, estes devem traduzir com coerência o mesmo conteúdo informativo, sem degradação do respetivo significado.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "A representação adotada deveria suportar a validação através de esquemas publicados de acesso livre, gramáticas ou regras restritivas equivalentes legíveis por máquina, sempre que tais mecanismos de validação existam para o formato adotado.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "Sempre que conveniente, deveria ser possível definir «Perfis de Aplicação» para um modelo de dados, por forma a permitir a inclusão ou a especificação de atributos próprios de um caso de uso sem alterar o modelo de dados de base"),
    req("R4.1",
      tr: "Os perfis de aplicação que estendam um modelo de dados não devem afetar o modelo já existente e os seus utilizadores",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "As especificações particulares ou extensões integradas no Perfil de Aplicação do modelo de dados deveriam encontrar-se integralmente documentadas, de forma autónoma em relação ao modelo de dados principal",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("Especificação integral:", "https://mims.oascities.org/representing-data")
]
