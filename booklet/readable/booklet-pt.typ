  #spec-list(mim: "MIM7",
    capability("C1", "Cities and communities can easily transfer geospatial data between internal and external (including IoT-related) IT systems",
      tr: "Os municípios e comunidades podem transferir com facilidade informação geográfica entre sistemas de informação internos e externos (incluindo sistemas IoT)"),
    req("R1.1",
      tr: "A informação geográfica deve ser disponibilizada através de uma interface de serviço web baseada em normas abertas.",
      en: "Geospatial data shall be exposed through a standards-based web service interface."),
    capability("C2", "Cities and communities can integrate 2D and 3D geospatial data coming from a variety of sources, for example geodata and building information models, and share that data within and between them in an interoperable way",
      tr: "Os municípios e comunidades podem integrar dados espaciais 2D e 3D originários de diversas fontes, tais como informação geográfica e modelos BIM, e partilhá-los de forma interoperável"),
    req("R2.1",
      tr: "A informação geográfica deve ser codificada com recurso a normas abertas. Recomenda-se a adoção das normas técnicas de referência publicadas pelo OGC e pela BuildingSMART International.",
      en: "Geospatial data shall be encoded using open standards. It is recommended to use relevant standards from OGC and BuildingSMART International."),
    capability("C3", "Cities and communities can integrate geospatial data with other data that can provide further information about the context",
      tr: "Os municípios e comunidades podem integrar dados geoespaciais com outras fontes de dados que forneçam contexto adicional"),
    req("R3.1",
      tr: "Todos os conjuntos de dados que facultem informação complementar e enquadramento contextual aos dados geoespaciais devem observar o disposto nos MIM1 e MIM2.",
      en: "All data sets used to provide further information about the context covered by geospatial data shall comply with MIM1 and MIM2."),
    capability("C4", "Cities and communities have a consistent and persistent way of describing individual instances of all features, things or entities included in the geospatial data sources",
      tr: "Os municípios e comunidades dispõem de um método coerente e persistente para identificar instâncias individuais de todos os elementos, objetos ou entidades presentes nas fontes de dados georreferenciados"),
    req("R4.1",
      tr: "Devem ser utilizados identificadores únicos e persistentes para a identificação inequívoca de quaisquer instâncias ou entidades constantes dos conjuntos de dados. (Consultar MIM1: Interligação de Dados.)",
      en: "Unique and persistent identifiers shall be used to identify particular instances of any entity used in data sets. (See MIM1: Interlinking Data.)"),
    capability("C5", "Coordinate Reference Systems (CRS) used in data sharing are easily transformable into a common CRS",
      tr: "Os Sistemas de Referência de Coordenadas (SRC) aplicados na partilha de dados podem ser facilmente convertidos para um SRC comum"),
    req("R5.1",
      tr: "Os Sistemas de Referência de Coordenadas (SRC) devem estar conformes com as normas internacionais, devendo ser expressamente indicada a norma técnica adotada (por exemplo, EPSG:4326, EPSG:3857). Essa indicação deve contemplar o código EPSG ou identificador WGS, bem como eventuais variações com base em sistemas de projeção cartográfica nacionais como o LKS-92 da Letónia, de modo a viabilizar a transformação e reprojeção dos dados para um SRC comum. (Nota: No espaço da União Europeia, os dados geoespaciais devem dispor de metadados conformes com as orientações da Diretiva INSPIRE, incluindo a informação técnica indispensável à caracterização do respetivo SRC.)",
      en: "Coordinate Reference Systems (CRS) shall comply with standards, and information shall be provided regarding which standard (e.g. EPSG:4326, EPSG:3857) is being used. This includes the EPSG number or WGS number, along with information about any variation based on national systems such as the Latvian LKS-92, so that data can be transformed to a common CRS. (Note: Within the EU, for geospatial data it is required to use metadata compliant with the INSPIRE Directive, including the metadata needed to describe the CRS information.)"),
  )

  #spec-link("Especificação integral:", "https://mims.oascities.org/geospatial-data")
