    req("R1.5",
      tr: "É possível criar identificadores que sejam persistentes ao longo do tempo",
      en: "It is possible to create identifiers that are persistent over time"),
    capability("C2", "Entities can be typed",
      tr: "As entidades podem ser tipificadas"),
    req("R2.1",
      tr: "Existe um método para obter a semântica de uma entidade, utilizando exclusivamente o seu identificador único",
