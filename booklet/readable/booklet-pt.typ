  #spec-list(mim: "MIM8",
    capability("C1", "Provide access to datasets used within the LDT, including static, real-time, and simulation data and calculation models",
      tr: "Assegurar o acesso aos conjuntos de dados integrados no LDT, abrangendo dados estáticos, dados em tempo real, resultados de simulação e modelos computacionais"),
    req("R1.1",
      tr: "O LDT deve assegurar o acesso às variáveis de saída de simulações e aos dados de entrada dos modelos de cálculo sempre que estes intervenham no âmbito dos fluxos de processamento do LDT.",
      en: "The LDT shall provide access to simulation outputs and calculation-model inputs where these are needed as part of LDT workflows."),
    req("R1.2",
      tr: "O LDT deve distinguir com clareza entre dados brutos de origem, dados transformados prontos para fluxos de trabalho, entradas de modelos e saídas de modelos.",
      en: "The LDT should distinguish clearly between raw source data, transformed workflow-ready data, model inputs, and model outputs."),
