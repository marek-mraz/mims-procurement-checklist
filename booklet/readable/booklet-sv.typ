// ════════════════════════════════════════════════════════════════════════════
//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Vad specifikationen säger",
    leadin: "Varje krav i denna MIM, ordagrant från MIMs Plus 9.0: Specifikationen finns endast på engelska: den svenska lydelsen är en inofficiell översättning av författaren till denna skrift; det engelska originalet därunder är bindande.",
    back:   "tillbaka till checklistan",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Styrningsregler för datadelningsekosystemet kan definieras"),
    req("RC1.1",
      tr: "Orkestratören av ett dataekosystem bör kunna definiera en styrningsmodell (t.ex. ett regelverk) som beskriver regler för medlemskap, ekosystemdeltagarnas roller, ansvar och skyldigheter samt de övergripande principerna som styr datautbytet mellan dem.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Medlemmar som deltar i ett dataekosystem bör vara medvetna om dess styrningsmodell och eventuella ändringar som görs i den.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Styrningsmodellen bör vara lättbegriplig för alla ekosystemdeltagare.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Villkor för datadelning kan definieras"),
    req("RC2.1",
      tr: "Dataleverantörer är fria att definiera villkor under vilka de vill att deras data ska utbytas. (Obs: Innan datatillgångar delas bör dataleverantörer säkerställa att de har tillräckligt tillstånd från dataägarna.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Villkor för ett datautbyte bör beskrivas tydligt och otvetydigt så att de är lätta att förstå för dataanvändare.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Villkor för ett datautbyte bör uttryckas genom datalicenser eller datautbytesavtal baserade på väldefinierade mallar eller standarder.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Villkor bör vara i linje med dataekosystemets övergripande styrningsmodell och får inte stå i konflikt med den. (Obs: En dataleverantör kan välja att inte delta i ett dataekosystem om den underliggande styrningsmodellen är för restriktiv eller för tillåtande.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Efterlevnad av villkor för datadelning kan valideras"),
    req("RC3.1",
      tr: "Orkestratören av ett dataekosystem måste kunna fastställa att dess deltagare efterlever den underliggande styrningsmodellen.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Dataleverantörer bör kunna fastställa att en dataanvändares användning av data efterlever tidigare överenskomna villkor.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Dataanvändare bör kunna fastställa att dataleverantörens leverans av data följer tidigare överenskomna villkor.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Tillgängliga datatillgångar kan upptäckas"),
    req("RC4.1",
      tr: "Dataanvändare bör kunna upptäcka vilka data som är tillgängliga i ett datadelningsekosystem utan förhandskännedom om dem.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Datatillgångar bör beskrivas adekvat med metadata så att dataanvändare kan fatta tillförlitliga beslut om deras vidare avsedda användning.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Metadata som används för att beskriva datatillgångar bör baseras på väldefinierade, lättförståeliga beskrivningsformat som är både mänskligt läsbara och maskinläsbara.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Ekosystemdeltagare kan upptäckas"),
    req("RC5.1",
      tr: "Ekosystemdeltagare (t.ex. dataanvändare och dataleverantörer) bör kunna upptäcka varandra inom ett datadelningsekosystem.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Tillräckliga metadata om varje ekosystemdeltagare bör finnas tillgängliga för att fastställa deras pålitlighet relevant för datautbyte.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Dataleverantörer bör på ett tillförlitligt sätt kunna identifiera dataanvändare som vill få åtkomst till deras datatillgångar och verifiera deras metadata innan åtkomst beviljas.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Dataanvändare bör kunna identifiera dataleverantörer som delar data i ett dataekosystem innan de får åtkomst till eller använder dessa data.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Ekosystemdeltagare kan också välja att förbli anonyma om datadelningsekosystemets styrningsmodell tillåter det. I detta fall kan RC5.1 till RC5.4 ignoreras.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Datautbyte kan överenskommas"),
    req("RC6.1",
      tr: "Dataanvändare och dataleverantörer bör kunna enas om ett datautbyte och de villkor som är kopplade till det (t.ex. godkännande av villkor, juridisk underskrift av ett avtal eller förhandling).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Dataanvändare och dataleverantörer bör kunna avsluta ett tidigare överenskommet datautbyte i enlighet med de villkor som är kopplade till det.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Där så är möjligt kan elektroniska medel för överenskommelse om och avslutande av ett datautbyte tillhandahållas.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Nya data som för närvarande inte är tillgängliga kan begäras"),
    req("RC7.1",
      tr: "Dataanvändare bör kunna uttrycka sitt intresse för datatillgångar som för närvarande inte är tillgängliga i datadelningsekosystemet.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Dataleverantörer bör kunna ta del av förfrågningar som görs av dataanvändare gällande nya datatillgångar.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Fullständig specifikation:", "https://mims.oascities.org/exchanging-data")
]
