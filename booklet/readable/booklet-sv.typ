// ════════════════════════════════════════════════════════════════════════════
//  MIM6 · LEFT PAGE · CHECKLIST
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM6 checklist")[
  #mim-page(
    id:       "MIM6",
    name:     "Datasäkerhet",
    question: "Är vår data säker?",
    url:      "https://mims.oascities.org/securing-data",
    intro:    "Smarta städer är måltavlor för IT-angrepp. MIM6 håller räckvidden medvetet snäv och praktisk: kryptera data i rörelse, använd standardiserade inloggningar i stället för proprietära, samt styr och logga vem som har åtkomst till vad. Inget av detta är exotiskt – allt måste finnas i avtalet.",
    list:     "Checklista",
  )

  #item("All dataöverföring är krypterad (TLS 1.3 eller gällande bästa praxis).",
    why:  "Grundläggande IT-hygien; NIS2 kräver det också där det är tillämpligt för er.",
    refs: "MIM6 R2.1, M1.1",
    num:  "6.1")

  #item("Inloggning och maskinell åtkomst använder öppna standarder – OAuth 2.0 / OpenID Connect – och kan anslutas till kommunens befintliga identitetsutfärdare.",
    why:  "Ett konto per anställd, inte ett per leverantörsprodukt; personal som slutar blir av med behörigheten överallt samtidigt.",
    refs: "MIM6 R3.1, M1.2, M1.3",
    num:  "6.2")

  #item("Åtkomsträttigheter är rollbaserade, granskningsbara och kan återkallas; åtkomst och administrativa åtgärder loggas.",
    why:  "Revisioner och incidenthantering blir möjliga. Loggning motsvarar ISO/IEC 27001:2022, bilaga A, säkerhetsåtgärd 8.15, vilken MIM6 listar bland sina förutsättningar.",
    refs: "MIM6 R1.1, R1.3, 8.15",
    num:  "6.3")

  #item("Anbudsgivaren visar anpassning till ISO/IEC 27001:2022 (eller likvärdigt) för den tjänst som driftas.",
    why:  "Säkerhet är en process, inte en kryssruta vid leverans. Specifikationen hänvisar till åtgärderna i ISO/IEC 27001, inte ett formellt certifikat.",
