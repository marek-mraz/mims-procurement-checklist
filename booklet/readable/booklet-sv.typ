      tr: "om flera unika identifierare pekar på samma entitet, är det möjligt att mappa dem",
      en: "if a multiple [sic] unique identifiers point to the same entity, it is possible to map them"),
    req("R1.5",
      tr: "Det är möjligt att skapa identifierare som är beständiga över tid",
      en: "It is possible to create identifiers that are persistent over time"),
    capability("C2", "Entities can be typed",
      tr: "Entiteter kan typbestämmas"),
    req("R2.1",
      tr: "Det finns ett sätt att hämta semantiken för en entitet, enbart med hjälp av dess unika identifierare",
      en: "There is a way to retreive [sic] the semantics of an entity, only using its unique identifier"),
    req("R2.2",
      tr: "Denna semantik beskrivs i ett maskinläsbart format",
      en: "These semantics are described in a machine-readable format"),
    capability("C3", "Entities can be (de)referenced",
      tr: "Entiteter kan refereras (och derefereras)"),
    req("R3.1",
      tr: "Det finns ett sätt att dereferera en relation som definierats på en entitet",
      en: "There exists a way to dereference a relation defined on an entity"),
    req("R3.2",
      tr: "Det finns ett sätt att tillämpa ytterligare semantik på en befintlig ontologi",
      en: "There exists a way to apply additional semantics to an existing ontology"),
    capability("M1", "Mechanism 1, section 3.1: Entity Identification with Globally Unique IRIs",
      tr: "Mekanism 1, avsnitt 3.1: Entitetsidentifiering med globalt unika IRI:er"),
    req("§3.1",
      tr: "IRI:n behandlas som den kanoniska identifieraren i alla efterföljande system; implementeringar FÅR INTE generera IRI:er som bäddar in föränderliga implementeringsdetaljer såsom rader i databaser eller servervärdnamn.",
      en: "The IRI is treated as the canonical identifier in all downstream systems; implementations MUST NOT generate IRIs that embed volatile implementation details such as database row IDs or server hostnames."),
  )

  #spec-link("Fullständig specifikation:", "https://mims.oascities.org/interlinking-data")
]
