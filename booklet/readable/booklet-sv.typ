#fit-page("MIM8 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM8",
    title:  "Vad specifikationen säger",
    leadin: "Varje krav i denna MIM, ordagrant från MIMs Plus 9.0: Specifikationen finns endast på engelska: den svenska lydelsen är en inofficiell översättning av författaren till denna skrift; det engelska originalet därunder är bindande.",
    back:   "tillbaka till checklistan",
  )

  #spec-list(mim: "MIM8",
    capability("C1", "Provide access to datasets used within the LDT, including static, real-time, and simulation data and calculation models",
      tr: "Ge tillgång till datamängder som används inom den lokala digitala tvillingen, inklusive statiska data, realtidsdata, simuleringsdata och beräkningsmodeller"),
    req("R1.1",
      tr: "Den lokala digitala tvillingen ska ge tillgång till simuleringsresultat och indata för beräkningsmodeller där dessa behövs som en del av arbetsflöden i den lokala digitala tvillingen.",
      en: "The LDT shall provide access to simulation outputs and calculation-model inputs where these are needed as part of LDT workflows."),
    req("R1.2",
      tr: "Den lokala digitala tvillingen bör skilja tydligt mellan rå källdata, transformerade data förberedda för arbetsflöden, modellindata och modellutdata.",
      en: "The LDT should distinguish clearly between raw source data, transformed workflow-ready data, model inputs, and model outputs."),
    capability("C2", "Exchange data with external systems and other LDTs using interoperable interfaces",
      tr: "Utbyta data med externa system och andra lokala digitala tvillingar med hjälp av interoperabla gränssnitt"),
    req("C2",
      tr: "Denna förmåga förlitar sig på MIM3 (Datautbyte) för datautbyte.",
      en: "This capability relies on MIM3 (Exchanging Data) for data exchange."),
    capability("C3", "Reuse deterministic or AI models across different domains, communities, use cases, and/or LDTs",
      tr: "Återanvända deterministiska modeller eller AI-modeller över olika domäner, samhällen, användningsfall och/eller lokala digitala tvillingar"),
    req("R3.1",
      tr: "Modellen bör tillhandahålla standardiserade modellmetadata, inklusive en beskrivning av dess metoder och parametrar samt dataparametrar (antingen genom värde eller genom referens). För detta ändamål bör gemensamma metadatastandarder användas.",
      en: "The model should provide standard model metadata, including a description of its methods and parameters, and data-parameters (either by value or by reference). To this end common metadata standards should be used."),
    req("R3.2",
      tr: "Modellen ska exponera eller vara anropsbar via ett dokumenterat gränssnitt, företrädesvis med ett känt standardiserat API. Datamängden som utgör resultatet av modellen ska beskrivas (på datanivå).",
      en: "The model shall expose or be callable through a documented interface, preferably using a known standardised API. The dataset that forms the outcome of the model shall be described (at data-level)."),
    req("R3.3",
      tr: "Tillförlitlig, pålitlig och etisk användning av innovativa metoder (stora språkmodeller, agentbaserad AI osv.) bör säkerställas. Snedvridning (bias) bör minimeras där det är tillämpligt. De metoder som används för att garantera detta bör beskrivas.",
      en: "Trustworthy, reliable, and ethical use of innovative methods (LLMs, agentic AI, etc.) should be safeguarded. Bias should minimised [sic] where applicable. The methods used to guarantee this, should be described."),
    req("R3.4",
      tr: "Modellen måste kunna få åtkomst till data för slutanvändarens eller organisationens räkning. Se MIM3",
      en: "The model must be able to access data on behalf of the end-user or organisation. See MIM3"),
    req("R3.5",
      tr: "För data som ska användas i AI-modeller bör proveniens och tillförlitlighet garanteras. I vissa fall måste en auktoritativ källa, såsom en statlig myndighet, anges.",
      en: "For data to be used in AI models, provenance and trust should be guaranteed. In some cases, an authoratitive sourc [sic], such as a government agency must be listed."),
    capability("C4", "Coordinate and manage data, models, and processing workflows within an LDT (intra-LDT) and across LDTs (inter-LDT)",
      tr: "Samordna och hantera data, modeller och bearbetningsarbetsflöden inom en lokal digital tvilling och mellan lokala digitala tvillingar"),
    req("R4.1",
      tr: "Den lokala digitala tvillingen stödjer arbetsflöden som kopplar samman datakällor, datatransformeringar, modellexekvering, simuleringsprocesser och resultat.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "Den lokala digitala tvillingen länkar samman arbetsflödessteg, där utdata från ett steg kan användas som indata för ett annat.",
      en: "The LDT chains workflow steps, where the output of one step can be used as the input for another."),
    req("R4.3",
      tr: "Den lokala digitala tvillingen övervakar status för exekvering av arbetsflöden, inklusive slutförda, misslyckade och avbrutna processer.",
      en: "The LDT monitors workflow execution status, including completed, failed, and interrupted processes."),
    req("R4.4",
      tr: "Den lokala digitala tvillingen registrerar arbetsflödets proveniens, inklusive använda datamängder (inklusive version och tidsstämpel), exekverade modeller, valda parametrar och genererade resultat.",
      en: "The LDT records workflow provenance, including datasets used (including version, timestamped), models executed, parameters selected, and outputs generated."),
    capability("C5", "Provide multiple visualisations of data and results (e.g. 2D, 3D, dashboards) from common underlying data and models for interaction and comparison",
      tr: "Tillhandahålla flera visualiseringar av data och resultat (t.ex. 2D, 3D, instrumentpaneler) från gemensamma underliggande data och modeller för interaktion och jämförelse"),
    req("R5.1",
      tr: "Den lokala digitala tvillingen tillhandahåller metadata som förklarar vad som visualiseras, inklusive tidsstämpel, geografisk omfattning, datakälla samt scenario- och variantantaganden där det är relevant.",
      en: "The LDT provides metadata explaining what is visualised, including timestamp, spatial scope, data source, and scenario- and variant-assumptions where relevant."),
    req("R5.2",
      tr: "Den lokala digitala tvillingen stödjer olika interaktiva visualiseringstyper, såsom 2D-kartor, 3D-scener, instrumentpaneler, rapporter eller offentliga vyer.",
      en: "The LDT supports different interactive visualisation types, such as 2D maps, 3D scenes, dashboards, reports, or public-facing views."),
    capability("C6", "Ensure that data exchanged (and simulation outputs) within and between LDTs can be interpreted consistently through shared or mapped semantics and clear provenance",
      tr: "Säkerställa att data som utbyts (och simuleringsresultat) inom och mellan lokala digitala tvillingar kan tolkas enhetligt genom delad eller mappad semantik och tydlig proveniens"),
    req("R6.1",
      tr: "Den lokala digitala tvillingen bör dokumentera olösta semantiska glapp, antaganden eller mappningar som kan påverka tolkningen, återanvändningen eller jämförelsen av resultat.",
      en: "The LDT should document unresolved semantic gaps, assumptions, or mappings that may affect the interpretation, reuse, or comparison of results."),
    capability("M", "Mechanisms (under active development)",
      tr: "Mekanismer (under aktiv utveckling)"),
    req("M1",
      tr: "API-baserad åtkomst till LDT-resurser",
      en: "API-based LDT Resource Access"),
    req("M2",
      tr: "Standardiserade data- och utdataformat",
      en: "Standardised Data and Output Formats"),
    req("M3",
      tr: "Modell som tjänst (Model-as-a-Service)",
      en: "Model-as-a-Service"),
    req("M4",
      tr: "LDT-arbetsflödesorkestrering",
      en: "LDT Workflow Orchestration"),
    req("M5",
      tr: "Åtkomst till visualisering och flervyutdata",
      en: "Multi-view Output and Visualisation Access"),
  )

  #spec-link("Fullständig specifikation:", "https://mims.oascities.org/local-digital-twins")
]
