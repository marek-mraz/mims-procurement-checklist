#fit-page("MIM7 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM7",
    title:  "Vad specifikationen säger",
    leadin: "Varje krav i denna MIM, ordagrant från MIMs Plus 9.0: Specifikationen finns endast på engelska: den svenska lydelsen är en inofficiell översättning av författaren till denna skrift; det engelska originalet därunder är bindande.",
    back:   "tillbaka till checklistan",
  )

  #spec-list(mim: "MIM7",
    capability("C1", "Cities and communities can easily transfer geospatial data between internal and external (including IoT-related) IT systems",
      tr: "Städer och samhällen kan enkelt överföra geodata mellan interna och externa (inklusive IoT-relaterade) IT-system"),
    req("R1.1",
      tr: "Geodata ska tillhandahållas genom ett standardbaserat gränssnitt för webbtjänster.",
      en: "Geospatial data shall be exposed through a standards-based web service interface."),
    capability("C2", "Cities and communities can integrate 2D and 3D geospatial data coming from a variety of sources, for example geodata and building information models, and share that data within and between them in an interoperable way",
      tr: "Städer och samhällen kan integrera 2D- och 3D-geodata från en mängd olika källor, till exempel geodata och byggnadsinformationsmodeller, och dela dessa data inom och mellan sig på ett interoperabelt sätt"),
    req("R2.1",
      tr: "Geodata ska kodas med öppna standarder. Det rekommenderas att använda relevanta standarder från OGC och BuildingSMART International.",
      en: "Geospatial data shall be encoded using open standards. It is recommended to use relevant standards from OGC and BuildingSMART International."),
    capability("C3", "Cities and communities can integrate geospatial data with other data that can provide further information about the context",
      tr: "Städer och samhällen kan integrera geodata med andra data som kan ge ytterligare information om sammanhanget"),
    req("R3.1",
      tr: "Alla datamängder som används för att ge ytterligare information om den kontext som omfattas av geodata ska uppfylla kraven i MIM1 och MIM2.",
      en: "All data sets used to provide further information about the context covered by geospatial data shall comply with MIM1 and MIM2."),
    capability("C4", "Cities and communities have a consistent and persistent way of describing individual instances of all features, things or entities included in the geospatial data sources",
      tr: "Städer och samhällen har ett enhetligt och beständigt sätt att beskriva enskilda instanser av alla objekt, ting eller entiteter som ingår i geodatakällorna"),
    req("R4.1",
      tr: "Unika och beständiga identifierare ska användas för att identifiera specifika instanser av varje entitet som används i datamängder. (Se MIM1: Datalänkning.)",
      en: "Unique and persistent identifiers shall be used to identify particular instances of any entity used in data sets. (See MIM1: Interlinking Data.)"),
    capability("C5", "Coordinate Reference Systems (CRS) used in data sharing are easily transformable into a common CRS",
      tr: "Koordinatreferenssystem (CRS) som används vid datadelning kan enkelt transformeras till ett gemensamt referenssystem"),
    req("R5.1",
      tr: "Koordinatreferenssystem (CRS) ska uppfylla standarder, och information ska ges om vilken standard (t.ex. EPSG:4326, EPSG:3857) som används. Detta innefattar EPSG-nummer eller WGS-nummer, tillsammans med information om eventuella variationer baserade på nationella system såsom det lettiska LKS-92, så att data kan transformeras till ett gemensamt referenssystem. (Obs: Inom EU krävs det för geodata att metadata uppfyller INSPIRE-direktivet, inklusive de metadata som behövs för att beskriva CRS-informationen.)",
      en: "Coordinate Reference Systems (CRS) shall comply with standards, and information shall be provided regarding which standard (e.g. EPSG:4326, EPSG:3857) is being used. This includes the EPSG number or WGS number, along with information about any variation based on national systems such as the Latvian LKS-92, so that data can be transformed to a common CRS. (Note: Within the EU, for geospatial data it is required to use metadata compliant with the INSPIRE Directive, including the metadata needed to describe the CRS information.)"),
  )

  #spec-link("Fullständig specifikation:", "https://mims.oascities.org/geospatial-data")
]
