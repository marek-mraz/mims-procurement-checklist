  #spec-list(mim: "MIM6",
    capability("C1", "Data is only accessible to users that should have access to it",
      tr: "Data är endast tillgänglig för användare som ska ha åtkomst till den"),
    req("R1.1",
      tr: "Regler för att kontrollera fysisk och logisk åtkomst till information och andra associerade tillgångar SKALL fastställas och implementeras baserat på verksamhets- och informationssäkerhetskrav. (ISO 27001 5.15 Åtkomststyrning)",
      en: "Rules to control physical and logical access to information and other associated assets SHALL be established and implemented based on business and information security requirements. (ISO 27001 5.15 Access control)"),
    req("R1.2",
      tr: "Tilldelning och hantering av autentiseringsinformation SKALL styras av en ledningsprocess, inklusive rådgivning till personal om lämplig hantering av autentiseringsinformation. (ISO 27001 5.17: Autentiseringsinformation)",
      en: "Allocation and management of authentication information SHALL be controlled by a management process, including advising personnel on appropriate handling of authentication information. (ISO 27001 5.17: Authentication information)"),
    req("R1.3",
      tr: "Åtkomsträttigheter till information och andra associerade tillgångar SKALL tilldelas, granskas, ändras och tas bort i enlighet med organisationens ämnesspecifika policy för och regler för åtkomststyrning. (ISO 27001 5.18: Åtkomsträttigheter)",
      en: "Access rights to information and other associated assets SHALL be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control. (ISO 27001 5.18: Access rights)"),
    capability("C2", "Data accessed by users has not been altered",
      tr: "Data som användare har åtkomst till har inte manipulerats"),
    req("R2.1",
      tr: "Regler för effektiv användning av kryptografi, inklusive hantering av kryptografiska nycklar, SKALL definieras och implementeras. (ISO 27001 8.24 Användning av kryptografi)",
      en: "Rules for the effective use of cryptography, including cryptographic key management, SHALL be defined and implemented. (ISO 27001 8.24 Use of cryptography)"),
    capability("C3", "Data accessed by users originates from a verified source",
      tr: "Data som användare har åtkomst till härstammar från en verifierad källa"),
    req("R3.1",
      tr: "Säkra autentiseringstekniker och -procedurer ska implementeras baserat på begränsningar för informationsåtkomst och den ämnesspecifika policyn för åtkomststyrning. (ISO 27001 8.5 Säker autentisering)",
      en: "Secure authentication technologies and procedures shall be implemented based on information access restrictions and the topic-specific policy on access control. (ISO 27001 8.5 Secure authentication)"),
    capability("M1", "Mechanism candidate",
      tr: "Mekanismkandidat"),
    req("M1.1",
      tr: "Transport Layer Security (TLS)-protokollet, version 1.3",
      en: "The Transport Layer Security (TLS) Protocol, Version 1.3"),
    req("M1.2",
      tr: "Ramverket för auktorisation OAuth 2.0",
      en: "The OAuth 2.0 Authorization Framework"),
    req("M1.3",
      tr: "OpenID Connect 1.0, identitetsskikt för autentisering ovanpå OAuth 2.0",
      en: "OpenID Connect 1.0, Identity layer for authentication on OAuth 2.0"),
    req("M1.4",
      tr: "OIDC4VCI / OIDC4VP, OpenID för utfärdande och presentation av verifierbara intyg",
      en: "OIDC4VCI / OIDC4VP, OpenID for Verifiable Credential Issuance and Presentations"),
    capability("P", "Pre- and Post-requisites (based on ISO 27001 Annex A): the control this booklet refers to",
      tr: "För- och efterhandskrav (baserade på ISO 27001 bilaga A): säkerhetsåtgärden denna skrift hänvisar till"),
    req("8.15",
      tr: "Loggning. Loggar som registrerar aktiviteter, undantag, fel och andra relevanta händelser ska produceras, lagras, skyddas och analyseras.",
      en: "Logging. Logs that record activities, exceptions, faults and other relevant events shall be produced, stored, protected and analysed."),
  )

  #spec-link("Fullständig specifikation:", "https://mims.oascities.org/securing-data")
]
