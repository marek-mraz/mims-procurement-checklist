#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "Vad specifikationen säger",
    leadin: "Varje krav i denna MIM, ordagrant från MIMs Plus 9.0: Specifikationen finns endast på engelska: den svenska lydelsen är en inofficiell översättning av författaren till denna skrift; det engelska originalet därunder är bindande.",
    back:   "tillbaka till checklistan",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Alla entiteter som ingår i datakällor beskrivs med enhetliga datamodeller för att möjliggöra interoperabilitet för tillämpningar och system"),
    req("R1.1",
      tr: "Datamodeller som används för alla entiteter i varje datakälla ska göras explicita. De ska vara väl dokumenterade och ha beskrivande metadata, där termerna som används ska vara semantiskt otvetydiga. För attribut relaterade till måttenheter, tidsformat etc. ska de enheter, format etc. som används göras explicita. Datamodellerna bör katalogiseras så att de enkelt kan hittas.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "Datamodeller som används ska (där så är möjligt) baseras på allmänt erkända standardiserade datamodeller enligt listan nedan",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Där det inte är möjligt att använda befintliga standardiserade datamodeller ska ansträngningar göras för att utöka befintliga standardiserade datamodeller som ligger närmast i linje eller att definiera nya, i enlighet med bästa praxis och konventioner inom den gemenskap eller organisation som definierar datamodellerna.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "Datamodeller som används ska stödja datautbyte genom att använda de relevanta kraven i MIM-mekanismerna för Dataåtkomst och Datalänkning",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Olika datamodeller för samma entitet som används inom ett gemensamt datadelningsekosystem bör enkelt kunna transformeras till en gemensam datamodell"),
    req("R2.1",
      tr: "En gemensam datamodell för varje nyckelentitet bör utvecklas för varje dataekosystem. Den gemensamma datamodellen bör innehålla alla fält som ingår i de olika datamodellerna för den entiteten som används inom det dataekosystemet. Varje enskild datamodell som används inom det dataekosystemet skulle sedan kunna transformeras till den gemensamma datamodellen.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Alla data och deras tillhörande metadata kan delas i öppna, standardiserade datatransportformat så att data kan utbytas och tolkas enhetligt av olika verktyg och implementeringar"),
    req("R3.1",
      tr: "Varje datamodell som används ska ha minst ett definierat maskinläsbart datatransportformat (”serialisering”) som är öppet, allmänt tillgängligt och oberoende av implementation.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "Dokumentationen av datatransportformatet bör vara tillräcklig för att möjliggöra utveckling av en icke-proprietär applikation eller ett tolkningsprogram som kan återskapa alla data som lagras i ett sådant dataformat.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor [sic] that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Där flera datatransportformat stöds för samma datamodell ska de representera samma informationsinnehåll enhetligt och utan förlust av betydelse.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "Representationen bör stödja validering med hjälp av öppet publicerade scheman, grammatiker eller likvärdiga maskinläsbara restriktioner, där sådana valideringsmekanismer finns för det valda formatet.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "När det är användbart bör det vara möjligt att skapa ”applikationsprofiler” för en datamodell, så att användningsfallsspecifika attribut kan läggas till eller specificeras utan att den underliggande datamodellen ändras"),
    req("R4.1",
      tr: "Applikationsprofiler som utökar en datamodell bör inte påverka den redan befintliga modellen och dess användare",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "De specialiseringar eller utökningar som introduceras i modellens applikationsprofil bör vara väl dokumenterade, separerade från grunddatamodellen",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("Fullständig specifikation:", "https://mims.oascities.org/representing-data")
]
