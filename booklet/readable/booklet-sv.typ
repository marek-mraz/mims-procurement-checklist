    refs: "MIM3 RC1.1, RC2.1",
    num:  "3.3")

  #panels(
    why:   ("Varför det är viktigt", (
      "Lokala företag och forskare bygger vidare på kommunens data – värdet stannar i regionen.",
      "Känsliga data kan delas med exakt rätt parter, inte med alla eller ingen alls.",
      "Ett gemensamt regelverk ersätter många separata datautbytesavtal.",
    )),
    flags: ("Varningsflaggor", (
      "Leverantören gör anspråk på rättigheter till kommunens data (se klausulen ”Rättigheter till data”).",
      "Datadelning med tredje part kräver leverantörens samtycke eller extra avgifter.",
    )),
  )
]
