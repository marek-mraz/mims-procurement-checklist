#fit-page("MIM2 checklist")[
  #mim-page(
    id:       "MIM2",
    name:     "Representación de datos",
    question: "¿Hablamos el mismo idioma?",
    url:      "https://mims.oascities.org/representing-data",
    intro:    "Dos sistemas pueden exportar JSON y, aun así, no entenderse. MIM2 trata sobre el significado: utilizar modelos de datos compartidos y documentados —con unidades y formatos explícitos— para que «temperatura», «plaza de aparcamiento» o «calidad del aire» signifiquen lo mismo en todos sus sistemas.",
    list:     "Lista",
  )

  #item("Los datos utilizan modelos de datos estándar reconocidos habitualmente siempre que existan (p. ej., Smart Data Models, SAREF, ISO/IEC 5087); cualquier desviación se justifica por escrito.",
    why:  "Los datos de dos proveedores se combinan sin necesidad de un proyecto de traducción.",
    refs: "MIM2 R1.2a",
    num:  "2.1")

  #item("Todos los modelos de datos en uso están documentados explícitamente, indicando las unidades de medida y los formatos de fecha y hora.",
    why:  "«Temperatura: 23» es inútil si nadie ha especificado °C o °F.",
    refs: "MIM2 R1.1",
    num:  "2.2")

  #item("Las extensiones se entregan como perfiles o añadidos documentados sobre el modelo estándar, nunca como una bifurcación privada modificada.",
    why:  "Se mantiene la compatibilidad con la comunidad y con futuras actualizaciones.",
    refs: "MIM2 R1.2b, R4.1, R4.2",
    num:  "2.3")

  #item("Cada modelo cuenta con al menos una serialización abierta y validable mediante esquema (por ejemplo, JSON con JSON Schema).",
    why:  "Los datos entrantes pueden comprobarse automáticamente al recibirse.",
    refs: "MIM2 R3.1, R3.4",
    num:  "2.4")

  #panels(
    why:   ("Por qué es importante", (
      "Un único panel de control lee datos de múltiples proveedores sin necesidad de adaptadores.",
      "Sus datos son comprensibles para las herramientas de otras ciudades, y los de ellas para las suyas.",
      "La validación automática detecta datos incorrectos antes de que se propaguen.",
    )),
    flags: ("Señales de alerta", (
      "«Nuestro modelo de datos propietario es más completo que el estándar».",
      "Documentación disponible únicamente bajo acuerdo de confidencialidad (NDA).",
    )),
  )
]
#pagebreak()


