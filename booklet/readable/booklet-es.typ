// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM6 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM6",
    title:  "Qué dice la especificación",
    leadin: "Cada requisito de este MIM, textual de MIMs Plus 9.0: La especificación solo existe en inglés: la versión en español es una traducción no oficial del autor de esta guía; el texto original en inglés que figura debajo es el vinculante.",
    back:   "volver a la lista",
  )

  #spec-list(mim: "MIM6",
    capability("C1", "Data is only accessible to users that should have access to it",
      tr: "Los datos solo son accesibles para los usuarios que deberían tener acceso a ellos"),
    req("R1.1",
      tr: "DEBERÁN establecerse e implementarse reglas para controlar el acceso físico y lógico a la información y a otros activos asociados, sobre la base de los requisitos de negocio y de seguridad de la información. (ISO 27001 5.15 Control de acceso)",
      en: "Rules to control physical and logical access to information and other associated assets SHALL be established and implemented based on business and information security requirements. (ISO 27001 5.15 Access control)"),
    req("R1.2",
      tr: "La asignación y gestión de la información de autenticación DEBERÁ controlarse mediante un proceso de gestión, incluido el asesoramiento al personal sobre el tratamiento adecuado de la información de autenticación. (ISO 27001 5.17: Información de autenticación)",
      en: "Allocation and management of authentication information SHALL be controlled by a management process, including advising personnel on appropriate handling of authentication information. (ISO 27001 5.17: Authentication information)"),
    req("R1.3",
      tr: "Los derechos de acceso a la información y a otros activos asociados DEBERÁN concederse, revisarse, modificarse y revocarse de conformidad con la política temática de la organización sobre control de acceso y sus reglas pertinentes. (ISO 27001 5.18: Derechos de acceso)",
      en: "Access rights to information and other associated assets SHALL be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control. (ISO 27001 5.18: Access rights)"),
    capability("C2", "Data accessed by users has not been altered",
      tr: "Los datos a los que acceden los usuarios no han sido alterados"),
    req("R2.1",
      tr: "DEBERÁN definirse e implementarse reglas para el uso eficaz de la criptografía, incluida la gestión de claves criptográficas. (ISO 27001 8.24 Uso de la criptografía)",
      en: "Rules for the effective use of cryptography, including cryptographic key management, SHALL be defined and implemented. (ISO 27001 8.24 Use of cryptography)"),
    capability("C3", "Data accessed by users originates from a verified source",
      tr: "Los datos a los que acceden los usuarios proceden de una fuente verificada"),
    req("R3.1",
      tr: "Se implementarán tecnologías y procedimientos de autenticación segura basados en las restricciones de acceso a la información y en la política temática sobre control de acceso. (ISO 27001 8.5 Autenticación segura)",
      en: "Secure authentication technologies and procedures shall be implemented based on information access restrictions and the topic-specific policy on access control. (ISO 27001 8.5 Secure authentication)"),
    capability("M1", "Mechanism candidate",
      tr: "Mecanismo candidato"),
    req("M1.1",
      tr: "El protocolo Transport Layer Security (TLS), versión 1.3",
      en: "The Transport Layer Security (TLS) Protocol, Version 1.3"),
    req("M1.2",
      tr: "El marco de autorización OAuth 2.0",
      en: "The OAuth 2.0 Authorization Framework"),
    req("M1.3",
      tr: "OpenID Connect 1.0, capa de identidad para autenticación sobre OAuth 2.0",
      en: "OpenID Connect 1.0, Identity layer for authentication on OAuth 2.0"),
    req("M1.4",
      tr: "OIDC4VCI / OIDC4VP, OpenID para la emisión y presentación de credenciales verificables",
      en: "OIDC4VCI / OIDC4VP, OpenID for Verifiable Credential Issuance and Presentations"),
    capability("P", "Pre- and Post-requisites (based on ISO 27001 Annex A): the control this booklet refers to",
      tr: "Requisitos previos y posteriores (basados en el anexo A de ISO 27001): el control al que se refiere esta guía"),
    req("8.15",
      tr: "Registro. Se generarán, almacenarán, protegerán y analizarán registros que recopilen actividades, excepciones, fallos y otros sucesos pertinentes.",
      en: "Logging. Logs that record activities, exceptions, faults and other relevant events shall be produced, stored, protected and analysed."),
  )

  #spec-link("Especificación completa:", "https://mims.oascities.org/securing-data")
]
