// ════════════════════════════════════════════════════════════════════════════
//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Qué dice la especificación",
    leadin: "Cada requisito de este MIM, textual de MIMs Plus 9.0: La especificación solo existe en inglés: la versión en español es una traducción no oficial del autor de esta guía; el texto original en inglés que figura debajo es el vinculante.",
    back:   "volver a la lista",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Pueden definirse normas de gobernanza para el ecosistema de intercambio de datos"),
    req("RC1.1",
      tr: "El orquestador de un ecosistema de datos debería poder definir un modelo de gobernanza (p. ej., un manual de normas) que detalle las reglas de adhesión, las funciones, responsabilidades y obligaciones de los participantes del ecosistema, y los principios generales que rigen el intercambio de datos entre ellos.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Los miembros que participen en un ecosistema de datos deberían conocer su modelo de gobernanza y cualquier cambio que se realice en él.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "El modelo de gobernanza debería ser fácilmente comprensible para todos los participantes del ecosistema.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Pueden definirse términos y condiciones para el intercambio de datos"),
    req("RC2.1",
      tr: "Los proveedores de datos son libres de definir los términos y condiciones bajo los cuales desean que se intercambien sus datos. (Nota: Antes de compartir activos de datos, los proveedores de datos deberían asegurarse de que cuentan con la autorización adecuada de los propietarios de los datos).",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Los términos y condiciones para un intercambio de datos deberían describirse de manera clara e inequívoca para que sean fácilmente comprensibles para los usuarios de datos.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Los términos y condiciones para un intercambio de datos deberían expresarse a través de licencias de datos o acuerdos de intercambio de datos basados en plantillas o normas bien definidas.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Los términos y condiciones deberían estar alineados con el modelo general de gobernanza del ecosistema de datos y no deben entrar en conflicto con él. (Nota: Un proveedor de datos puede decidir no participar en un ecosistema de datos si el modelo de gobernanza subyacente es demasiado restrictivo o demasiado permisivo).",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Puede validarse el cumplimiento de los términos y condiciones de intercambio de datos"),
    req("RC3.1",
      tr: "El orquestador de un ecosistema de datos debe poder verificar el cumplimiento del modelo de gobernanza subyacente por parte de sus participantes.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Los proveedores de datos deberían poder verificar que el uso de los datos por parte de un usuario de datos cumple con los términos y condiciones previamente acordados.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Los usuarios de datos deberían poder verificar que el suministro de datos por parte del proveedor de datos sigue los términos y condiciones previamente acordados.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Los activos de datos disponibles pueden descubrirse"),
    req("RC4.1",
      tr: "Los usuarios de datos deberían poder descubrir qué datos están disponibles en un ecosistema de intercambio de datos sin conocimiento previo de ellos.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Los activos de datos deberían describirse adecuadamente con metadatos para que los usuarios de datos puedan tomar decisiones fiables sobre el uso posterior previsto.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Los metadatos utilizados para describir activos de datos deberían basarse en formatos de descripción bien definidos y fáciles de entender, que sean legibles tanto por personas como por máquinas.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Los participantes del ecosistema pueden descubrirse"),
    req("RC5.1",
      tr: "Los participantes del ecosistema (p. ej., usuarios y proveedores de datos) deberían poder descubrirse mutuamente dentro de un ecosistema de intercambio de datos.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Debería haber suficientes metadatos disponibles sobre cada participante del ecosistema para determinar su fiabilidad a efectos del intercambio de datos.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Los proveedores de datos deberían poder identificar de forma fiable a los usuarios de datos que desean acceder a sus activos de datos y verificar sus metadatos antes de conceder el acceso.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Los usuarios de datos deberían poder identificar a los proveedores de datos que comparten datos en un ecosistema de datos antes de acceder a ellos o utilizarlos.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Los participantes del ecosistema también pueden optar por permanecer en el anonimato si el modelo de gobernanza del ecosistema de intercambio de datos lo permite. En este caso, RC5.1 a RC5.4 pueden ignorarse.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "El intercambio de datos puede acordarse"),
    req("RC6.1",
      tr: "Los usuarios y proveedores de datos deberían poder acordar un intercambio de datos y los términos y condiciones asociados al mismo (p. ej., aceptación de términos, firma formal de un acuerdo o negociación).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Los usuarios y proveedores de datos deberían poder rescindir un intercambio de datos previamente acordado de conformidad con los términos y condiciones asociados al mismo.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Siempre que sea posible, se pueden proporcionar medios electrónicos para el acuerdo y la rescisión de un intercambio de datos.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Pueden solicitarse nuevos datos que actualmente no estén disponibles"),
    req("RC7.1",
      tr: "Los usuarios de datos deberían poder expresar su interés en activos de datos que actualmente no están disponibles en el ecosistema de intercambio de datos.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Los proveedores de datos deberían poder obtener las solicitudes realizadas por los usuarios de datos para nuevos activos de datos.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Especificación completa:", "https://mims.oascities.org/exchanging-data")
]
#pagebreak()


// ════════════════════════════════════════════════════════════════════════════
//  MIM6 · LEFT PAGE · CHECKLIST
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM6 checklist")[
  #mim-page(
    id:       "MIM6",
    name:     "Seguridad de los datos",
    question: "¿Están seguros nuestros datos?",
    url:      "https://mims.oascities.org/securing-data",
    intro:    "Las ciudades inteligentes son un objetivo habitual. MIM6 mantiene un alcance deliberadamente acotado y práctico: cifrar los datos en tránsito, utilizar accesos estándar en lugar de propietarios, y controlar y registrar quién accede a qué. Nada de esto es extraordinario; todo debe figurar en el contrato.",
    list:     "Lista",
  )

  #item("Toda transferencia de datos está cifrada (TLS 1.3 o mejores prácticas vigentes).",
    why:  "Higiene digital básica; la directiva NIS2 también lo exige si le resulta de aplicación.",
    refs: "MIM6 R2.1, M1.1",
    num:  "6.1")

  #item("El inicio de sesión y el acceso automatizado utilizan estándares abiertos (OAuth 2.0 / OpenID Connect) y pueden integrarse en el proveedor de identidad existente del municipio.",
    why:  "Una cuenta por empleado, no una por cada producto de proveedor; el personal que cause baja perderá el acceso a todos los sistemas de forma simultánea.",
    refs: "MIM6 R3.1, M1.2, M1.3",
    num:  "6.2")

  #item("Los derechos de acceso se basan en roles, son auditables y revocables; los accesos y las acciones administrativas quedan registrados.",
    why:  "Permite realizar auditorías y responder a incidentes. El registro corresponde al control 8.15 del Anexo A de ISO/IEC 27001:2022, que MIM6 incluye entre sus requisitos previos.",
    refs: "MIM6 R1.1, R1.3, 8.15",
    num:  "6.3")

  #item("El licitador demuestra la conformidad con la norma ISO/IEC 27001:2022 (o equivalente) para el servicio que presta.",
    why:  "La seguridad es un proceso continuado, no una mera casilla que marcar en la entrega. La especificación menciona los controles de ISO/IEC 27001, no un certificado.",
    refs: "MIM6 C1–C3 (ISO/IEC 27001)",
    num:  "6.4",
    label: "Corresponde a los criterios de selección, no a las prescripciones técnicas")

  #panels(
    why:   ("Por qué es importante", (
      "Una brecha de seguridad en un sistema no compromete todos los demás.",
      "Si NIS2 le resulta de aplicación, cumplirla a ella y a las normativas nacionales de ciberseguridad resulta sensiblemente más sencillo.",
      "Tras una incidencia, los registros muestran qué ha ocurrido y quién ha intervenido.",
    )),
    flags: ("Señales de alerta", (
      "Solo inicio de sesión propietario.",
      "«Registros disponibles previa solicitud».",
      "Cuentas de administrador compartidas.",
    )),
  )
]
