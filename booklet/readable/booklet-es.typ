#fit-page("MIM8 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM8",
    title:  "Qué dice la especificación",
    leadin: "Cada requisito de este MIM, textual de MIMs Plus 9.0: La especificación solo existe en inglés: la versión en español es una traducción no oficial del autor de esta guía; el texto original en inglés que figura debajo es el vinculante.",
    back:   "volver a la lista",
  )

  #spec-list(mim: "MIM8",
    capability("C1", "Provide access to datasets used within the LDT, including static, real-time, and simulation data and calculation models",
      tr: "Proporcionar acceso a los conjuntos de datos utilizados en el LDT, incluidos datos estáticos, en tiempo real y de simulación, así como modelos de cálculo"),
    req("R1.1",
      tr: "El LDT proporcionará acceso a los resultados de la simulación y a las entradas de los modelos de cálculo cuando sean necesarios como parte de los flujos de trabajo del LDT.",
      en: "The LDT shall provide access to simulation outputs and calculation-model inputs where these are needed as part of LDT workflows."),
    req("R1.2",
      tr: "El LDT debería distinguir claramente entre datos fuente brutos, datos transformados listos para flujos de trabajo, entradas de modelos y resultados de modelos.",
      en: "The LDT should distinguish clearly between raw source data, transformed workflow-ready data, model inputs, and model outputs."),
    capability("C2", "Exchange data with external systems and other LDTs using interoperable interfaces",
      tr: "Intercambiar datos con sistemas externos y otros LDT mediante interfaces interoperables"),
    req("C2",
      tr: "Esta capacidad se apoya en MIM3 (Intercambio de datos) para el intercambio de datos.",
      en: "This capability relies on MIM3 (Exchanging Data) for data exchange."),
    capability("C3", "Reuse deterministic or AI models across different domains, communities, use cases, and/or LDTs",
      tr: "Reutilizar modelos deterministas o de IA en diferentes dominios, comunidades, casos de uso o LDT"),
    req("R3.1",
      tr: "El modelo debería proporcionar metadatos estándar del modelo, incluida una descripción de sus métodos y parámetros, y parámetros de datos (ya sea por valor o por referencia). Para ello, deberían utilizarse normas comunes de metadatos.",
      en: "The model should provide standard model metadata, including a description of its methods and parameters, and data-parameters (either by value or by reference). To this end common metadata standards should be used."),
    req("R3.2",
      tr: "El modelo expondrá una interfaz documentada o podrá invocarse a través de ella, preferiblemente utilizando una API estandarizada conocida. El conjunto de datos que constituye el resultado del modelo se describirá (a nivel de datos).",
      en: "The model shall expose or be callable through a documented interface, preferably using a known standardised API. The dataset that forms the outcome of the model shall be described (at data-level)."),
    req("R3.3",
      tr: "Debería salvaguardarse el uso ético, fiable y fidedigno de métodos innovadores (LLM, IA agéntica, etc.). El sesgo debería minimizarse cuando proceda. Deberían describirse los métodos utilizados para garantizarlo.",
      en: "Trustworthy, reliable, and ethical use of innovative methods (LLMs, agentic AI, etc.) should be safeguarded. Bias should minimised [sic] where applicable. The methods used to guarantee this, should be described."),
    req("R3.4",
      tr: "El modelo debe poder acceder a los datos en nombre del usuario final o de la organización. Véase MIM3",
      en: "The model must be able to access data on behalf of the end-user or organisation. See MIM3"),
    req("R3.5",
      tr: "Para que los datos se utilicen en modelos de IA, debería garantizarse la procedencia y la confianza. En algunos casos, debe figurar una fuente autorizada, como un organismo público.",
      en: "For data to be used in AI models, provenance and trust should be guaranteed. In some cases, an authoratitive sourc [sic], such as a government agency must be listed."),
    capability("C4", "Coordinate and manage data, models, and processing workflows within an LDT (intra-LDT) and across LDTs (inter-LDT)",
      tr: "Coordinar y gestionar datos, modelos y flujos de trabajo de procesamiento dentro de un LDT (intra-LDT) y entre LDT (inter-LDT)"),
    req("R4.1",
      tr: "El LDT admite flujos de trabajo que conectan fuentes de datos, transformaciones de datos, ejecución de modelos, procesos de simulación y resultados.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "El LDT encadena los pasos del flujo de trabajo, donde el resultado de un paso puede utilizarse como entrada para otro.",
      en: "The LDT chains workflow steps, where the output of one step can be used as the input for another."),
    req("R4.3",
      tr: "El LDT supervisa el estado de ejecución de los flujos de trabajo, incluidos los procesos completados, fallidos e interrumpidos.",
      en: "The LDT monitors workflow execution status, including completed, failed, and interrupted processes."),
    req("R4.4",
      tr: "El LDT registra la trazabilidad del flujo de trabajo, incluidos los conjuntos de datos utilizados (incluida la versión, con marca de tiempo), los modelos ejecutados, los parámetros seleccionados y los resultados generados.",
      en: "The LDT records workflow provenance, including datasets used (including version, timestamped), models executed, parameters selected, and outputs generated."),
    capability("C5", "Provide multiple visualisations of data and results (e.g. 2D, 3D, dashboards) from common underlying data and models for interaction and comparison",
      tr: "Proporcionar múltiples visualizaciones de datos y resultados (p. ej., 2D, 3D, cuadros de mando) a partir de datos y modelos subyacentes comunes para la interacción y comparación"),
    req("R5.1",
      tr: "El LDT proporciona metadatos que explican qué se visualiza, incluida la marca de tiempo, el alcance espacial, la fuente de datos y los supuestos de escenarios y variantes cuando sea pertinente.",
      en: "The LDT provides metadata explaining what is visualised, including timestamp, spatial scope, data source, and scenario- and variant-assumptions where relevant."),
    req("R5.2",
      tr: "El LDT admite diferentes tipos de visualización interactiva, como mapas 2D, escenas 3D, cuadros de mando, informes o vistas destinadas al público.",
      en: "The LDT supports different interactive visualisation types, such as 2D maps, 3D scenes, dashboards, reports, or public-facing views."),
    capability("C6", "Ensure that data exchanged (and simulation outputs) within and between LDTs can be interpreted consistently through shared or mapped semantics and clear provenance",
      tr: "Garantizar que los datos intercambiados (y los resultados de simulación) dentro de los LDT y entre ellos puedan interpretarse de forma coherente mediante semántica compartida o mapeada y una procedencia clara"),
    req("R6.1",
      tr: "El LDT debería documentar las lagunas semánticas no resueltas, las hipótesis o las correspondencias que puedan afectar a la interpretación, la reutilización o la comparación de los resultados.",
      en: "The LDT should document unresolved semantic gaps, assumptions, or mappings that may affect the interpretation, reuse, or comparison of results."),
    capability("M", "Mechanisms (under active development)",
      tr: "Mecanismos (en fase activa de desarrollo)"),
    req("M1",
      tr: "Acceso a recursos del LDT basado en API",
      en: "API-based LDT Resource Access"),
    req("M2",
      tr: "Formatos normalizados de datos y de resultados",
      en: "Standardised Data and Output Formats"),
    req("M3",
      tr: "Modelo como servicio (Model-as-a-Service)",
      en: "Model-as-a-Service"),
    req("M4",
      tr: "Orquestación de flujos de trabajo del LDT",
      en: "LDT Workflow Orchestration"),
    req("M5",
      tr: "Acceso a la visualización y salidas en múltiples vistas",
      en: "Multi-view Output and Visualisation Access"),
  )

  #spec-link("Especificación completa:", "https://mims.oascities.org/local-digital-twins")
]
