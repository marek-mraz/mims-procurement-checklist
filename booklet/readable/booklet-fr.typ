//  MIM2 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "Ce que dit la spécification",
    leadin: "Chaque exigence de ce MIM, textuellement issue de MIMs Plus 9.0 : La spécification n'existe qu'en anglais : la version française est une traduction non officielle établie par l'auteur de ce livret ; seul le texte original anglais ci-dessous fait foi.",
    back:   "retour à la liste de contrôle",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Toutes les entités incluses dans les sources de données sont décrites à l'aide de modèles de données cohérents afin de permettre l'interopérabilité pour les applications et les systèmes"),
    req("R1.1",
      tr: "Les modèles de données utilisés pour toutes les entités de toute source de données doivent être rendus explicites. Ils doivent être bien documentés et comporter des métadonnées descriptives, où les termes utilisés doivent être sémantiquement sans ambiguïté. Pour les attributs liés aux unités de mesure, aux formats d'heure, etc., les unités, formats, etc. utilisés doivent être rendus explicites. Les modèles de données devraient être catalogués afin d'être faciles à trouver.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "Les modèles de données utilisés doivent être fondés (dans la mesure du possible) sur des modèles de données standardisés communément reconnus tels qu'énumérés ci-dessous.",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Lorsqu'il n'est pas possible d'utiliser des modèles de données standardisés existants, des efforts doivent être faits pour étendre les modèles de données standardisés existants les plus proches ou pour en définir de nouveaux, conformément aux meilleures pratiques et conventions de la communauté ou de l'organisation définissant les modèles de données.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "Les modèles de données utilisés doivent prendre en charge l'échange de données en utilisant les exigences pertinentes des MIM relatives à l'accès aux données et à l'interconnexion des données.",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Différents modèles de données pour la même entité qui sont utilisés au sein d'un écosystème commun de partage de données devraient pouvoir être facilement transformés en un modèle de données commun"),
    req("R2.1",
      tr: "Un modèle de données commun pour chaque entité clé devrait être développé pour tout écosystème de données. Ce modèle de données commun devrait contenir tous les champs inclus dans les différents modèles de données pour cette entité qui sont utilisés au sein de cet écosystème de données. Chaque modèle de données différent utilisé au sein de cet écosystème de données pourrait ensuite être transformé dans le modèle de données commun.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Toutes les données et leurs métadonnées associées peuvent être partagées dans des formats de transport de données ouverts et standardisés afin que les données puissent être échangées et interprétées de manière cohérente par différents outils et implémentations"),
    req("R3.1",
      tr: "Chaque modèle de données utilisé doit avoir au moins un format de transport de données lisible par machine défini (« sérialisation ») qui soit ouvert, publiquement accessible et indépendant de la mise en œuvre.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "La documentation du format de transport de données devrait être suffisante pour permettre la création d'une application ou d'un interpréteur non propriétaire capable de reconstruire toutes les données stockées dans un tel format de données.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor [sic] that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Lorsque plusieurs formats de transport de données sont pris en charge pour le même modèle de données, ils doivent représenter le même contenu informatif de manière cohérente et sans perte de sens.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "La représentation devrait prendre en charge la validation à l'aide de schémas, de grammaires ou de contraintes lisibles par machine équivalentes publiés ouvertement, lorsque de tels mécanismes de validation existent pour le format choisi.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "Lorsque cela est utile, il devrait être possible de créer des « profils d'application » pour un modèle de données, de sorte que des attributs spécifiques à un cas d'usage puissent être ajoutés ou spécifiés sans modifier le modèle de données sous-jacent"),
    req("R4.1",
      tr: "Les profils d'application qui étendent un modèle de données ne devraient pas avoir d'impact sur le modèle déjà existant et ses utilisateurs.",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "Les spécialisations ou extensions introduites dans le profil d'application du modèle devraient être bien documentées, séparément du modèle de données de base.",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("Spécification complète :", "https://mims.oascities.org/representing-data")
]
#pagebreak()


