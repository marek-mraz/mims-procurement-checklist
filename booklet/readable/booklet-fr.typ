#fit-page("MIM2 checklist")[
  #mim-page(
    id:       "MIM2",
    name:     "Représenter les données",
    question: "Parlons-nous un langage commun ?",
    url:      "https://mims.oascities.org/representing-data",
    intro:    "Deux systèmes peuvent tous deux exporter du JSON sans pour autant se comprendre. Le MIM2 concerne la sémantique : utiliser des modèles de données partagés et documentés — avec des unités et des formats explicites — pour que « température », « place de stationnement » ou « qualité de l'air » signifient la même chose dans chaque système acquis.",
    list:     "Liste de contrôle",
  )

  #item("Les données utilisent des modèles de données standards communément reconnus dès lors qu'ils existent (par ex. Smart Data Models, SAREF, ISO/IEC 5087) ; tout écart est justifié par écrit.",
    why:  "Les données de deux fournisseurs fusionnent sans projet de conversion.",
    refs: "MIM2 R1.2a",
    num:  "2.1")

  #item("Tous les modèles de données utilisés sont explicitement documentés, avec indication des unités de mesure et des formats de date/heure.",
    why:  "« Température : 23 » est inutile si personne n'a précisé °C ou °F.",
    refs: "MIM2 R1.1",
    num:  "2.2")

  #item("Les extensions sont livrées sous forme de profils ou ajouts documentés complétant le modèle standard — jamais sous forme d'un fork privé modifié.",
    why:  "Vous restez compatible avec la communauté et les mises à jour futures.",
    refs: "MIM2 R1.2b, R4.1, R4.2",
    num:  "2.3")

  #item("Chaque modèle dispose d'au moins une sérialisation ouverte, validable par schéma (par ex. JSON avec JSON Schema).",
    why:  "Les données entrantes peuvent être contrôlées automatiquement à la réception.",
    refs: "MIM2 R3.1, R3.4",
    num:  "2.4")

  #panels(
    why:   ("Pourquoi c'est important", (
      "Un seul tableau de bord lit les données de nombreux fournisseurs sans adaptateurs.",
      "Vos données sont comprises par les outils d'autres villes — et les leurs par les vôtres.",
      "La validation automatique détecte les données erronées avant qu'elles ne se propagent.",
    )),
    flags: ("Signaux d'alerte", (
      "« Notre modèle de données propriétaire est plus riche que le standard. »",
      "Documentation disponible uniquement sous accord de confidentialité.",
    )),
  )
]
