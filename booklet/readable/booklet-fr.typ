//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Ce que dit la spécification",
    leadin: "Chaque exigence de ce MIM, textuellement issue de MIMs Plus 9.0 : La spécification n'existe qu'en anglais : la version française est une traduction non officielle établie par l'auteur de ce livret ; seul le texte original anglais ci-dessous fait foi.",
    back:   "retour à la liste de contrôle",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Les règles de gouvernance pour l'écosystème de partage de données peuvent être définies"),
    req("RC1.1",
      tr: "L'orchestrateur d'un écosystème de données devrait pouvoir définir un modèle de gouvernance (par exemple un recueil de règles) décrivant les règles d'adhésion, les rôles, responsabilités et obligations des participants à l'écosystème, ainsi que les principes généraux régissant l'échange de données entre eux.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Les membres qui participent à un écosystème de données devraient être informés de son modèle de gouvernance et de toute modification qui y est apportée.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Le modèle de gouvernance devrait être facilement compréhensible par tous les participants à l'écosystème.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Les conditions générales pour le partage de données peuvent être définies"),
    req("RC2.1",
      tr: "Les fournisseurs de données sont libres de définir les conditions générales selon lesquelles ils souhaitent que leurs données soient échangées. (Remarque : avant de partager des actifs de données, les fournisseurs de données devraient s'assurer qu'ils disposent de l'autorisation adéquate des propriétaires des données.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Les conditions générales d'un échange de données devraient être décrites clairement et sans ambiguïté afin d'être facilement compréhensibles pour les utilisateurs de données.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Les conditions générales d'un échange de données devraient être exprimées par le biais de licences de données ou d'accords de partage de données fondés sur des modèles ou des normes bien définis.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Les conditions générales devraient être conformes au modèle de gouvernance global de l'écosystème de données et ne doivent pas entrer en conflit avec celui-ci. (Remarque : un fournisseur de données peut décider de ne pas participer à un écosystème de données si le modèle de gouvernance sous-jacent est trop restrictif ou trop permissif.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "La conformité aux conditions générales de partage de données peut être validée"),
    req("RC3.1",
      tr: "L'orchestrateur d'un écosystème de données doit pouvoir vérifier la conformité de ses participants avec le modèle de gouvernance sous-jacent.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Les fournisseurs de données devraient pouvoir vérifier que l'utilisation des données par un utilisateur de données est conforme aux conditions générales préalablement convenues.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Les utilisateurs de données devraient pouvoir vérifier que la fourniture de données par le fournisseur de données suit les conditions générales préalablement convenues.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Les actifs de données disponibles peuvent être découverts"),
    req("RC4.1",
      tr: "Les utilisateurs de données devraient pouvoir découvrir quelles données sont disponibles dans un écosystème de partage de données sans en avoir une connaissance préalable.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Les actifs de données devraient être décrits de manière adéquate avec des métadonnées afin que les utilisateurs de données puissent prendre des décisions fiables quant à leur utilisation ultérieure prévue.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Les métadonnées utilisées pour décrire les actifs de données devraient être fondées sur des formats de description bien définis et faciles à comprendre, à la fois lisibles par l'homme et par la machine.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Les participants à l'écosystème peuvent être découverts"),
    req("RC5.1",
      tr: "Les participants à l'écosystème (par exemple les utilisateurs et les fournisseurs de données) devraient pouvoir se découvrir mutuellement au sein d'un écosystème de partage de données.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Des métadonnées suffisantes sur chaque participant à l'écosystème devraient être disponibles pour établir leur niveau de confiance pertinent pour l'échange de données.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Les fournisseurs de données devraient pouvoir identifier de manière fiable les utilisateurs de données qui souhaitent accéder à leurs actifs de données et vérifier leurs métadonnées avant d'accorder l'accès.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Les utilisateurs de données devraient pouvoir identifier les fournisseurs de données qui partagent des données dans un écosystème de données avant d'accéder à ces données ou de les utiliser.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Les participants à l'écosystème peuvent également choisir de rester anonymes si le modèle de gouvernance de l'écosystème de partage de données le permet. Dans ce cas, RC5.1 à RC5.4 peuvent être ignorés.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Un échange de données peut être convenu"),
    req("RC6.1",
      tr: "Les utilisateurs et les fournisseurs de données devraient pouvoir s'accorder sur un échange de données et les conditions générales qui y sont associées (par exemple, acceptation des conditions, signature formelle d'un accord ou négociation).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Les utilisateurs et les fournisseurs de données devraient pouvoir mettre fin à un échange de données préalablement convenu conformément aux conditions générales qui y sont associées.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Dans la mesure du possible, des moyens électroniques pour l'accord et la résiliation d'un échange de données peuvent être fournis.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "De nouvelles données actuellement non disponibles peuvent être demandées"),
    req("RC7.1",
      tr: "Les utilisateurs de données devraient pouvoir exprimer leur intérêt pour des actifs de données actuellement indisponibles dans l'écosystème de partage de données.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Les fournisseurs de données devraient pouvoir obtenir les demandes formulées par les utilisateurs de données pour de nouveaux actifs de données.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Spécification complète :", "https://mims.oascities.org/exchanging-data")
]
#pagebreak()


