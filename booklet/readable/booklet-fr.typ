      tr: "Il existe un moyen de récupérer des informations sur une entité en consultant l'identifiant au sein d'un système.",
      en: "There exists a way to retrieve information about an entity by looking up the identifier within a system"),
    req("R1.3",
      tr: "Si un identifiant unique pointe vers la même entité au sein de plusieurs systèmes, il est possible d'en déduire le moyen de consulter les informations la concernant dans chacun de ces systèmes.",
      en: "if a unique identifier points to the same entity within multiple systems, it is possible to derive the way to look up information about it in each of these systems"),
    req("R1.4",
      tr: "Si plusieurs identifiants uniques pointent vers la même entité, il est possible de les mettre en correspondance.",
      en: "if a multiple [sic] unique identifiers point to the same entity, it is possible to map them"),
    req("R1.5",
      tr: "Il est possible de créer des identifiants qui sont persistants dans le temps.",
      en: "It is possible to create identifiers that are persistent over time"),
    capability("C2", "Entities can be typed",
      tr: "Les entités peuvent être typées"),
    req("R2.1",
      tr: "Il existe un moyen de récupérer la sémantique d'une entité, uniquement à l'aide de son identifiant unique.",
      en: "There is a way to retreive [sic] the semantics of an entity, only using its unique identifier"),
    req("R2.2",
      tr: "Cette sémantique est décrite dans un format lisible par machine.",
      en: "These semantics are described in a machine-readable format"),
    capability("C3", "Entities can be (de)referenced",
      tr: "Les entités peuvent être (dé)référencées"),
    req("R3.1",
      tr: "Il existe un moyen de déréférencer une relation définie sur une entité.",
      en: "There exists a way to dereference a relation defined on an entity"),
    req("R3.2",
      tr: "Il existe un moyen d'appliquer une sémantique supplémentaire à une ontologie existante.",
      en: "There exists a way to apply additional semantics to an existing ontology"),
    capability("M1", "Mechanism 1, section 3.1: Entity Identification with Globally Unique IRIs",
      tr: "Mécanisme 1, section 3.1 : Identification des entités avec des IRI globalement uniques"),
    req("§3.1",
      tr: "L'IRI est traité comme l'identifiant canonique dans tous les systèmes en aval ; les implémentations NE DOIVENT PAS générer d'IRI intégrant des détails d'implémentation volatils tels que des identifiants de ligne de base de données ou des noms d'hôte de serveur.",
      en: "The IRI is treated as the canonical identifier in all downstream systems; implementations MUST NOT generate IRIs that embed volatile implementation details such as database row IDs or server hostnames."),
  )

  #spec-link("Spécification complète :", "https://mims.oascities.org/interlinking-data")
]
