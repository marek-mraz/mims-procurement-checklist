#fit-page("MIM7 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM7",
    title:  "Ce que dit la spécification",
    leadin: "Chaque exigence de ce MIM, textuellement issue de MIMs Plus 9.0 : La spécification n'existe qu'en anglais : la version française est une traduction non officielle établie par l'auteur de ce livret ; seul le texte original anglais ci-dessous fait foi.",
    back:   "retour à la liste de contrôle",
  )

  #spec-list(mim: "MIM7",
    capability("C1", "Cities and communities can easily transfer geospatial data between internal and external (including IoT-related) IT systems",
      tr: "Les villes et communautés peuvent facilement transférer des données géospatiales entre les systèmes informatiques internes et externes (y compris liés à l'IoT)"),
    req("R1.1",
      tr: "Les données géospatiales doivent être exposées via une interface de service Web fondée sur des normes.",
      en: "Geospatial data shall be exposed through a standards-based web service interface."),
    capability("C2", "Cities and communities can integrate 2D and 3D geospatial data coming from a variety of sources, for example geodata and building information models, and share that data within and between them in an interoperable way",
      tr: "Les villes et communautés peuvent intégrer des données géospatiales 2D et 3D provenant de diverses sources, par exemple des données géographiques et des modèles d'information du bâtiment (BIM), et partager ces données en leur sein et entre elles de manière interopérable"),
    req("R2.1",
      tr: "Les données géospatiales doivent être encodées à l'aide de normes ouvertes. Il est recommandé d'utiliser les normes pertinentes de l'OGC et de BuildingSMART International.",
      en: "Geospatial data shall be encoded using open standards. It is recommended to use relevant standards from OGC and BuildingSMART International."),
    capability("C3", "Cities and communities can integrate geospatial data with other data that can provide further information about the context",
      tr: "Les villes et communautés peuvent intégrer des données géospatiales avec d'autres données pouvant fournir des informations supplémentaires sur le contexte"),
    req("R3.1",
      tr: "Tous les jeux de données utilisés pour fournir des informations supplémentaires sur le contexte couvert par les données géospatiales doivent être conformes à MIM1 et MIM2.",
      en: "All data sets used to provide further information about the context covered by geospatial data shall comply with MIM1 and MIM2."),
    capability("C4", "Cities and communities have a consistent and persistent way of describing individual instances of all features, things or entities included in the geospatial data sources",
      tr: "Les villes et communautés disposent d'un moyen cohérent et persistant de décrire les instances individuelles de toutes les entités, objets ou fonctionnalités inclus dans les sources de données géospatiales"),
    req("R4.1",
      tr: "Des identifiants uniques et persistants doivent être utilisés pour identifier des instances particulières de toute entité utilisée dans les jeux de données. (Voir MIM1 : Interconnexion des données.)",
      en: "Unique and persistent identifiers shall be used to identify particular instances of any entity used in data sets. (See MIM1: Interlinking Data.)"),
    capability("C5", "Coordinate Reference Systems (CRS) used in data sharing are easily transformable into a common CRS",
      tr: "Les systèmes de coordonnées de référence (CRS) utilisés dans le partage de données sont facilement transformables en un CRS commun"),
    req("R5.1",
      tr: "Les systèmes de coordonnées de référence (CRS) doivent être conformes aux normes, et des informations doivent être fournies quant à la norme utilisée (par exemple EPSG:4326, EPSG:3857). Cela inclut le numéro EPSG ou le numéro WGS, ainsi que des informations sur toute variation fondée sur des systèmes nationaux tels que le LKS-92 letton, afin que les données puissent être transformées vers un CRS commun. (Remarque : au sein de l'UE, pour les données géospatiales, il est obligatoire d'utiliser des métadonnées conformes à la directive INSPIRE, y compris les métadonnées nécessaires pour décrire les informations relatives au CRS.)",
      en: "Coordinate Reference Systems (CRS) shall comply with standards, and information shall be provided regarding which standard (e.g. EPSG:4326, EPSG:3857) is being used. This includes the EPSG number or WGS number, along with information about any variation based on national systems such as the Latvian LKS-92, so that data can be transformed to a common CRS. (Note: Within the EU, for geospatial data it is required to use metadata compliant with the INSPIRE Directive, including the metadata needed to describe the CRS information.)"),
  )

  #spec-link("Spécification complète :", "https://mims.oascities.org/geospatial-data")
]
