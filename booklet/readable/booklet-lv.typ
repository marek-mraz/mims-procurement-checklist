    more-link("smartdatamodels.org", "Standarta datu modeļu atvērtā bibliotēka (FIWARE, TM Forum, IUDX, OASC)."),
    more-link("oascities.org/academy", "CITYxCITY Academy — pilsētu darbinieku kursi, ko veidojušas pilsētas."),
  )
]


