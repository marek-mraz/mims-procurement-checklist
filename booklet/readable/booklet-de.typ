    req("R1.1",
      tr: "Jede Entität innerhalb des Systems besitzt einen eindeutigen Bezeichner.",
      en: "Every entity within the system has a unique identifier"),
    req("R1.2",
      tr: "Es existiert ein Verfahren, um Informationen über eine Entität durch Nachschlagen des Bezeichners innerhalb eines Systems abzurufen.",
      en: "There exists a way to retrieve information about an entity by looking up the identifier within a system"),
    req("R1.3",
      tr: "Verweist ein eindeutiger Bezeichner innerhalb mehrerer Systeme auf dieselbe Entität, ist es möglich, das Verfahren zum Nachschlagen von Informationen über sie in jedem dieser Systeme abzuleiten.",
      en: "if a unique identifier points to the same entity within multiple systems, it is possible to derive the way to look up information about it in each of these systems"),
    req("R1.4",
      tr: "Verweisen mehrere eindeutige Bezeichner auf dieselbe Entität, ist es möglich, diese einander zuzuordnen.",
      en: "if a multiple [sic] unique identifiers point to the same entity, it is possible to map them"),
    req("R1.5",
      tr: "Es ist möglich, Bezeichner zu erstellen, die über die Zeit hinweg beständig sind.",
      en: "It is possible to create identifiers that are persistent over time"),
    capability("C2", "Entities can be typed",
      tr: "Entitäten können typisiert werden"),
    req("R2.1",
      tr: "Es existiert ein Verfahren, um die Semantik einer Entität ausschließlich über ihren eindeutigen Bezeichner abzurufen.",
      en: "There is a way to retreive [sic] the semantics of an entity, only using its unique identifier"),
    req("R2.2",
      tr: "Diese Semantik ist in einem maschinenlesbaren Format beschrieben.",
      en: "These semantics are described in a machine-readable format"),
    capability("C3", "Entities can be (de)referenced",
      tr: "Entitäten können (de-)referenziert werden"),
    req("R3.1",
      tr: "Es existiert ein Verfahren, um eine für eine Entität definierte Beziehung zu dereferenzieren.",
      en: "There exists a way to dereference a relation defined on an entity"),
    req("R3.2",
      tr: "Es existiert ein Verfahren, um eine bestehende Ontologie um zusätzliche Semantik zu ergänzen.",
      en: "There exists a way to apply additional semantics to an existing ontology"),
    capability("M1", "Mechanism 1, section 3.1: Entity Identification with Globally Unique IRIs",
      tr: "Mechanismus 1, Abschnitt 3.1: Entitätenidentifikation mit global eindeutigen IRIs"),
    req("§3.1",
      tr: "Der IRI wird in allen nachgelagerten Systemen als kanonischer Bezeichner behandelt; Implementierungen DÜRFEN KEINE IRIs erzeugen, die flüchtige Implementierungsdetails wie Zeilen-IDs einer Datenbank oder Server-Hostnamen enthalten.",
      en: "The IRI is treated as the canonical identifier in all downstream systems; implementations MUST NOT generate IRIs that embed volatile implementation details such as database row IDs or server hostnames."),
  )

  #spec-link("Vollständige Spezifikation:", "https://mims.oascities.org/interlinking-data")
]
#pagebreak()


