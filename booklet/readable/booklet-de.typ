//  MIM2 · LEFT PAGE · CHECKLIST
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM2 checklist")[
  #mim-page(
    id:       "MIM2",
    name:     "Datenrepräsentation",
    question: "Sprechen wir eine gemeinsame Sprache?",
    url:      "https://mims.oascities.org/representing-data",
    intro:    "Zwei Systeme können beide JSON exportieren und sich dennoch nicht verstehen. Bei MIM2 geht es um die Bedeutung: gemeinsame, dokumentierte Datenmodelle – mit eindeutigen Einheiten und Formaten –, damit „Temperatur“, „Parkplatz“ oder „Luftqualität“ in jedem Ihrer Systeme exakt dasselbe bedeutet.",
    list:     "Checkliste",
  )

  #item("Daten nutzen allgemein anerkannte Standarddatenmodelle, wo immer vorhanden (z. B. Smart Data Models, SAREF, ISO/IEC 5087); Abweichungen sind schriftlich zu begründen.",
    why:  "Daten zweier Anbieter lassen sich ohne Übersetzungsprojekt zusammenführen.",
    refs: "MIM2 R1.2a",
    num:  "2.1")

  #item("Alle verwendeten Datenmodelle sind ausdrücklich dokumentiert, unter Angabe von Maßeinheiten und Datums-/Uhrzeitformaten.",
    why:  "„Temperatur: 23“ ist unbrauchbar, wenn niemand °C oder °F festgelegt hat.",
    refs: "MIM2 R1.1",
    num:  "2.2")

  #item("Erweiterungen werden als dokumentierte Profile/Ergänzungen auf Basis des Standardmodells geliefert – niemals als modifizierter privater Fork.",
    why:  "Sie bleiben kompatibel mit der Community und künftigen Aktualisierungen.",
    refs: "MIM2 R1.2b, R4.1, R4.2",
    num:  "2.3")

  #item("Jedes Modell verfügt über mindestens eine offene, schemavalidierbare Serialisierung (z. B. JSON mit JSON-Schema).",
    why:  "Eingehende Daten können direkt beim Empfang automatisch geprüft werden.",
    refs: "MIM2 R3.1, R3.4",
    num:  "2.4")

  #panels(
    why:   ("Warum das wichtig ist", (
      "Ein Dashboard liest Daten vieler Anbieter ohne Adapter aus.",
      "Ihre Daten werden von Werkzeugen anderer Kommunen verstanden – und deren Daten von Ihren.",
      "Automatische Validierung stoppt fehlerhafte Daten, bevor sie sich ausbreiten.",
    )),
    flags: ("Warnsignale", (
      "„Unser proprietäres Datenmodell ist umfangreicher als der Standard.“",
      "Dokumentation nur unter NDA verfügbar.",
    )),
  )
]
#pagebreak()


