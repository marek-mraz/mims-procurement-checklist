#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Co říká specifikace",
    leadin: "Všechny požadavky tohoto MIM ze specifikace MIMs Plus 9.0. Specifikace existuje jen v angličtině: české znění je neoficiální překlad autora brožury, závazný je anglický originál pod ním.",
    back:   "zpět na seznam",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Lze definovat pravidla správy ekosystému sdílení dat"),
    req("RC1.1",
      tr: "Orchestrátor datového ekosystému má mít možnost definovat model správy (např. soubor pravidel), který určuje pravidla členství, role, odpovědnosti a povinnosti účastníků ekosystému a celkové principy výměny dat mezi nimi.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Členové, kteří se účastní datového ekosystému, mají znát jeho model správy a všechny jeho změny.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Model správy má být snadno srozumitelný pro všechny účastníky ekosystému.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Lze definovat podmínky sdílení dat"),
    req("RC2.1",
      tr: "Poskytovatelé dat mohou svobodně určit podmínky, za kterých chtějí svá data vyměňovat. (Poznámka: Před sdílením datových aktiv si mají poskytovatelé ověřit, že mají odpovídající svolení od vlastníků dat.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Podmínky výměny dat mají být popsány jasně a jednoznačně, aby byly pro uživatele dat snadno srozumitelné.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Podmínky výměny dat mají být vyjádřeny prostřednictvím datových licencí nebo smluv o sdílení dat založených na dobře definovaných šablonách nebo standardech.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Podmínky mají být v souladu s celkovým modelem správy datového ekosystému a nesmí mu odporovat. (Poznámka: Poskytovatel dat se může rozhodnout, že se datového ekosystému nezúčastní, pokud je jeho model správy příliš restriktivní nebo příliš benevolentní.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Lze ověřit dodržování podmínek sdílení dat"),
    req("RC3.1",
      tr: "Orchestrátor datového ekosystému musí být schopen ověřit, zda účastníci dodržují příslušný model správy.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Poskytovatelé dat mají mít možnost ověřit, že uživatel dat je používá v souladu s předem dohodnutými podmínkami.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Uživatelé dat mají mít možnost ověřit, že poskytovatel dodává data v souladu s předem dohodnutými podmínkami.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Dostupná datová aktiva lze vyhledat"),
    req("RC4.1",
      tr: "Uživatelé dat mají mít možnost zjistit, jaká data jsou v ekosystému sdílení dostupná, i bez předchozí znalosti o nich.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Datová aktiva mají být přiměřeně popsána metadaty, aby se uživatelé dat mohli spolehlivě rozhodnout o jejich dalším zamýšleném použití.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
