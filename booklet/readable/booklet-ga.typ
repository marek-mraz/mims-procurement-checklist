//  MIM2 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "Cad a deir an tsonraíocht",
    leadin: "Gach ceanglas de chuid an MIM seo, focal ar fhocal ó MIMs Plus 9.0: Níl an tsonraíocht ar fáil ach i mBéarla: is aistriúchán neamhoifigiúil é an téacs Gaeilge le húdar an leabhráin seo; tá an bunleagan Béarla faoi ina cheangal dlí.",
    back:   "ar ais go dtí an seicliosta",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Déantar cur síos ar gach eintiteas a áirítear i bhfoinsí sonraí ag baint úsáide as samhlacha comhsheasmhacha sonraí chun idir-inoibritheacht a chumasú d'fheidhmchláir agus do chórais"),
    req("R1.1",
      tr: "déanfar samhlacha sonraí a úsáidtear do gach eintiteas in aon fhoinse sonraí a chur in iúl go sainráite. Beidh siad doiciméadaithe go maith agus beidh meiteashonraí tuairisciúla acu, áit a mbeidh na téarmaí a úsáidtear neamh-dhébhríoch ó thaobh séimeantaice de. Maidir le tréithe a bhaineann le haonaid tomhais, formáidí ama srl., déanfar na haonaid, na formáidí srl., a úsáidtear a chur in iúl go sainráite. Ba chóir na samhlacha sonraí a chatalógú ionas gur féidir iad a fháil go héasca.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "beidh samhlacha sonraí a úsáidtear bunaithe (nuair is féidir) ar shamhlacha sonraí caighdeánaithe a aithnítear go coitianta mar a liostaítear thíos",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Nuair nach féidir samhlacha sonraí caighdeánaithe atá ann cheana a úsáid, déanfar iarrachtaí chun samhlacha sonraí caighdeánaithe atá ann cheana agus is dlúithe atá ailínithe a leathnú nó cinn nua a shainiú, de réir an dea-chleachtais agus choinbhinsiúin an phobail nó na heagraíochta a shainíonn na samhlacha sonraí.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "tacóidh samhlacha sonraí a úsáidtear le malartú sonraí trí úsáid a bhaint as ceanglais ábhartha na MIMs maidir le Rochtain ar shonraí agus Idirnascadh sonraí",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Ba chóir go mbeadh samhlacha sonraí éagsúla don eintiteas céanna a úsáidtear laistigh d'éiceachóras coiteann comhroinnte sonraí in-chlaochlaithe go héasca go samhail choiteann sonraí"),
    req("R2.1",
      tr: "Ba chóir samhail choiteann sonraí do gach príomh-eintiteas a fhorbairt d'aon éiceachóras sonraí. Ba chóir go mbeadh na réimsí uile a áirítear laistigh de na samhlacha sonraí éagsúla don eintiteas sin a úsáidtear laistigh den éiceachóras sonraí sin sa tsamhail sonraí choiteann sin. D'fhéadfaí gach samhail sonraí éagsúil a úsáidtear laistigh den éiceachóras sonraí sin a chlaochlú ansin go dtí an tsamhail sonraí choiteann.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Is féidir aon sonraí agus a meiteashonraí gaolmhara a roinnt i bhformáidí oscailte, caighdeánaithe, iompair sonraí ionas gur féidir sonraí a mhalartú agus a léirmhíniú go comhsheasmhach ag uirlisí agus feidhmithe éagsúla"),
    req("R3.1",
      tr: "beidh formáid iompair sonraí mheaisín-inléite shainithe amháin ar a laghad (“srathú”) ag gach samhail sonraí a úsáidtear atá oscailte, ar fáil go poiblí agus neamhspleách ar chur i bhfeidhm.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "Ba chóir go mbeadh doiciméadú na formáide iompair sonraí leordhóthanach chun go bhféadfaí feidhmchlár nó ateangaire neamhdhílseánach a chruthú atá in ann na sonraí go léir atá stóráilte i bhformáid sonraí den sórt sin a athchruthú.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Nuair a thacaítear le formáidí iompair sonraí iolracha don tsamhail sonraí chéanna, léireoidh siad an t-ábhar faisnéise céanna go comhsheasmhach agus gan cailleadh brí.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "Ba chóir go dtacódh an léiriú le bailíochtú ag baint úsáide as scéimeanna, gramadaí, nó srianta coibhéiseacha meaisín-inléite a fhoilsítear go hoscailte, nuair atá meicníochtaí bailíochtaithe den sórt sin ann don fhormáid roghnaithe.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "Nuair is úsáideach, ba chóir go mbeadh sé indéanta \"Próifílí Feidhmchláir\" a chruthú do shamhail sonraí, ionas gur féidir tréithe a bhaineann go sonrach le cás úsáide a chur leis nó a shonrú gan an bhunshamhail sonraí a athrú"),
    req("R4.1",
      tr: "Níor cheart go ndéanfadh Próifílí Feidhmchláir a leathnaíonn samhail sonraí difear don tsamhail atá ann cheana féin agus dá húsáideoirí",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "Ba chóir na speisialtachtaí nó na síntí a thugtar isteach i bPróifíl Feidhmchláir na samhla a dhoiciméadú go maith, ar leithligh ón mbunshamhail sonraí",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("Sonraíocht iomlán:", "https://mims.oascities.org/representing-data")
]
#pagebreak()


