#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Cad a deir an tsonraíocht",
    leadin: "Gach ceanglas de chuid an MIM seo, focal ar fhocal ó MIMs Plus 9.0: Níl an tsonraíocht ar fáil ach i mBéarla: is aistriúchán neamhoifigiúil é an téacs Gaeilge le húdar an leabhráin seo; tá an bunleagan Béarla faoi ina cheangal dlí.",
    back:   "ar ais go dtí an seicliosta",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Is féidir rialacha rialachais don éiceachóras comhroinnte sonraí a shainiú"),
    req("RC1.1",
      tr: "Ba chóir go mbeadh stiúrthóir éiceachórais sonraí in ann samhail rialachais a shainiú (m.sh. leabhar rialacha) a leagann amach rialacha ballraíochta, róil, freagrachtaí agus oibleagáidí rannpháirtithe an éiceachórais, agus na prionsabail fhoriomlána a rialaíonn malartú sonraí eatarthu.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Ba chóir do bhaill a ghlacann páirt in éiceachóras sonraí a bheith ar an eolas faoina shamhail rialachais agus faoi aon athruithe a dhéantar uirthi.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Ba chóir go mbeadh an tsamhail rialachais intuigthe go héasca ag gach rannpháirtí san éiceachóras.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Is féidir téarmaí agus coinníollacha maidir le comhroinnt sonraí a shainiú"),
    req("RC2.1",
      tr: "Bíonn soláthraithe sonraí saor chun téarmaí agus coinníollacha a shainiú faoinar mian leo a gcuid sonraí a mhalartú. (Nóta: Sula roinneann siad sócmhainní sonraí, ba chóir do sholáthraithe sonraí a chinntiú go bhfuil cead leordhóthanach acu ó úinéirí sonraí.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Ba chóir cur síos soiléir agus neamh-dhébhríoch a dhéanamh ar théarmaí agus ar choinníollacha do mhalartú sonraí ionas go mbeidh siad intuigthe go héasca d'úsáideoirí sonraí.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Ba chóir téarmaí agus coinníollacha do mhalartú sonraí a chur in iúl trí cheadúnais sonraí nó trí chomhaontuithe comhroinnte sonraí bunaithe ar theimpléid nó ar chaighdeáin atá sainithe go maith.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Ba chóir do théarmaí agus do choinníollacha a bheith i gcomhréir le samhail rialachais fhoriomlán an éiceachórais sonraí agus ní cead dóibh teacht salach uirthi. (Nóta: Is féidir le soláthraí sonraí cinneadh a dhéanamh gan páirt a ghlacadh in éiceachóras sonraí má tá an tsamhail rialachais bhunúsach ró-shriantach nó ró-cheadúil.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Is féidir comhlíonadh théarmaí agus choinníollacha comhroinnte sonraí a bhailíochtú"),
    req("RC3.1",
      tr: "Ní mór do stiúrthóir éiceachórais sonraí a bheith in ann comhlíonadh a rannpháirtithe leis an tsamhail rialachais bhunúsach a fháil amach.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Ba chóir do sholáthraithe sonraí a bheith in ann a fháil amach go gcomhlíonann úsáid sonraí ag úsáideoir sonraí téarmaí agus coinníollacha a comhaontaíodh roimhe sin.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Ba chóir d'úsáideoirí sonraí a bheith in ann a fháil amach go leanann soláthar sonraí an tsoláthraí sonraí téarmaí agus coinníollacha a comhaontaíodh roimhe sin.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Is féidir sócmhainní sonraí atá ar fáil a aimsiú"),
    req("RC4.1",
      tr: "Ba chóir d'úsáideoirí sonraí a bheith in ann a fháil amach cad iad na sonraí atá ar fáil in éiceachóras comhroinnte sonraí gan eolas a bheith acu orthu roimh ré.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Ba chóir cur síos leordhóthanach a dhéanamh ar shócmhainní sonraí le meiteashonraí ionas gur féidir le húsáideoirí sonraí cinntí iontaofa a dhéanamh faoin úsáid bheartaithe bhreise a bhainfear astu.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Ba chóir go mbeadh meiteashonraí a úsáidtear chun cur síos a dhéanamh ar shócmhainní sonraí bunaithe ar fhormáidí tuairiscithe dea-shainithe atá éasca le tuiscint agus atá inléite ag daoine agus ag meaisíní araon.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Is féidir rannpháirtithe san éiceachóras a aimsiú"),
    req("RC5.1",
      tr: "Ba chóir do rannpháirtithe an éiceachórais (m.sh. úsáideoirí agus soláthraithe sonraí) a bheith in ann a chéile a fháil amach laistigh d'éiceachóras comhroinnte sonraí.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Ba chóir go mbeadh dóthain meiteashonraí faoi gach rannpháirtí san éiceachóras ar fáil chun a n-iontaoibh atá ábhartha do mhalartú sonraí a fháil amach.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Ba chóir do sholáthraithe sonraí a bheith in ann úsáideoirí sonraí ar mian leo teacht ar a gcuid sócmhainní sonraí a shainaithint go hiontaofa agus a meiteashonraí a fhíorú sula dtugtar rochtain.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Ba chóir d'úsáideoirí sonraí a bheith in ann soláthraithe sonraí a roinneann sonraí in éiceachóras sonraí a shainaithint sula ndéanann siad rochtain ar na sonraí sin nó sula n-úsáideann siad iad.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Féadfaidh rannpháirtithe an éiceachórais a roghnú freisin fanacht gan ainm má cheadaíonn samhail rialachais an éiceachórais comhroinnte sonraí é sin. Sa chás seo, is féidir neamhaird a dhéanamh de RC5.1 go RC5.4.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Is féidir comhaontú a dhéanamh ar mhalartú sonraí"),
    req("RC6.1",
      tr: "Ba chóir d'úsáideoirí agus do sholáthraithe sonraí a bheith in ann aontú le malartú sonraí agus leis na téarmaí agus na coinníollacha a bhaineann leis (m.sh. glacadh le téarmaí, síniú dlíthiúil comhaontaithe, nó caibidlíocht).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Ba chóir d'úsáideoirí agus do sholáthraithe sonraí a bheith in ann deireadh a chur le malartú sonraí a comhaontaíodh roimhe sin i gcomhréir leis na téarmaí agus na coinníollacha a bhaineann leis.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Nuair is féidir, féadfar modhanna leictreonacha a sholáthar maidir le comhaontú agus foirceannadh malartaithe sonraí.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Is féidir sonraí nua nach bhfuil ar fáil faoi láthair a iarraidh"),
    req("RC7.1",
      tr: "Ba chóir d'úsáideoirí sonraí a bheith in ann a spéis i sócmhainní sonraí nach bhfuil ar fáil faoi láthair san éiceachóras comhroinnte sonraí a chur in iúl.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Ba chóir do sholáthraithe sonraí a bheith in ann iarratais a dhéanann úsáideoirí sonraí ar shócmhainní sonraí nua a fháil.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Sonraíocht iomlán:", "https://mims.oascities.org/exchanging-data")
]
