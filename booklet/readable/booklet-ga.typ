  #spec-list(mim: "MIM6",
    capability("C1", "Data is only accessible to users that should have access to it",
      tr: "Níl sonraí inrochtana ach d'úsáideoirí ar chóir go mbeadh rochtain acu orthu"),
    req("R1.1",
      tr: "NÍ MÓR rialacha chun rochtain fhisiciúil agus loighciúil ar fhaisnéis agus ar shócmhainní gaolmhara eile a rialú a bhunú agus a chur i bhfeidhm bunaithe ar cheanglais ghnó agus slándála faisnéise. (ISO 27001 5.15 Rialú rochtana)",
      en: "Rules to control physical and logical access to information and other associated assets SHALL be established and implemented based on business and information security requirements. (ISO 27001 5.15 Access control)"),
    req("R1.2",
      tr: "NÍ MÓR leithdháileadh agus bainistiú faisnéise fíordheimhnithe a rialú trí phróiseas bainistíochta, lena n-áirítear comhairle a thabhairt do phearsanra maidir le láimhseáil chuí faisnéise fíordheimhnithe. (ISO 27001 5.17: Faisnéis fhíordheimhnithe)",
      en: "Allocation and management of authentication information SHALL be controlled by a management process, including advising personnel on appropriate handling of authentication information. (ISO 27001 5.17: Authentication information)"),
    req("R1.3",
      tr: "NÍ MÓR cearta rochtana ar fhaisnéis agus ar shócmhainní gaolmhara eile a sholáthar, a athbhreithniú, a mhodhnú agus a bhaint i gcomhréir le beartas agus rialacha sonracha an eagraigh maidir le rialú rochtana. (ISO 27001 5.18: Cearta rochtana)",
      en: "Access rights to information and other associated assets SHALL be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control. (ISO 27001 5.18: Access rights)"),
    capability("C2", "Data accessed by users has not been altered",
      tr: "Níor athraíodh sonraí a ndearna úsáideoirí rochtain orthu"),
    req("R2.1",
      tr: "NÍ MÓR rialacha d'úsáid éifeachtach na cripteagrafaíochta, lena n-áirítear bainistíocht eochracha cripteagrafacha, a shainiú agus a chur i bhfeidhm. (ISO 27001 8.24 Úsáid cripteagrafaíochta)",
      en: "Rules for the effective use of cryptography, including cryptographic key management, SHALL be defined and implemented. (ISO 27001 8.24 Use of cryptography)"),
    capability("C3", "Data accessed by users originates from a verified source",
      tr: "Tagann sonraí a ndéanann úsáideoirí rochtain orthu ó fhoinse fhíoraithe"),
    req("R3.1",
      tr: "cuirfear teicneolaíochtaí agus nósanna imeachta slána fíordheimhnithe i bhfeidhm bunaithe ar shrianta rochtana faisnéise agus ar an mbeartas a bhaineann go sonrach leis an ábhar maidir le rialú rochtana. (ISO 27001 8.5 Fíordheimhniú slán)",
      en: "Secure authentication technologies and procedures shall be implemented based on information access restrictions and the topic-specific policy on access control. (ISO 27001 8.5 Secure authentication)"),
    capability("M1", "Mechanism candidate",
      tr: "Meicníocht is iarrthóir"),
    req("M1.1",
      tr: "Prótacal Slándála an Chiseáil Iompair (TLS), Leagan 1.3",
      en: "The Transport Layer Security (TLS) Protocol, Version 1.3"),
    req("M1.2",
      tr: "Creat Údaraithe OAuth 2.0",
      en: "The OAuth 2.0 Authorization Framework"),
    req("M1.3",
      tr: "OpenID Connect 1.0, Ciseal aitheantais d'fhíordheimhniú ar OAuth 2.0",
      en: "OpenID Connect 1.0, Identity layer for authentication on OAuth 2.0"),
    req("M1.4",
      tr: "OIDC4VCI / OIDC4VP, OpenID le haghaidh Eisiúint agus Léiriú Dintiúir Infhíoraithe",
      en: "OIDC4VCI / OIDC4VP, OpenID for Verifiable Credential Issuance and Presentations"),
    capability("P", "Pre- and Post-requisites (based on ISO 27001 Annex A): the control this booklet refers to",
      tr: "Réamh- agus Iar-riachtanais (bunaithe ar ISO 27001 Iarscríbhinn A): an rialú a dtagraíonn an leabhrán seo dó"),
    req("8.15",
      tr: "Logáil. Déanfar logaí a thaifeadann gníomhaíochtaí, eisceachtaí, lochtanna agus imeachtaí ábhartha eile a tháirgeadh, a stóráil, a chosaint agus a anailísiú.",
      en: "Logging. Logs that record activities, exceptions, faults and other relevant events shall be produced, stored, protected and analysed."),
  )

  #spec-link("Sonraíocht iomlán:", "https://mims.oascities.org/securing-data")
]
