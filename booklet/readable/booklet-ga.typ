// ════════════════════════════════════════════════════════════════════════════
//  MIM8 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM8 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM8",
    title:  "Cad a deir an tsonraíocht",
    leadin: "Gach ceanglas de chuid an MIM seo, focal ar fhocal ó MIMs Plus 9.0: Níl an tsonraíocht ar fáil ach i mBéarla: is aistriúchán neamhoifigiúil é an téacs Gaeilge le húdar an leabhráin seo; tá an bunleagan Béarla faoi ina cheangal dlí.",
    back:   "ar ais go dtí an seicliosta",
  )

  #spec-list(mim: "MIM8",
    capability("C1", "Provide access to datasets used within the LDT, including static, real-time, and simulation data and calculation models",
      tr: "Rochtain a sholáthar ar thacair shonraí a úsáidtear laistigh den LDT, lena n-áirítear sonraí statacha, fíor-ama agus ionsamhlúcháin agus samhlacha ríofa"),
    req("R1.1",
      tr: "Soláthróidh an LDT rochtain ar aschuir ionsamhlúcháin agus ar ionchuir mhúnla ríofa nuair a theastaíonn siad mar chuid de shreafaí oibre LDT.",
      en: "The LDT shall provide access to simulation outputs and calculation-model inputs where these are needed as part of LDT workflows."),
    req("R1.2",
      tr: "Ba chóir don LDT idirdhealú soiléir a dhéanamh idir bunshonraí amha, sonraí atá réidh le haghaidh sreafa oibre claochlaithe, ionchuir mhúnla, agus aschuir mhúnla.",
      en: "The LDT should distinguish clearly between raw source data, transformed workflow-ready data, model inputs, and model outputs."),
    capability("C2", "Exchange data with external systems and other LDTs using interoperable interfaces",
      tr: "Sonraí a mhalartú le córais sheachtracha agus le LDTanna eile ag baint úsáide as comhéadain idir-inoibritheacha"),
    req("C2",
      tr: "Braitheann an cumas seo ar MIM3 (Malartú Sonraí) le haghaidh malartú sonraí.",
      en: "This capability relies on MIM3 (Exchanging Data) for data exchange."),
    capability("C3", "Reuse deterministic or AI models across different domains, communities, use cases, and/or LDTs",
      tr: "Samhlacha cinnteacha nó IS a athúsáid thar réimsí, pobail, cásanna úsáide, agus/nó LDTanna éagsúla"),
    req("R3.1",
      tr: "Ba chóir don mhúnla meiteashonraí caighdeánacha múnla a sholáthar, lena n-áirítear cur síos ar a mhodhanna agus a pharaiméadair, agus sonraí-pharaiméadair (trí luach nó trí thagairt). Chuige sin ba chóir úsáid a bhaint as caighdeáin choiteanna meiteashonraí.",
      en: "The model should provide standard model metadata, including a description of its methods and parameters, and data-parameters (either by value or by reference). To this end common metadata standards should be used."),
    req("R3.2",
      tr: "Nochtfaidh an múnla comhéadan doiciméadaithe nó beidh sé inghlaoite trí chomhéadan doiciméadaithe, de rogha ag baint úsáide as API caighdeánaithe aitheanta. Déanfar cur síos ar an tacar sonraí arb é toradh an mhúnla é (ar leibhéal na sonraí).",
      en: "The model shall expose or be callable through a documented interface, preferably using a known standardised API. The dataset that forms the outcome of the model shall be described (at data-level)."),
    req("R3.3",
      tr: "Ba chóir úsáid iontaofa, fhónta agus eiticiúil modhanna nuálacha (LLManna, IS ghníomhaireach, etc.) a chosaint. Ba chóir claonadh a íoslaghdú nuair is infheidhme. Ba chóir cur síos a dhéanamh ar na modhanna a úsáidtear chun é seo a ráthú.",
      en: "Trustworthy, reliable, and ethical use of innovative methods (LLMs, agentic AI, etc.) should be safeguarded. Bias should minimised [sic] where applicable. The methods used to guarantee this, should be described."),
    req("R3.4",
      tr: "Ní mór don mhúnla a bheith in ann rochtain a fháil ar shonraí thar ceann an úsáideora deiridh nó na heagraíochta. Féach MIM3",
      en: "The model must be able to access data on behalf of the end-user or organisation. See MIM3"),
    req("R3.5",
      tr: "Chun go n-úsáidfear sonraí i múnlaí IS, ba chóir bunús agus iontaoibh a ráthú. I gcásanna áirithe, ní mór foinse údarásach, amhail gníomhaireacht rialtais, a liostú.",
      en: "For data to be used in AI models, provenance and trust should be guaranteed. In some cases, an authoratitive sourc [sic], such as a government agency must be listed."),
    capability("C4", "Coordinate and manage data, models, and processing workflows within an LDT (intra-LDT) and across LDTs (inter-LDT)",
      tr: "Sonraí, samhlacha, agus sreafaí oibre próiseála a chomhordú agus a bhainistiú laistigh de LDT (laistigh de LDT) agus trasna LDTanna (idir-LDT)"),
    req("R4.1",
      tr: "Tacaíonn an LDT le sreafaí oibre a nascann foinsí sonraí, claochluithe sonraí, forghníomhú samhlacha, próisis ionsamhlúcháin, agus aschuir.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "Slabhraíonn an LDT céimeanna sreafa oibre, áit ar féidir aschur céime amháin a úsáid mar ionchur do chéim eile.",
      en: "The LDT chains workflow steps, where the output of one step can be used as the input for another."),
    req("R4.3",
      tr: "Déanann an LDT monatóireacht ar stádas forghníomhaithe an tsreafa oibre, lena n-áirítear próisis chríochnaithe, theipthe agus bhriste.",
      en: "The LDT monitors workflow execution status, including completed, failed, and interrupted processes."),
    req("R4.4",
      tr: "Taifeadann an LDT bunús an tsreafa oibre, lena n-áirítear tacair shonraí a úsáideadh (lena n-áirítear leagan, stampáilte le ham), samhlacha a forghníomhaíodh, paraiméadair a roghnaíodh, agus aschuir a gineadh.",
      en: "The LDT records workflow provenance, including datasets used (including version, timestamped), models executed, parameters selected, and outputs generated."),
    capability("C5", "Provide multiple visualisations of data and results (e.g. 2D, 3D, dashboards) from common underlying data and models for interaction and comparison",
      tr: "Léirshamhluithe iolracha ar shonraí agus ar thorthaí (m.sh. 2D, 3D, deaisanna) a sholáthar ó shonraí agus ó shamhlacha bunúsacha coiteanna le haghaidh idirghníomhaíochta agus comparáide"),
    req("R5.1",
      tr: "Soláthraíonn an LDT meiteashonraí a mhíníonn cad atá á léirshamhlú, lena n-áirítear stampa ama, raon feidhme spásúil, foinse sonraí, agus toimhdí cásanna agus leaganacha nuair is ábhartha.",
      en: "The LDT provides metadata explaining what is visualised, including timestamp, spatial scope, data source, and scenario- and variant-assumptions where relevant."),
    req("R5.2",
      tr: "Tacaíonn an LDT le cineálacha éagsúla léirshamhlaithe idirghníomhacha, amhail léarscáileanna 2D, radhairc 3D, deaisanna, tuarascálacha, nó radhairc phoiblí.",
      en: "The LDT supports different interactive visualisation types, such as 2D maps, 3D scenes, dashboards, reports, or public-facing views."),
    capability("C6", "Ensure that data exchanged (and simulation outputs) within and between LDTs can be interpreted consistently through shared or mapped semantics and clear provenance",
      tr: "A chinntiú gur féidir sonraí a mhalartaítear (agus aschuir ionsamhlúcháin) laistigh de LDTanna agus eatarthu a léirmhíniú go comhsheasmhach trí shéimeantaic chomhroinnte nó mhapáilte agus trí bhunús soiléir"),
    req("R6.1",
      tr: "Ba chóir don LDT bearnaí séimeantacha neamhréitithe, toimhdí, nó mapálacha a dhoiciméadú a d'fhéadfadh dul i bhfeidhm ar léirmhíniú, athúsáid nó comparáid torthaí.",
      en: "The LDT should document unresolved semantic gaps, assumptions, or mappings that may affect the interpretation, reuse, or comparison of results."),
    capability("M", "Mechanisms (under active development)",
      tr: "Meicníochtaí (faoi fhorbairt ghníomhach)"),
    req("M1",
      tr: "Rochtain ar Acmhainní LDT Bunaithe ar API",
      en: "API-based LDT Resource Access"),
    req("M2",
      tr: "Formáidí Sonraí agus Aschuir Chaighdeánaithe",
      en: "Standardised Data and Output Formats"),
    req("M3",
      tr: "Múnla-mar-Sheirbhís",
      en: "Model-as-a-Service"),
    req("M4",
      tr: "Stiúradh Sreafa Oibre LDT",
      en: "LDT Workflow Orchestration"),
    req("M5",
      tr: "Rochtain ar Aschur Il-radhairc agus ar Léirshamhlú",
      en: "Multi-view Output and Visualisation Access"),
  )

  #spec-link("Sonraíocht iomlán:", "https://mims.oascities.org/local-digital-twins")
]
