#band("Compliance table", id: "table")

#intro(size: 9.4pt, gap: 5pt, "One row per item. The contracting authority ticks what the contract requires and attaches the table to the procurement documents as a mandatory annex to the tender. For each required item the bidder enters M (meets), E (meets by an equivalent) or N (does not meet), briefly how, and where the evidence is: documentation address, test access, page of the tender. A declaration without evidence is not enough. The evaluation committee verifies each item when evaluating tenders and again at acceptance (✓ confirmed, ✗ not confirmed, — not checked).")

#intro(size: 9.4pt, gap: 8pt, "The completed table is part of the tender and becomes an annex to the contract. It verifies that the requirements for the subject of the contract are met (met or not met); it is not an award criterion. To score compliance, say so among the award criteria published in advance in the procurement documents (Directive 2014/24/EU, Article 67).")

#score-sheet(
  headers: ("#", "Requirement (short)", "Spec ref.", "Required?", "M / E / N", "Evidence: how and where", "Verified"),
  roles: ("authority", "bidder", "bidder", "committee"),
  section("MIM0 · Can we get our data out?",
    ("0.1", "Machine-readable data via standard web API", "MIM0 R1.1, R1.2"),
    ("0.2", "Open API description (OpenAPI) at stable address", "MIM0 R1.3"),
    ("0.3", "Filtering by time, place, attributes", "MIM0 R2.1, R2.2"),
    ("0.4", "Subscription to changes where needed", "MIM0 R3.1"),
    ("0.5", "Standard HTTP errors, caching, rate limits", "MIM0 C2"),
  ),
  section("MIM1 · Does every thing have a name that lasts?",
    ("1.1", "Unique persistent identifier per entity", "MIM1 R1.1, R1.5"),
    ("1.2", "Identifier lookup returns data + type", "MIM1 R1.2, R2.1, R2.2"),
    ("1.3", "Cross-system identifier mapping", "MIM1 R1.3, R1.4"),
    ("1.4", "No vendor internals in identifiers", "MIM1 M1 §3.1"),
  ),
  section("MIM2 · Do we speak a common language?",
    ("2.1", "Standard data models wherever possible", "MIM2 R1.2a"),
    ("2.2", "Models documented, units explicit", "MIM2 R1.1"),
    ("2.3", "Extensions as profiles, never forks", "MIM2 R1.2b, R4.1, R4.2"),
    ("2.4", "Open, schema-validatable serialisation", "MIM2 R3.1, R3.4"),
  ),
  section("MIM3 · Can we share on clear terms?",
    ("3.1", "Datasets catalogued with standard metadata", "MIM3 RC4.1–RC4.3"),
    ("3.2", "Template licences and agreements", "MIM3 RC2.2, RC2.3"),
    ("3.3", "City controls access terms itself", "MIM3 RC1.1, RC2.1"),
  ),
  section("MIM6 · Is our data safe in transit and in use?",
    ("6.1", "Encrypted transfer (TLS 1.3)", "MIM6 R2.1, M1.1"),
    ("6.2", "Standard login (OAuth 2.0 / OIDC)", "MIM6 R3.1, M1.2, M1.3"),
    ("6.3", "Role-based access + audit logs", "MIM6 R1.1, R1.3, 8.15"),
    ("6.4", "ISO/IEC 27001:2022 alignment shown", "MIM6 C1–C3 (ISO/IEC 27001)"),
  ),
  section("MIM7 · Does it work on a map?",
    ("7.1", "OGC standard interfaces", "MIM7 R1.1"),
    ("7.2", "Open geo formats", "MIM7 R2.1"),
    ("7.3", "CRS declared (EPSG)", "MIM7 R5.1"),
    ("7.4", "Persistent IDs on spatial features (see 1.1)", "MIM7 R4.1"),
  ),
  section("MIM8 · Can our digital twin grow?",
    ("8.1", "Twin data and outputs via APIs", "MIM8 R1.1"),
    ("8.2", "Models documented and callable", "MIM8 R3.1, R3.2"),
    ("8.3", "Standard output formats", "MIM8 M2"),
    ("8.4", "Workflow provenance recorded", "MIM8 R4.4"),
  ),
  section("Cross-cutting tender clauses", accent: magenta, note: "The bidder confirms acceptance of the contract condition (M / N).",
    ("X.1", "Exit clause: free handover in open formats", "—"),
    ("X.2", "Rights in the data belong to the contracting authority", "—"),
    ("X.3", "No fees for own-data access", "—"),
    ("X.4", "API stability: versioned, 6 months notice of breaking changes", "—"),
  ),
)

#note(size: 8.4pt, gap: 6pt, "Short labels below stand for the full checklist items on the MIM pages — in case of doubt, the full item text governs.")
#spec-link("An editable version of the table is at:", "https://marek-mraz.github.io/mims-procurement-checklist/")
#pagebreak()


// ════════════════════════════════════════════════════════════════════════════
//  GLOSSARY AND FURTHER READING
// ════════════════════════════════════════════════════════════════════════════
#fit-page("glossary")[
  #band("Small glossary", id: "glossary")

  #glossary(
    term("API",
      "A doorway through which one program asks another for data — over the web, without a human clicking."),
    term("Data model",
      "The agreed shape of the data: which fields exist, what they mean, which units they use."),
    term("DCAT-AP",
      "European metadata profile for data catalogues; it lets datasets be found on national and European portals too."),
    term("EPSG",
      "Registry of numeric codes for coordinate reference systems (e.g. EPSG:4326 for WGS 84)."),
    term("Identifier",
      "A permanent name for one thing (one lamp, one building) that all systems use to mean that thing."),
    term("Interoperability",
      "The ability of systems from different vendors to exchange data and understand it."),
    term("IRI",
      "International form of a web identifier (like a URL, with non-ASCII characters allowed). MIM1 names entities with it."),
    term("LDT",
      "Local Digital Twin: a digital model of a city or a part of it, connected to data and simulations."),
    term("Machine-readable",
      "Structured so a program can process it directly (JSON, CSV) — a PDF of a table is not."),
    term("Metadata",
      "Data about data: what a dataset contains, who provides it, how current it is, under what licence."),
    term("OAuth 2.0 / OIDC",
      "Open standards for login and for granting access. OpenID Connect (OIDC) adds identity verification to OAuth 2.0."),
    term("OGC",
      "Open Geospatial Consortium: the body that publishes standards for geospatial data and services (OGC API, WFS, SensorThings)."),
    term("Open standard",
      "A technical rule anyone may read and implement without paying or asking permission."),
    term("OpenAPI",
      "Open format for a machine-readable description of a web API: addresses, parameters, responses."),
    term("Serialisation",
      "Writing data in a concrete format (e.g. JSON, XML) so that it can be stored or sent."),
    term("TLS",
      "The protocol that encrypts data in transit over a network (the basis of HTTPS)."),
    term("Vendor lock-in",
      "When leaving a supplier costs so much — in data, formats or fees — that you effectively cannot."),
    term("Webhook / MQTT",
      "Two ways for a system to report a change itself: a webhook calls your address, MQTT delivers messages to subscribers."),
  )

  #more-links("Where to learn more",
    more-link("mims.oascities.org", "The full MIMs Plus specification, maintained by OASC."),
    more-link("living-in.eu", "The European movement for digital transformation of cities — declaration and MIMs Plus context."),
    more-link("smartdatamodels.org", "The open library of standard data models (FIWARE, TM Forum, IUDX, OASC)."),
    more-link("oascities.org/academy", "CITYxCITY Academy — courses for city staff, by cities."),
  )
]


