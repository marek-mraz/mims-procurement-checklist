  )

  #item("All data transfer is encrypted (TLS 1.3 or current best practice).",
    why:  "Baseline hygiene; NIS2 also expects it where it applies to you.",
    refs: "MIM6 R2.1, M1.1",
    num:  "6.1")

  #item("Login and machine access use open standards — OAuth 2.0 / OpenID Connect — and can plug into the city’s existing identity provider.",
    why:  "One account per employee, not one per vendor product; leavers lose access everywhere at once.",
    refs: "MIM6 R3.1, M1.2, M1.3",
    num:  "6.2")

  #item("Access rights are role-based, reviewable, and removable; access and admin actions are logged.",
    why:  "Audits and incident response become possible. Logging is ISO/IEC 27001:2022, Annex A, control 8.15, which MIM6 lists among its prerequisites.",
    refs: "MIM6 R1.1, R1.3, 8.15",
    num:  "6.3")

  #item("The supplier must show alignment with ISO/IEC 27001:2022 (or equivalent) for the service they operate.",
    why:  "Security is a process, not a checkbox at delivery. The specification cites ISO/IEC 27001 controls, not a certificate.",
    refs: "MIM6 C1–C3 (ISO/IEC 27001)",
    num:  "6.4",
    label: "Belongs in the conditions of participation, not in the technical specification")

  #panels(
    why:   ("Why it matters", (
      "A breach in one system does not open every system.",
      "Where NIS2 applies to you, complying with it and with national cyber rules gets measurably easier.",
      "When something goes wrong, the logs tell you what and who.",
    )),
    flags: ("Red flags", (
      "Proprietary login only.",
      "“Logs available on request.”",
      "Shared admin accounts.",
    )),
  )
]
