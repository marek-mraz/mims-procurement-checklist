#fit-page("MIM6 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM6",
    title:  "X'tgħid l-ispeċifikazzjoni",
    leadin: "Kull rekwiżit ta' dan il-MIM, kelma b'kelma minn MIMs Plus 9.0: L-ispeċifikazzjoni teżisti biss bl-Ingliż: il-kliem bil-Malti huwa traduzzjoni mhux uffiċjali mill-awtur ta' dan il-ktejjeb; l-oriġinal bl-Ingliż taħtu huwa vinkolanti.",
    back:   "lura għal-lista",
  )

  #spec-list(mim: "MIM6",
    capability("C1", "Data is only accessible to users that should have access to it",
      tr: "Id-data hija aċċessibbli biss għal utenti li għandu jkollhom aċċess għaliha"),
    req("R1.1",
      tr: "Regoli għall-kontroll tal-aċċess fiżiku u loġiku għall-informazzjoni u assi assoċjati oħra GĦANDHOM jiġu stabbiliti u implimentati abbażi ta' rekwiżiti tan-negozju u tas-sigurtà tal-informazzjoni. (ISO 27001 5.15 Kontroll tal-aċċess)",
      en: "Rules to control physical and logical access to information and other associated assets SHALL be established and implemented based on business and information security requirements. (ISO 27001 5.15 Access control)"),
    req("R1.2",
      tr: "L-allokazzjoni u l-immaniġġjar ta' informazzjoni dwar l-awtentikazzjoni GĦANDHOM ikunu kkontrollati minn proċess ta' ġestjoni, inkluż l-għoti ta' pariri lill-persunal dwar it-trattament xieraq ta' informazzjoni dwar l-awtentikazzjoni. (ISO 27001 5.17: Informazzjoni dwar l-awtentikazzjoni)",
      en: "Allocation and management of authentication information SHALL be controlled by a management process, including advising personnel on appropriate handling of authentication information. (ISO 27001 5.17: Authentication information)"),
    req("R1.3",
      tr: "Id-drittijiet ta' aċċess għal informazzjoni u assi assoċjati oħra GĦANDHOM jiġu pprovduti, irreveduti, modifikati u mneħħija skont il-politika tal-organizzazzjoni speċifika għas-suġġett dwar u r-regoli għall-kontroll tal-aċċess. (ISO 27001 5.18: Drittijiet ta' aċċess)",
      en: "Access rights to information and other associated assets SHALL be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control. (ISO 27001 5.18: Access rights)"),
    capability("C2", "Data accessed by users has not been altered",
      tr: "Id-data aċċessata mill-utenti ma ġietx mibdula"),
    req("R2.1",
      tr: "Regoli għall-użu effettiv tal-kriptografija, inkluż il-ġestjoni ta' ċwievet kriptografiċi, GĦANDHOM jiġu definiti u implimentati. (ISO 27001 8.24 Użu tal-kriptografija)",
      en: "Rules for the effective use of cryptography, including cryptographic key management, SHALL be defined and implemented. (ISO 27001 8.24 Use of cryptography)"),
    capability("C3", "Data accessed by users originates from a verified source",
      tr: "Id-data aċċessata mill-utenti toriġina minn sors ivverifikat"),
    req("R3.1",
      tr: "Teknoloġiji u proċeduri ta' awtentikazzjoni sigura għandhom jiġu implimentati abbażi ta' restrizzjonijiet fuq l-aċċess għall-informazzjoni u l-politika speċifika għas-suġġett dwar il-kontroll tal-aċċess. (ISO 27001 8.5 Awtentikazzjoni sigura)",
      en: "Secure authentication technologies and procedures shall be implemented based on information access restrictions and the topic-specific policy on access control. (ISO 27001 8.5 Secure authentication)"),
    capability("M1", "Mechanism candidate",
      tr: "Mekkaniżmu kandidat"),
    req("M1.1",
      tr: "Il-Protokoll tas-Sigurtà tas-Saff tat-Trasport (TLS), Verżjoni 1.3",
      en: "The Transport Layer Security (TLS) Protocol, Version 1.3"),
    req("M1.2",
      tr: "Il-Qafas ta' Awtorizzazzjoni OAuth 2.0",
      en: "The OAuth 2.0 Authorization Framework"),
    req("M1.3",
      tr: "OpenID Connect 1.0, Saff ta' identità għall-awtentikazzjoni fuq OAuth 2.0",
      en: "OpenID Connect 1.0, Identity layer for authentication on OAuth 2.0"),
    req("M1.4",
      tr: "OIDC4VCI / OIDC4VP, OpenID għall-Ħruġ u l-Preżentazzjoni ta' Kredenzjali Verifikabbli",
      en: "OIDC4VCI / OIDC4VP, OpenID for Verifiable Credential Issuance and Presentations"),
    capability("P", "Pre- and Post-requisites (based on ISO 27001 Annex A): the control this booklet refers to",
      tr: "Pre- u Post-rekwiżiti (ibbażati fuq ISO 27001 Anness A): il-kontroll li jirreferi għalih dan il-ktejjeb"),
    req("8.15",
      tr: "Qtugħ ta' reġistri. Reġistri li jirreġistraw attivitajiet, eċċezzjonijiet, difetti u avvenimenti rilevanti oħra għandhom jiġu prodotti, maħżuna, protetti u analizzati.",
      en: "Logging. Logs that record activities, exceptions, faults and other relevant events shall be produced, stored, protected and analysed."),
  )

  #spec-link("Speċifikazzjoni sħiħa:", "https://mims.oascities.org/securing-data")
]
