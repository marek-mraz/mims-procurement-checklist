    intro:    "Mhux id-data kollha tal-belt tista' tiġi sempliċement ippubblikata: parti minnha hija kummerċjali, u oħra sensittiva. MIM3 jittratta l-kondiviżjoni tal-kumplament xorta waħda, b'mod sikur: katalgu li n-nies jistgħu jfittxu fih, liċenzji minn mudelli minflok test legali mfassal apposta, u regoli ta' governanza li kulħadd jista' jaqra. L-ispeċifikazzjoni tifformula kważi l-MIM3 kollu bħala rakkomandazzjoni (ara p. 3).",
    list:     "Lista",
  )

  #item("Kull sett ta' data li toffri s-sistema huwa deskritt b'metadata standard (pereżempju DCAT-AP) f'katalgu, sabiex oħrajn ikunu jistgħu jiskopruh.",
    why:  "Data li ħadd ma jista' jsib hija data li ħadd ma juża.",
    refs: "MIM3 RC4.1–RC4.3",
    num:  "3.1")

  #item("It-termini u l-liċenzji għall-użu tad-data jiġu minn mudelli magħrufa sew (eż. liċenzji miftuħa, ftehimiet standard għall-kondiviżjoni tad-data), mhux test legali mfassal apposta għal kull sett ta' data.",
    why:  "L-arranġamenti jistgħu jiġu skalati mingħajr reviżjoni legali każ b'każ.",
    refs: "MIM3 RC2.2, RC2.3",
    num:  "3.2")

  #item("Il-belt tista' tiddefinixxi min jista' jaċċessa liema assi ta' data u taħt liema kundizzjonijiet, u tbiddel dan mingħajr l-involviment tal-bejjiegħ.",
    why:  "Il-governanza tibqa' f'idejn il-muniċipalità.",
    refs: "MIM3 RC1.1, RC2.1",
    num:  "3.3")

  #panels(
    why:   ("Għaliex huwa importanti", (
      "Kumpaniji lokali u riċerkaturi jibnu fuq data tal-belt — il-valur jibqa' fir-reġjun.",
      "Data sensittiva tista' tiġi kondiviża eżattament mas-sħab it-tajba, mhux ma' kulħadd jew ma' ħadd.",
      "Ktieb ta' regoli wieħed jissostitwixxi bosta kuntratti individwali ta' kondiviżjoni ta' data.",
    )),
    flags: ("Sinjali ta' twissija", (
      "Il-bejjiegħ jippretendi drittijiet fuq id-data tal-belt (ara l-klawżola “Drittijiet fuq id-data”).",
      "Il-kondiviżjoni ma' parti terza teħtieġ il-kunsens jew ħlasijiet lill-bejjiegħ.",
    )),
  )
]
