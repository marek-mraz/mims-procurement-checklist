//  MIM3 · LEFT PAGE · CHECKLIST
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 checklist")[
  #mim-page(
    id:       "MIM3",
    name:     "Scambio di dati",
    question: "Possiamo condividere a condizioni chiare?",
    url:      "https://mims.oascities.org/exchanging-data",
    intro:    "Non tutti i dati comunali possono essere semplicemente pubblicati: alcuni sono commerciali, altri riservati. MIM3 disciplina la condivisione sicura di tutti gli altri: un catalogo consultabile, licenze basate su modelli standard anziché clausole legali create ad hoc e regole di governance chiare per tutti. La specifica formula quasi tutto il MIM3 come raccomandazione (si veda pag. 3).",
    list:     "Checklist",
  )

  #item("Ogni serie di dati offerta dal sistema è descritta con metadati standard (ad esempio DCAT-AP) in un catalogo, affinché altri possano trovarla.",
    why:  "I dati che nessuno trova sono dati che nessuno usa.",
    refs: "MIM3 RC4.1–RC4.3",
    num:  "3.1")

  #item("Condizioni e licenze d'uso dei dati derivano da modelli consolidati (es. licenze aperte, accordi standard di condivisione dati), non da clausole create ad hoc.",
    why:  "Gli accordi scalano; l'ufficio legale non diventa un collo di bottiglia.",
    refs: "MIM3 RC2.2, RC2.3",
    num:  "3.2")

  #item("Il comune può stabilire chi può accedere a ciascuna risorsa di dati e a quali condizioni, modificando tali regole senza l'intervento del fornitore.",
    why:  "La governance resta in capo all'amministrazione comunale.",
    refs: "MIM3 RC1.1, RC2.1",
    num:  "3.3")

  #panels(
    why:   ("Perché è importante", (
      "Aziende e ricercatori locali creano valore sui dati comunali — l'indotto resta sul territorio.",
      "I dati riservati possono essere condivisi solo con partner qualificati, non con tutti o con nessuno.",
      "Un unico regolamento generale sostituisce decine di singoli contratti di condivisione.",
    )),
    flags: ("Segnali d'allarme", (
      "Il fornitore rivendica diritti sui dati dell'ente (si veda la clausola «Titolarità dei dati»).",
      "La condivisione con terzi richiede il consenso o il pagamento di canoni al fornitore.",
    )),
  )
]
#pagebreak()


// ════════════════════════════════════════════════════════════════════════════
//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Cosa dice la specifica",
    leadin: "Ogni requisito di questo MIM, testuale da MIMs Plus 9.0: La specifica esiste solo in lingua inglese: il testo in italiano è una traduzione non ufficiale a cura dell'autore di questa guida; il testo originale inglese sottostante fa fede.",
    back:   "torna alla checklist",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Le regole di governance per l'ecosistema di condivisione dei dati possono essere definite"),
    req("RC1.1",
      tr: "L'orchestratore di un ecosistema di dati dovrebbe essere in grado di definire un modello di governance (ad es. un regolamento) che delinei le regole di adesione, i ruoli, le responsabilità e gli obblighi dei partecipanti all'ecosistema, nonché i principi generali che ne regolano lo scambio di dati.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "I membri che partecipano a un ecosistema di dati dovrebbero essere a conoscenza del suo modello di governance e di qualsiasi modifica apportata allo stesso.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Il modello di governance dovrebbe essere facilmente comprensibile da parte di tutti i partecipanti all'ecosistema.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Termini e condizioni per la condivisione dei dati possono essere definiti"),
    req("RC2.1",
      tr: "I fornitori di dati sono liberi di definire i termini e le condizioni a cui desiderano che i propri dati vengano scambiati. (Nota: prima di condividere risorse di dati, i fornitori di dati dovrebbero assicurarsi di disporre dell'adeguata autorizzazione da parte dei titolari dei dati.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Termini e condizioni per lo scambio di dati dovrebbero essere descritti in modo chiaro e inequivocabile affinché risultino facilmente comprensibili agli utenti dei dati.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Termini e condizioni per lo scambio di dati dovrebbero essere espressi mediante licenze sui dati o accordi di condivisione dei dati basati su modelli o standard ben definiti.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Termini e condizioni dovrebbero essere in linea con il modello generale di governance dell'ecosistema di dati e non devono essere in contrasto con esso. (Nota: un fornitore di dati può decidere di non partecipare a un ecosistema di dati se il modello di governance sottostante è troppo restrittivo o troppo permissivo.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "La conformità ai termini e alle condizioni di condivisione dei dati può essere validata"),
    req("RC3.1",
      tr: "L'orchestratore di un ecosistema di dati deve essere in grado di accertare la conformità dei propri partecipanti al modello di governance sottostante.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "I fornitori di dati dovrebbero essere in grado di accertare che l'uso dei dati da parte di un utente dei dati sia conforme ai termini e alle condizioni precedentemente concordati.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Gli utenti dei dati dovrebbero essere in grado di accertare che la fornitura di dati da parte del fornitore di dati rispetti i termini e le condizioni precedentemente concordati.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Le risorse di dati disponibili possono essere scoperte"),
    req("RC4.1",
      tr: "Gli utenti dei dati dovrebbero essere in grado di scoprire quali dati sono disponibili in un ecosistema di condivisione dei dati senza averne conoscenza preventiva.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Le risorse di dati dovrebbero essere adeguatamente descritte con metadati affinché gli utenti dei dati possano prendere decisioni affidabili in merito all'uso ulteriore a cui sono destinate.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "I metadati utilizzati per descrivere le risorse di dati dovrebbero basarsi su formati di descrizione ben definiti e facili da comprendere, che siano leggibili sia dall'uomo sia da una macchina.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "I partecipanti all'ecosistema possono essere scoperti"),
    req("RC5.1",
      tr: "I partecipanti all'ecosistema (ad es. utenti e fornitori di dati) dovrebbero essere in grado di scoprirsi reciprocamente all'interno di un ecosistema di condivisione dei dati.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Metadati sufficienti su ciascun partecipante all'ecosistema dovrebbero essere disponibili per accertarne l'affidabilità rilevante ai fini dello scambio di dati.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "I fornitori di dati dovrebbero essere in grado di identificare in modo affidabile gli utenti dei dati che intendono accedere alle loro risorse di dati e di verificarne i metadati prima di concedere l'accesso.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Gli utenti dei dati dovrebbero essere in grado di identificare i fornitori di dati che condividono dati in un ecosistema di dati prima di accedere a tali dati o di utilizzarli.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "I partecipanti all'ecosistema possono anche scegliere di rimanere anonimi se il modello di governance dell'ecosistema di condivisione dei dati lo consente. In questo caso, i requisiti da RC5.1 a RC5.4 possono essere ignorati.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Lo scambio di dati può essere concordato"),
    req("RC6.1",
      tr: "Gli utenti e i fornitori di dati dovrebbero essere in grado di concordare uno scambio di dati e i relativi termini e condizioni (ad es. accettazione dei termini, firma formale di un accordo o negoziazione).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Gli utenti e i fornitori di dati dovrebbero essere in grado di risolvere uno scambio di dati precedentemente concordato in conformità con i termini e le condizioni a esso associati.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Ove possibile, possono essere forniti strumenti elettronici per la stipula e la risoluzione di uno scambio di dati.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Nuovi dati attualmente non disponibili possono essere richiesti"),
    req("RC7.1",
      tr: "Gli utenti dei dati dovrebbero essere in grado di esprimere il proprio interesse per risorse di dati attualmente non disponibili nell'ecosistema di condivisione dei dati.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "I fornitori di dati dovrebbero essere in grado di ricevere le richieste avanzate dagli utenti dei dati per nuove risorse di dati.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Specifica completa:", "https://mims.oascities.org/exchanging-data")
]
#pagebreak()


// ════════════════════════════════════════════════════════════════════════════
//  MIM6 · LEFT PAGE · CHECKLIST
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM6 checklist")[
  #mim-page(
    id:       "MIM6",
    name:     "Sicurezza dei dati",
    question: "I nostri dati sono al sicuro in transito e durante l'uso?",
    url:      "https://mims.oascities.org/securing-data",
    intro:    "Le smart city sono bersagli sensibili. MIM6 mantiene un perimetro mirato e concreto: cifrare i dati in transito, adottare sistemi di autenticazione standard anziché proprietari, controllare e registrare chi accede a cosa. Nulla di esotico — ma ogni elemento deve figurare nel contratto.",
    list:     "Checklist",
  )

  #item("Tutti i trasferimenti di dati sono cifrati (TLS 1.3 o le migliori prassi attuali).",
    why:  "Sicurezza informatica di base; richiesta anche dalla direttiva NIS 2 ove applicabile.",
    refs: "MIM6 R2.1, M1.1",
