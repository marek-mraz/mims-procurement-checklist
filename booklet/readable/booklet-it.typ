#fit-page("MIM8 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM8",
    title:  "Cosa dice la specifica",
    leadin: "Ogni requisito di questo MIM, testuale da MIMs Plus 9.0: La specifica esiste solo in lingua inglese: il testo in italiano è una traduzione non ufficiale a cura dell'autore di questa guida; il testo originale inglese sottostante fa fede.",
    back:   "torna alla checklist",
  )

  #spec-list(mim: "MIM8",
    capability("C1", "Provide access to datasets used within the LDT, including static, real-time, and simulation data and calculation models",
      tr: "Fornire l'accesso alle serie di dati impiegate nel gemello digitale locale, compresi dati statici, in tempo reale e di simulazione, nonché ai modelli di calcolo"),
    req("R1.1",
      tr: "Il gemello digitale locale deve fornire l'accesso ai risultati delle simulazioni e agli input dei modelli di calcolo laddove siano necessari nell'ambito dei flussi di lavoro del gemello stesso.",
      en: "The LDT shall provide access to simulation outputs and calculation-model inputs where these are needed as part of LDT workflows."),
    req("R1.2",
      tr: "Il gemello digitale locale dovrebbe distinguere chiaramente tra dati di origine grezzi, dati trasformati pronti per il flusso di lavoro, input dei modelli e output dei modelli.",
      en: "The LDT should distinguish clearly between raw source data, transformed workflow-ready data, model inputs, and model outputs."),
    capability("C2", "Exchange data with external systems and other LDTs using interoperable interfaces",
      tr: "Scambiare dati con sistemi esterni e con altri gemelli digitali locali impiegando interfacce interoperabili"),
    req("C2",
      tr: "Questa capacità fa affidamento su MIM3 (Scambio di dati) per lo scambio dei dati.",
      en: "This capability relies on MIM3 (Exchanging Data) for data exchange."),
    capability("C3", "Reuse deterministic or AI models across different domains, communities, use cases, and/or LDTs",
      tr: "Riutilizzare modelli deterministici o di IA tra differenti domini, comunità, casi d'uso e/o gemelli digitali locali"),
    req("R3.1",
      tr: "Il modello dovrebbe fornire metadati standard del modello, comprendenti una descrizione dei relativi metodi e parametri, e i parametri dei dati (sia per valore sia per riferimento). A tale scopo dovrebbero essere utilizzati standard comuni di metadati.",
      en: "The model should provide standard model metadata, including a description of its methods and parameters, and data-parameters (either by value or by reference). To this end common metadata standards should be used."),
    req("R3.2",
      tr: "Il modello deve esporre o essere invocabile attraverso un'interfaccia documentata, preferibilmente utilizzando un'API standardizzata nota. La serie di dati che costituisce il risultato del modello deve essere descritta (a livello di dati).",
      en: "The model shall expose or be callable through a documented interface, preferably using a known standardised API. The dataset that forms the outcome of the model shall be described (at data-level)."),
    req("R3.3",
      tr: "Un uso affidabile, fidato ed etico dei metodi innovativi (LLM, IA agentica, ecc.) dovrebbe essere salvaguardato. Le distorsioni (bias) dovrebbero essere ridotte al minimo ove applicabile. I metodi impiegati per garantire ciò dovrebbero essere descritti.",
      en: "Trustworthy, reliable, and ethical use of innovative methods (LLMs, agentic AI, etc.) should be safeguarded. Bias should minimised [sic] where applicable. The methods used to guarantee this, should be described."),
    req("R3.4",
      tr: "Il modello deve essere in grado di accedere ai dati per conto dell'utente finale o dell'organizzazione. Si veda MIM3",
      en: "The model must be able to access data on behalf of the end-user or organisation. See MIM3"),
    req("R3.5",
      tr: "Affinché i dati possano essere utilizzati nei modelli di IA, la provenienza e l'affidabilità dovrebbero essere garantite. In alcuni casi, deve essere indicata una fonte autorevole, come un'agenzia governativa.",
      en: "For data to be used in AI models, provenance and trust should be guaranteed. In some cases, an authoratitive sourc [sic], such as a government agency must be listed."),
    capability("C4", "Coordinate and manage data, models, and processing workflows within an LDT (intra-LDT) and across LDTs (inter-LDT)",
      tr: "Coordinare e gestire dati, modelli e flussi di elaborazione all'interno di un gemello digitale locale (intra-LDT) e tra diversi gemelli digitali locali (inter-LDT)"),
    req("R4.1",
      tr: "Il gemello digitale locale supporta flussi di lavoro che connettono sorgenti di dati, trasformazioni dei dati, esecuzione di modelli, processi di simulazione e risultati.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "Il gemello digitale locale concatena le fasi del flusso di lavoro, in cui l'output di una fase può essere utilizzato come input per un'altra.",
      en: "The LDT chains workflow steps, where the output of one step can be used as the input for another."),
    req("R4.3",
      tr: "Il gemello digitale locale monitora lo stato di esecuzione del flusso di lavoro, compresi i processi completati, non riusciti e interrotti.",
      en: "The LDT monitors workflow execution status, including completed, failed, and interrupted processes."),
    req("R4.4",
      tr: "Il gemello digitale locale registra la provenienza del flusso di lavoro, comprese le serie di dati utilizzate (con versione e marca temporale), i modelli eseguiti, i parametri selezionati e i risultati generati.",
      en: "The LDT records workflow provenance, including datasets used (including version, timestamped), models executed, parameters selected, and outputs generated."),
    capability("C5", "Provide multiple visualisations of data and results (e.g. 2D, 3D, dashboards) from common underlying data and models for interaction and comparison",
      tr: "Offrire molteplici visualizzazioni di dati e risultati (es. 2D, 3D, dashboard) a partire da dati e modelli sottostanti condivisi per l'interazione e il confronto"),
    req("R5.1",
      tr: "Il gemello digitale locale fornisce metadati che spiegano cosa viene visualizzato, comprendenti marca temporale, ambito spaziale, sorgente di dati e, ove rilevante, ipotesi di scenari e varianti.",
      en: "The LDT provides metadata explaining what is visualised, including timestamp, spatial scope, data source, and scenario- and variant-assumptions where relevant."),
    req("R5.2",
      tr: "Il gemello digitale locale supporta diversi tipi di visualizzazione interattiva, come mappe 2D, scene 3D, dashboard, report o viste accessibili al pubblico.",
      en: "The LDT supports different interactive visualisation types, such as 2D maps, 3D scenes, dashboards, reports, or public-facing views."),
    capability("C6", "Ensure that data exchanged (and simulation outputs) within and between LDTs can be interpreted consistently through shared or mapped semantics and clear provenance",
      tr: "Garantire che i dati scambiati (e i risultati delle simulazioni) all'interno di e tra gemelli digitali locali possano essere interpretati in modo coerente attraverso semantiche condivise o mappate e una chiara provenienza"),
    req("R6.1",
      tr: "Il gemello digitale locale dovrebbe documentare disallineamenti semantici irrisolti, ipotesi o mappature che potrebbero influenzare l'interpretazione, il riutilizzo o il confronto dei risultati.",
      en: "The LDT should document unresolved semantic gaps, assumptions, or mappings that may affect the interpretation, reuse, or comparison of results."),
    capability("M", "Mechanisms (under active development)",
      tr: "Meccanismi (in corso di sviluppo)"),
    req("M1",
      tr: "Accesso alle risorse LDT basato su API",
      en: "API-based LDT Resource Access"),
    req("M2",
      tr: "Formati standardizzati di dati e output",
      en: "Standardised Data and Output Formats"),
    req("M3",
      tr: "Model-as-a-Service",
      en: "Model-as-a-Service"),
    req("M4",
      tr: "Orchestrazione dei flussi di lavoro LDT",
      en: "LDT Workflow Orchestration"),
    req("M5",
      tr: "Accesso a viste multiple di output e visualizzazione",
      en: "Multi-view Output and Visualisation Access"),
  )

  #spec-link("Specifica completa:", "https://mims.oascities.org/local-digital-twins")
]
