#fit-page("MIM7 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM7",
    title:  "Cosa dice la specifica",
    leadin: "Ogni requisito di questo MIM, testuale da MIMs Plus 9.0: La specifica esiste solo in lingua inglese: il testo in italiano è una traduzione non ufficiale a cura dell'autore di questa guida; il testo originale inglese sottostante fa fede.",
    back:   "torna alla checklist",
  )

  #spec-list(mim: "MIM7",
    capability("C1", "Cities and communities can easily transfer geospatial data between internal and external (including IoT-related) IT systems",
      tr: "Città e comunità possono trasferire agevolmente dati geospaziali tra sistemi informatici interni ed esterni (inclusi quelli correlati all'IoT)"),
    req("R1.1",
      tr: "I dati geospaziali devono essere esposti mediante un'interfaccia di servizio web basata su standard.",
      en: "Geospatial data shall be exposed through a standards-based web service interface."),
    capability("C2", "Cities and communities can integrate 2D and 3D geospatial data coming from a variety of sources, for example geodata and building information models, and share that data within and between them in an interoperable way",
      tr: "Città e comunità possono integrare dati geospaziali 2D e 3D provenienti da fonti eterogenee, come dati geografici e modelli BIM, condividendoli al proprio interno e tra loro in modo interoperabile"),
    req("R2.1",
      tr: "I dati geospaziali devono essere codificati utilizzando standard aperti. Si raccomanda di utilizzare gli standard pertinenti di OGC e di BuildingSMART International.",
      en: "Geospatial data shall be encoded using open standards. It is recommended to use relevant standards from OGC and BuildingSMART International."),
    capability("C3", "Cities and communities can integrate geospatial data with other data that can provide further information about the context",
      tr: "Città e comunità possono integrare i dati geospaziali con altri dati in grado di offrire maggiori informazioni sul contesto"),
    req("R3.1",
      tr: "Tutte le serie di dati utilizzate per fornire ulteriori informazioni sul contesto coperto dai dati geospaziali devono essere conformi a MIM1 e MIM2.",
      en: "All data sets used to provide further information about the context covered by geospatial data shall comply with MIM1 and MIM2."),
    capability("C4", "Cities and communities have a consistent and persistent way of describing individual instances of all features, things or entities included in the geospatial data sources",
      tr: "Città e comunità dispongono di una modalità coerente e persistente per descrivere le singole istanze di tutti gli elementi, oggetti o entità presenti nelle sorgenti di dati geospaziali"),
    req("R4.1",
      tr: "Devono essere utilizzati identificatori univoci e persistenti per identificare le singole istanze di qualsiasi entità utilizzata nelle serie di dati. (Si veda MIM1: Interconnessione dei dati.)",
      en: "Unique and persistent identifiers shall be used to identify particular instances of any entity used in data sets. (See MIM1: Interlinking Data.)"),
    capability("C5", "Coordinate Reference Systems (CRS) used in data sharing are easily transformable into a common CRS",
      tr: "I sistemi di riferimento di coordinate (CRS) impiegati nella condivisione dei dati sono facilmente convertibili in un CRS comune"),
    req("R5.1",
      tr: "I sistemi di riferimento di coordinate (CRS) devono essere conformi agli standard e devono essere fornite informazioni in merito allo standard utilizzato (es. EPSG:4326, EPSG:3857). Ciò comprende il codice EPSG o il codice WGS, unitamente alle informazioni su qualsiasi variante basata su sistemi nazionali come il lettone LKS-92, in modo che i dati possano essere convertiti in un CRS comune. (Nota: all'interno dell'UE, per i dati geospaziali è richiesto l'uso di metadati conformi alla direttiva INSPIRE, inclusi i metadati necessari per descrivere le informazioni sul CRS.)",
      en: "Coordinate Reference Systems (CRS) shall comply with standards, and information shall be provided regarding which standard (e.g. EPSG:4326, EPSG:3857) is being used. This includes the EPSG number or WGS number, along with information about any variation based on national systems such as the Latvian LKS-92, so that data can be transformed to a common CRS. (Note: Within the EU, for geospatial data it is required to use metadata compliant with the INSPIRE Directive, including the metadata needed to describe the CRS information.)"),
  )

  #spec-link("Specifica completa:", "https://mims.oascities.org/geospatial-data")
]
