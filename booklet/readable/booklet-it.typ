#fit-page("MIM6 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM6",
    title:  "Cosa dice la specifica",
    leadin: "Ogni requisito di questo MIM, testuale da MIMs Plus 9.0: La specifica esiste solo in lingua inglese: il testo in italiano è una traduzione non ufficiale a cura dell'autore di questa guida; il testo originale inglese sottostante fa fede.",
    back:   "torna alla checklist",
  )

  #spec-list(mim: "MIM6",
    capability("C1", "Data is only accessible to users that should have access to it",
      tr: "I dati sono accessibili esclusivamente agli utenti che dovrebbero avervi accesso"),
    req("R1.1",
      tr: "Le regole per il controllo dell'accesso fisico e logico alle informazioni e agli altri asset associati DEVONO essere definite e implementate sulla base dei requisiti di business e di sicurezza delle informazioni. (ISO 27001 5.15 Controllo degli accessi)",
      en: "Rules to control physical and logical access to information and other associated assets SHALL be established and implemented based on business and information security requirements. (ISO 27001 5.15 Access control)"),
    req("R1.2",
      tr: "L'assegnazione e la gestione delle informazioni di autenticazione DEVONO essere regolate da un processo di gestione, compresa l'istruzione del personale sulla corretta gestione delle informazioni di autenticazione. (ISO 27001 5.17: Informazioni di autenticazione)",
      en: "Allocation and management of authentication information SHALL be controlled by a management process, including advising personnel on appropriate handling of authentication information. (ISO 27001 5.17: Authentication information)"),
    req("R1.3",
      tr: "I diritti di accesso alle informazioni e agli altri asset associati DEVONO essere assegnati, riesaminati, modificati e revocati in conformità alla specifica politica dell'organizzazione e alle regole per il controllo degli accessi. (ISO 27001 5.18: Diritti di accesso)",
      en: "Access rights to information and other associated assets SHALL be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control. (ISO 27001 5.18: Access rights)"),
    capability("C2", "Data accessed by users has not been altered",
      tr: "I dati a cui gli utenti accedono non hanno subito alterazioni"),
    req("R2.1",
      tr: "Le regole per l'uso efficace della crittografia, compresa la gestione delle chiavi crittografiche, DEVONO essere definite e implementate. (ISO 27001 8.24 Uso della crittografia)",
      en: "Rules for the effective use of cryptography, including cryptographic key management, SHALL be defined and implemented. (ISO 27001 8.24 Use of cryptography)"),
    capability("C3", "Data accessed by users originates from a verified source",
      tr: "I dati a cui gli utenti accedono provengono da una sorgente verificata"),
    req("R3.1",
      tr: "Le tecnologie e le procedure di autenticazione sicura devono essere implementate sulla base delle restrizioni di accesso alle informazioni e della politica specifica per il controllo degli accessi. (ISO 27001 8.5 Autenticazione sicura)",
      en: "Secure authentication technologies and procedures shall be implemented based on information access restrictions and the topic-specific policy on access control. (ISO 27001 8.5 Secure authentication)"),
    capability("M1", "Mechanism candidate",
      tr: "Candidato al meccanismo"),
    req("M1.1",
      tr: "Il protocollo Transport Layer Security (TLS), Versione 1.3",
      en: "The Transport Layer Security (TLS) Protocol, Version 1.3"),
    req("M1.2",
      tr: "Il framework di autorizzazione OAuth 2.0",
      en: "The OAuth 2.0 Authorization Framework"),
    req("M1.3",
      tr: "OpenID Connect 1.0, Livello di identità per l'autenticazione su OAuth 2.0",
      en: "OpenID Connect 1.0, Identity layer for authentication on OAuth 2.0"),
    req("M1.4",
      tr: "OIDC4VCI / OIDC4VP, OpenID per il rilascio e la presentazione di credenziali verificabili",
      en: "OIDC4VCI / OIDC4VP, OpenID for Verifiable Credential Issuance and Presentations"),
    capability("P", "Pre- and Post-requisites (based on ISO 27001 Annex A): the control this booklet refers to",
      tr: "Prerequisiti e requisiti successivi (basati su ISO 27001 Allegato A): il controllo a cui fa riferimento questa guida"),
    req("8.15",
      tr: "Registrazione delle attività (logging). I registri che tengono traccia di attività, eccezioni, anomalie e altri eventi rilevanti devono essere prodotti, archiviati, protetti e analizzati.",
      en: "Logging. Logs that record activities, exceptions, faults and other relevant events shall be produced, stored, protected and analysed."),
  )

  #spec-link("Specifica completa:", "https://mims.oascities.org/securing-data")
]
