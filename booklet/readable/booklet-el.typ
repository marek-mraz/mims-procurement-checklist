#fit-page("why")[
  #band("Σκοπός αυτού του φυλλαδίου")

  #lead("Κάθε χρόνο, οι πόλεις αγοράζουν λογισμικό: συστήματα στάθμευσης, πλατφόρμες αισθητήρων, χαρτογραφικές πύλες, ψηφιακά δίδυμα. Πολύ συχνά, τα δεδομένα που συλλέγουν αυτά τα συστήματα καταλήγουν κλειδωμένα στο εσωτερικό τους. Όταν λήγει η σύμβαση, τα δεδομένα —που έχουν χρηματοδοτηθεί με δημόσιους πόρους— χάνονται με την αποχώρηση του αναδόχου ή παραμένουν παγιδευμένα σε μορφή που κανένας άλλος δεν μπορεί να διαβάσει.")

  #lead("Δεν χρειάζεται να είναι έτσι. Οι Ελάχιστοι Μηχανισμοί Διαλειτουργικότητας (MIMs), που διατηρούνται από το Open & Agile Smart Cities (OASC) και υποστηρίζονται μέσω του ευρωπαϊκού κινήματος living-in.eu, περιγράφουν τις ελάχιστες τεχνικές απαιτήσεις που διατηρούν τα δεδομένα σας ανοικτά, επαναχρησιμοποιήσιμα και ανεξάρτητα από προμηθευτές. Είναι σκόπιμα περιορισμένοι σε έκταση: όχι μια μεγάλη αρχιτεκτονική, μόνο οι λίγες συνθήκες που πρέπει να ισχύουν ώστε τα συστήματα να ανταλλάσσουν δεδομένα.")

  #lead("Δεν απαιτείται τεχνικό υπόβαθρο για τη χρήση αυτού του φυλλαδίου. Κάθε κατάλογος ελέγχου μετατρέπει έναν MIM σε απλά σημεία ελέγχου που μπορείτε να αντιγράψετε σε μια διακήρυξη, με τον λόγο για τον οποίο το καθένα σας προστατεύει. Αμέσως μετά τον κατάλογο ελέγχου βρίσκετε κάθε απαίτηση αυτού του MIM, λέξη προς λέξη, ώστε οι τεχνικοί σας συνεργάτες και οι προσφέροντες να μπορούν να ελέγξουν τις λεπτομέρειες.")

  #lead("Οι πόλεις που απαιτούν τους MIMs αγοράζουν μία φορά και επαναχρησιμοποιούν πολλές: τα δεδομένα ποιότητας αέρα τροφοδοτούν τον πίνακα ελέγχου (dashboard) των σχολείων, το μητρώο οδοφωτισμού τροφοδοτεί το ενεργειακό σχέδιο και ο επόμενος προμηθευτής συνεχίζει από εκεί που σταμάτησε ο προηγούμενος. Αυτό σημαίνει διαλειτουργικότητα στην πράξη — και αναμένεται ολοένα και περισσότερο σε έργα που χρηματοδοτούνται από την ΕΕ.")

  #pull-quote(
    "Οι ελάχιστοι μηχανισμοί διαλειτουργικότητας (MIMs) επιτρέπουν ένα ελάχιστο αλλά επαρκές επίπεδο διαλειτουργικότητας για δεδομένα, συστήματα και υπηρεσίες, ειδικά στο πλαίσιο λύσεων για έξυπνες πόλεις. · Το κοινό στο οποίο απευθύνεται αυτό το έγγραφο είναι: · 1. Πάροχοι λύσεων που επιθυμούν να διασφαλίσουν ότι οι λύσεις τους είναι διαλειτουργικές με άλλες και επιτρέπουν την απρόσκοπτη ανταλλαγή δεδομένων σε περιβάλλον Έξυπνων Πόλεων και Κοινοτήτων. · 2. Αναθέτουσες αρχές που επιθυμούν να προμηθευτούν τεχνολογικά ανθεκτικές στον χρόνο λύσεις (future-proof) που επιτρέπουν οικονομικά αποδοτική ενσωμάτωση σε μια υφιστάμενη αρχιτεκτονική Τεχνολογιών Πληροφορικής και Επικοινωνιών (ΤΠΕ) Έξυπνων Πόλεων και Κοινοτήτων.",
  )

  #policy-box("Πώς συνδέονται οι MIMs με το δίκαιο της ΕΕ",
    "Οι MIMs αποτελούν τεχνική προδιαγραφή, όχι νόμο. Κινούνται στην ίδια κατεύθυνση με τους κανόνες της ΕΕ που εφαρμόζονται ήδη στα δημόσια δεδομένα και τις ψηφιακές υπηρεσίες:",
    law("Οδηγία για τις δημόσιες συμβάσεις", "Οδηγία 2014/24/ΕΕ, Άρθρο 42",
      "οι τεχνικές προδιαγραφές μπορούν να παραπέμπουν σε πρότυπα, πάντοτε με τη μνεία «ή ισοδύναμο»· κατά κανόνα δεν επιτρέπεται να κατονομάζουν συγκεκριμένη κατασκευή ή προϊόν."),
    law("Πράξη για τα δεδομένα", "Κανονισμός (ΕΕ) 2023/2854",
      "πρόσβαση σε δεδομένα από συνδεδεμένα προϊόντα και αλλαγή παρόχου υπολογιστικού νέφους χωρίς εγκλωβισμό."),
    law("Πράξη για μια διαλειτουργική Ευρώπη", "Κανονισμός (ΕΕ) 2024/903",
      "αξιολογήσεις διαλειτουργικότητας για διασυνοριακές ψηφιακές δημόσιες υπηρεσίες και επαναχρησιμοποίηση ανοικτών λύσεων."),
    law("Οδηγία για τα ανοικτά δεδομένα", "Οδηγία (ΕΕ) 2019/1024",
      "σύνολα δεδομένων υψηλής αξίας που δημοσιεύονται δωρεάν, σε μηχαναγνώσιμη μορφή, μέσω APIs."),
    law("Οδηγία NIS2", "Οδηγία (ΕΕ) 2022/2555",
      "βασικό επίπεδο κυβερνοασφάλειας· το εθνικό δίκαιο καθορίζει σε ποιον βαθμό καλύπτει την τοπική αυτοδιοίκηση."),
    law("GDPR", "Κανονισμός (ΕΕ) 2016/679",
      "δεδομένα προσωπικού χαρακτήρα σε δημοτικά συστήματα (στάθμευση, κάμερες, κινητικότητα)."),
    law("Πράξη για την ΤΝ", "Κανονισμός (ΕΕ) 2024/1689",
      "κανόνες για συστήματα τεχνητής νοημοσύνης· κρίσιμο για μοντέλα ΤΝ σε ψηφιακά δίδυμα."),
