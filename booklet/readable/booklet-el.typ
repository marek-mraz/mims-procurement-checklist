//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Τι αναφέρει η προδιαγραφή",
    leadin: "Κάθε απαίτηση αυτού του MIM, αυτολεξεί από τα MIMs Plus 9.0: Η προδιαγραφή υπάρχει μόνο στα αγγλικά: το κείμενο στην ελληνική γλώσσα αποτελεί ανεπίσημη μετάφραση από τον συντάκτη αυτού του φυλλαδίου· το αγγλικό πρωτότυπο που ακολουθεί είναι δεσμευτικό.",
    back:   "επιστροφή στον κατάλογο",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Μπορούν να οριστούν κανόνες διακυβέρνησης για το οικοσύστημα κοινοχρησίας δεδομένων"),
    req("RC1.1",
      tr: "Ο ενορχηστρωτής ενός οικοσυστήματος δεδομένων πρέπει να είναι σε θέση να ορίζει ένα μοντέλο διακυβέρνησης (π.χ. ένα εγχειρίδιο κανόνων) που περιγράφει τους κανόνες συμμετοχής, τους ρόλους, τις ευθύνες και τις υποχρεώσεις των συμμετεχόντων στο οικοσύστημα, καθώς και τις γενικές αρχές που διέπουν την ανταλλαγή δεδομένων μεταξύ τους.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Τα μέλη που συμμετέχουν σε ένα οικοσύστημα δεδομένων πρέπει να γνωρίζουν το μοντέλο διακυβέρνησής του και τυχόν αλλαγές που πραγματοποιούνται σε αυτό.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Το μοντέλο διακυβέρνησης πρέπει να είναι εύκολα κατανοητό από όλους τους συμμετέχοντες στο οικοσύστημα.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Μπορούν να οριστούν όροι και προϋποθέσεις για την κοινοχρησία δεδομένων"),
    req("RC2.1",
      tr: "Οι πάροχοι δεδομένων είναι ελεύθεροι να ορίζουν τους όρους και τις προϋποθέσεις υπό τις οποίες επιθυμούν να ανταλλάσσονται τα δεδομένα τους. (Σημείωση: Πριν από την κοινοχρησία στοιχείων δεδομένων, οι πάροχοι δεδομένων πρέπει να διασφαλίζουν ότι έχουν επαρκή άδεια από τους κατόχους των δεδομένων.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Οι όροι και οι προϋποθέσεις για μια ανταλλαγή δεδομένων πρέπει να περιγράφονται με σαφήνεια και χωρίς αμφισημίες, ώστε να είναι εύκολα κατανοητοί από τους χρήστες δεδομένων.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Οι όροι και οι προϋποθέσεις για μια ανταλλαγή δεδομένων πρέπει να εκφράζονται μέσω αδειών δεδομένων ή συμφωνιών κοινοχρησίας δεδομένων που βασίζονται σε σαφώς καθορισμένα πρότυπα ή υποδείγματα.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Οι όροι και οι προϋποθέσεις πρέπει να ευθυγραμμίζονται με το γενικό μοντέλο διακυβέρνησης του οικοσυστήματος δεδομένων και δεν πρέπει να έρχονται σε σύγκρουση με αυτό. (Σημείωση: Ένας πάροχος δεδομένων μπορεί να αποφασίσει να μη συμμετάσχει σε ένα οικοσύστημα δεδομένων εάν το υποκείμενο μοντέλο διακυβέρνησης είναι υπερβολικά περιοριστικό ή υπερβολικά ανεκτικό.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Μπορεί να επικυρωθεί η συμμόρφωση με τους όρους και τις προϋποθέσεις κοινοχρησίας δεδομένων"),
    req("RC3.1",
      tr: "Ο ενορχηστρωτής ενός οικοσυστήματος δεδομένων πρέπει να είναι σε θέση να εξακριβώνει τη συμμόρφωση των συμμετεχόντων του με το υποκείμενο μοντέλο διακυβέρνησης.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Οι πάροχοι δεδομένων πρέπει να είναι σε θέση να εξακριβώνουν ότι η χρήση των δεδομένων από έναν χρήστη δεδομένων συμμορφώνεται με τους προηγουμένως συμφωνηθέντες όρους και προϋποθέσεις.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Οι χρήστες δεδομένων πρέπει να είναι σε θέση να εξακριβώνουν ότι η παροχή δεδομένων από τον πάροχο δεδομένων ακολουθεί τους προηγουμένως συμφωνηθέντες όρους και προϋποθέσεις.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Μπορούν να ανακαλυφθούν διαθέσιμα στοιχεία δεδομένων"),
    req("RC4.1",
      tr: "Οι χρήστες δεδομένων πρέπει να είναι σε θέση να ανακαλύπτουν ποια δεδομένα είναι διαθέσιμα σε ένα οικοσύστημα κοινοχρησίας δεδομένων χωρίς προηγούμενη γνώση αυτών.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Τα στοιχεία δεδομένων πρέπει να περιγράφονται επαρκώς με μεταδεδομένα, ώστε οι χρήστες δεδομένων να μπορούν να λαμβάνουν αξιόπιστες αποφάσεις σχετικά με την περαιτέρω σκοπούμενη χρήση τους.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Τα μεταδεδομένα που χρησιμοποιούνται για την περιγραφή στοιχείων δεδομένων πρέπει να βασίζονται σε σαφώς καθορισμένους, εύκολα κατανοητούς μορφοτύπους περιγραφής που είναι τόσο αναγνώσιμοι από ανθρώπους όσο και μηχαναγνώσιμοι.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Μπορούν να ανακαλυφθούν συμμετέχοντες στο οικοσύστημα"),
    req("RC5.1",
      tr: "Οι συμμετέχοντες στο οικοσύστημα (π.χ. χρήστες και πάροχοι δεδομένων) πρέπει να είναι σε θέση να ανακαλύπτουν ο ένας τον άλλον εντός ενός οικοσυστήματος κοινοχρησίας δεδομένων.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Επαρκή μεταδεδομένα για κάθε συμμετέχοντα στο οικοσύστημα πρέπει να είναι διαθέσιμα για την εξακρίβωση της αξιοπιστίας τους που είναι σχετική με την ανταλλαγή δεδομένων.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Οι πάροχοι δεδομένων πρέπει να είναι σε θέση να ταυτοποιούν αξιόπιστα τους χρήστες δεδομένων που επιθυμούν να αποκτήσουν πρόσβαση στα στοιχεία δεδομένων τους και να επαληθεύουν τα μεταδεδομένα τους πριν από τη χορήγηση πρόσβασης.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Οι χρήστες δεδομένων πρέπει να είναι σε θέση να ταυτοποιούν τους παρόχους δεδομένων που κοινοποιούν δεδομένα σε ένα οικοσύστημα δεδομένων πριν από την πρόσβαση ή τη χρήση αυτών των δεδομένων.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Οι συμμετέχοντες στο οικοσύστημα δύνανται επίσης να επιλέξουν να παραμείνουν ανώνυμοι εάν το μοντέλο διακυβέρνησης του οικοσυστήματος κοινοχρησίας δεδομένων το επιτρέπει. Σε αυτήν την περίπτωση, τα RC5.1 έως RC5.4 μπορούν να αγνοηθούν.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Η ανταλλαγή δεδομένων μπορεί να συμφωνηθεί"),
    req("RC6.1",
      tr: "Οι χρήστες και οι πάροχοι δεδομένων πρέπει να είναι σε θέση να συμφωνούν για μια ανταλλαγή δεδομένων και τους όρους και τις προϋποθέσεις που σχετίζονται με αυτήν (π.χ. αποδοχή όρων, νομική υπογραφή συμφωνίας ή διαπραγμάτευση).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
