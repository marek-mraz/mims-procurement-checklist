#fit-page("MIM3 checklist")[
  #mim-page(
    id:       "MIM3",
    name:     "Ανταλλαγή δεδομένων",
    question: "Μπορούμε να κάνουμε κοινή χρήση με σαφείς όρους;",
    url:      "https://mims.oascities.org/exchanging-data",
    intro:    "Δεν μπορούν να δημοσιεύονται απλώς όλα τα δεδομένα της πόλης: ορισμένα είναι εμπορικά, άλλα ευαίσθητα. Το MIM3 αφορά την ασφαλή κοινοχρησία των υπολοίπων: έναν κατάλογο με δυνατότητα αναζήτησης, άδειες βάσει προτύπων αντί για ειδικά συνταγμένα νομικά κείμενα, και κανόνες διακυβέρνησης αναγνώσιμους από όλους. Η προδιαγραφή διατυπώνει σχεδόν ολόκληρο το MIM3 ως σύσταση (βλ. σελ. 3).",
    list:     "Κατάλογος ελέγχου",
  )

  #item("Κάθε σύνολο δεδομένων που προσφέρει το σύστημα περιγράφεται με τυποποιημένα μεταδεδομένα (για παράδειγμα DCAT-AP) σε έναν κατάλογο, ώστε άλλοι να μπορούν να το ανακαλύψουν.",
    why:  "Δεδομένα που κανείς δεν μπορεί να βρει είναι δεδομένα που κανείς δεν χρησιμοποιεί.",
    refs: "MIM3 RC4.1–RC4.3",
    num:  "3.1")

  #item("Οι όροι και οι άδειες χρήσης δεδομένων προέρχονται από γνωστά πρότυπα (π.χ. ανοικτές άδειες, τυποποιημένες συμφωνίες κοινοχρησίας δεδομένων), όχι από ειδικά συνταγμένα νομικά κείμενα ανά σύνολο δεδομένων.",
    why:  "Οι συμφωνίες κλιμακώνονται χωρίς νομικό έλεγχο ανά περίπτωση.",
    refs: "MIM3 RC2.2, RC2.3",
    num:  "3.2")

  #item("Ο δήμος μπορεί να ορίζει ποιος έχει πρόσβαση σε ποιο στοιχείο δεδομένων και υπό ποιες προϋποθέσεις, καθώς και να τροποποιεί τα ανωτέρω χωρίς την παρέμβαση του προμηθευτή.",
    why:  "Η διακυβέρνηση παραμένει στον δήμο.",
    refs: "MIM3 RC1.1, RC2.1",
    num:  "3.3")

  #panels(
    why:   ("Γιατί έχει σημασία", (
      "Τοπικές επιχειρήσεις και ερευνητές βασίζονται στα δεδομένα της πόλης — η αξία παραμένει στην περιοχή.",
      "Τα ευαίσθητα δεδομένα μπορούν να κοινοποιηθούν ακριβώς στους κατάλληλους εταίρους, όχι σε όλους ή σε κανέναν.",
      "Ένα ενιαίο σύνολο κανόνων αντικαθιστά πολλές μεμονωμένες συμβάσεις κοινοχρησίας δεδομένων.",
    )),
    flags: ("Ενδείξεις κινδύνου", (
      "Ο προμηθευτής διεκδικεί δικαιώματα επί των δεδομένων του δήμου (βλ. τη ρήτρα «Δικαιώματα επί των δεδομένων»).",
      "Η κοινοχρησία με τρίτους απαιτεί τη συγκατάθεση του προμηθευτή ή την καταβολή τελών.",
    )),
  )
]
