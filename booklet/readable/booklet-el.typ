#fit-page("MIM7 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM7",
    title:  "Τι αναφέρει η προδιαγραφή",
    leadin: "Κάθε απαίτηση αυτού του MIM, αυτολεξεί από τα MIMs Plus 9.0: Η προδιαγραφή υπάρχει μόνο στα αγγλικά: το κείμενο στην ελληνική γλώσσα αποτελεί ανεπίσημη μετάφραση από τον συντάκτη αυτού του φυλλαδίου· το αγγλικό πρωτότυπο που ακολουθεί είναι δεσμευτικό.",
    back:   "επιστροφή στον κατάλογο",
  )

  #spec-list(mim: "MIM7",
    capability("C1", "Cities and communities can easily transfer geospatial data between internal and external (including IoT-related) IT systems",
      tr: "Πόλεις και κοινότητες μεταφέρουν εύκολα γεωχωρικά δεδομένα μεταξύ εσωτερικών και εξωτερικών συστημάτων ΤΠΕ"),
    req("R1.1",
      tr: "Τα γεωχωρικά δεδομένα πρέπει να εκτίθενται μέσω μιας διεπαφής διαδικτυακής υπηρεσίας βασισμένης σε πρότυπα.",
      en: "Geospatial data shall be exposed through a standards-based web service interface."),
    capability("C2", "Cities and communities can integrate 2D and 3D geospatial data coming from a variety of sources, for example geodata and building information models, and share that data within and between them in an interoperable way",
      tr: "Πόλεις και κοινότητες ενοποιούν γεωχωρικά δεδομένα 2D/3D από διάφορες πηγές και τα κοινοποιούν διαλειτουργικά"),
    req("R2.1",
      tr: "Τα γεωχωρικά δεδομένα πρέπει να κωδικοποιούνται με χρήση ανοικτών προτύπων. Συνιστάται η χρήση σχετικών προτύπων από το OGC και το BuildingSMART International.",
      en: "Geospatial data shall be encoded using open standards. It is recommended to use relevant standards from OGC and BuildingSMART International."),
    capability("C3", "Cities and communities can integrate geospatial data with other data that can provide further information about the context",
      tr: "Πόλεις και κοινότητες ενοποιούν γεωχωρικά δεδομένα με άλλα δεδομένα που παρέχουν πλαίσιο"),
    req("R3.1",
      tr: "Όλα τα σύνολα δεδομένων που χρησιμοποιούνται για την παροχή περαιτέρω πληροφοριών σχετικά με το πλαίσιο που καλύπτεται από γεωχωρικά δεδομένα πρέπει να συμμορφώνονται με τα MIM1 και MIM2.",
      en: "All data sets used to provide further information about the context covered by geospatial data shall comply with MIM1 and MIM2."),
    capability("C4", "Cities and communities have a consistent and persistent way of describing individual instances of all features, things or entities included in the geospatial data sources",
      tr: "Συνεπής και διαρκής τρόπος περιγραφής μεμονωμένων εμφανίσεων όλων των στοιχείων στα γεωχωρικά δεδομένα"),
    req("R4.1",
      tr: "Μοναδικά και διαρκή αναγνωριστικά πρέπει να χρησιμοποιούνται για τον προσδιορισμό συγκεκριμένων εμφανίσεων οποιασδήποτε οντότητας χρησιμοποιείται σε σύνολα δεδομένων. (Βλ. MIM1: Διασύνδεση Δεδομένων.)",
      en: "Unique and persistent identifiers shall be used to identify particular instances of any entity used in data sets. (See MIM1: Interlinking Data.)"),
    capability("C5", "Coordinate Reference Systems (CRS) used in data sharing are easily transformable into a common CRS",
      tr: "Τα Συστήματα Αναφοράς Συντεταγμένων (CRS) μετασχηματίζονται εύκολα σε ένα κοινό CRS"),
    req("R5.1",
      tr: "Τα Συστήματα Συντεταγμένων Αναφοράς (CRS) πρέπει να συμμορφώνονται με πρότυπα και πρέπει να παρέχονται πληροφορίες σχετικά με το ποιο πρότυπο (π.χ. EPSG:4326, EPSG:3857) χρησιμοποιείται. Αυτό περιλαμβάνει τον αριθμό EPSG ή τον αριθμό WGS, μαζί με πληροφορίες για οποιαδήποτε παραλλαγή που βασίζεται σε εθνικά συστήματα, όπως το λετονικό LKS-92, ώστε τα δεδομένα να μπορούν να μετασχηματιστούν σε ένα κοινό CRS. (Σημείωση: Εντός της ΕΕ, για τα γεωχωρικά δεδομένα απαιτείται η χρήση μεταδεδομένων συμβατών με την οδηγία INSPIRE, συμπεριλαμβανομένων των μεταδεδομένων που απαιτούνται για την περιγραφή των πληροφοριών CRS.)",
      en: "Coordinate Reference Systems (CRS) shall comply with standards, and information shall be provided regarding which standard (e.g. EPSG:4326, EPSG:3857) is being used. This includes the EPSG number or WGS number, along with information about any variation based on national systems such as the Latvian LKS-92, so that data can be transformed to a common CRS. (Note: Within the EU, for geospatial data it is required to use metadata compliant with the INSPIRE Directive, including the metadata needed to describe the CRS information.)"),
  )

  #spec-link("Πλήρης προδιαγραφή:", "https://mims.oascities.org/geospatial-data")
]
#pagebreak()


