#fit-page("MIM8 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM8",
    title:  "Τι αναφέρει η προδιαγραφή",
    leadin: "Κάθε απαίτηση αυτού του MIM, αυτολεξεί από τα MIMs Plus 9.0: Η προδιαγραφή υπάρχει μόνο στα αγγλικά: το κείμενο στην ελληνική γλώσσα αποτελεί ανεπίσημη μετάφραση από τον συντάκτη αυτού του φυλλαδίου· το αγγλικό πρωτότυπο που ακολουθεί είναι δεσμευτικό.",
    back:   "επιστροφή στον κατάλογο",
  )

  #spec-list(mim: "MIM8",
    capability("C1", "Provide access to datasets used within the LDT, including static, real-time, and simulation data and calculation models",
      tr: "Παροχή πρόσβασης σε σύνολα δεδομένων του LDT, συμπεριλαμβανομένων στατικών, πραγματικού χρόνου και προσομοίωσης"),
    req("R1.1",
      tr: "Το LDT πρέπει να παρέχει πρόσβαση στα αποτελέσματα προσομοιώσεων και στα δεδομένα εισόδου υπολογιστικών μοντέλων, όπου αυτά απαιτούνται ως μέρος των ροών εργασίας του LDT.",
      en: "The LDT shall provide access to simulation outputs and calculation-model inputs where these are needed as part of LDT workflows."),
    req("R1.2",
      tr: "Το LDT πρέπει να διακρίνει με σαφήνεια μεταξύ ανεπεξέργαστων δεδομένων πηγής, μετασχηματισμένων δεδομένων έτοιμων για ροή εργασίας, εισόδων μοντέλου και εξόδων μοντέλου.",
      en: "The LDT should distinguish clearly between raw source data, transformed workflow-ready data, model inputs, and model outputs."),
    capability("C2", "Exchange data with external systems and other LDTs using interoperable interfaces",
      tr: "Ανταλλαγή δεδομένων με εξωτερικά συστήματα και άλλα LDT μέσω διαλειτουργικών διεπαφών"),
    req("C2",
      tr: "Αυτή η ικανότητα βασίζεται στο MIM3 (Ανταλλαγή Δεδομένων) για την ανταλλαγή δεδομένων.",
      en: "This capability relies on MIM3 (Exchanging Data) for data exchange."),
    capability("C3", "Reuse deterministic or AI models across different domains, communities, use cases, and/or LDTs",
      tr: "Επαναχρησιμοποίηση ντετερμινιστικών μοντέλων ή μοντέλων ΤΝ σε διαφορετικούς τομείς, κοινότητες και LDT"),
    req("R3.1",
      tr: "Το μοντέλο πρέπει να παρέχει τυποποιημένα μεταδεδομένα μοντέλου, συμπεριλαμβανομένης περιγραφής των μεθόδων και παραμέτρων του, καθώς και παραμέτρων δεδομένων (είτε κατά τιμή είτε κατ' αναφορά). Για τον σκοπό αυτό πρέπει να χρησιμοποιούνται κοινά πρότυπα μεταδεδομένων.",
      en: "The model should provide standard model metadata, including a description of its methods and parameters, and data-parameters (either by value or by reference). To this end common metadata standards should be used."),
    req("R3.2",
      tr: "Το μοντέλο πρέπει να διαθέτει ή να είναι προσπελάσιμο μέσω τεκμηριωμένης διεπαφής κλήσης, κατά προτίμηση χρησιμοποιώντας ένα γνωστό τυποποιημένο API. Το σύνολο δεδομένων που αποτελεί το αποτέλεσμα του μοντέλου πρέπει να περιγράφεται (σε επίπεδο δεδομένων).",
      en: "The model shall expose or be callable through a documented interface, preferably using a known standardised API. The dataset that forms the outcome of the model shall be described (at data-level)."),
    req("R3.3",
      tr: "Η αξιόπιστη και ηθική χρήση καινοτόμων μεθόδων (LLM, πρακτορική ΤΝ κ.λπ.) πρέπει να διασφαλίζεται. Η μεροληψία πρέπει να ελαχιστοποιείται κατά περίπτωση. Οι μέθοδοι που χρησιμοποιούνται για την εξασφάλιση αυτού πρέπει να περιγράφονται.",
      en: "Trustworthy, reliable, and ethical use of innovative methods (LLMs, agentic AI, etc.) should be safeguarded. Bias should minimised [sic] where applicable. The methods used to guarantee this, should be described."),
    req("R3.4",
      tr: "Το μοντέλο πρέπει να είναι σε θέση να αποκτά πρόσβαση σε δεδομένα εκ μέρους του τελικού χρήστη ή οργανισμού. Βλ. MIM3",
      en: "The model must be able to access data on behalf of the end-user or organisation. See MIM3"),
    req("R3.5",
      tr: "Για τα δεδομένα που θα χρησιμοποιηθούν σε μοντέλα ΤΝ, η προέλευση και η εμπιστοσύνη πρέπει να διασφαλίζονται. Σε ορισμένες περιπτώσεις, μια έγκυρη πηγή, όπως μια κρατική υπηρεσία, πρέπει να αναφέρεται.",
      en: "For data to be used in AI models, provenance and trust should be guaranteed. In some cases, an authoratitive sourc [sic], such as a government agency must be listed."),
    capability("C4", "Coordinate and manage data, models, and processing workflows within an LDT (intra-LDT) and across LDTs (inter-LDT)",
      tr: "Συντονισμός και διαχείριση δεδομένων, μοντέλων και ροών επεξεργασίας εντός ενός LDT και μεταξύ LDT"),
    req("R4.1",
      tr: "Το LDT υποστηρίζει ροές εργασίας που συνδέουν πηγές δεδομένων, μετασχηματισμούς δεδομένων, εκτέλεση μοντέλων, διαδικασίες προσομοίωσης και αποτελέσματα.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "Το LDT συνδέει διαδοχικά τα βήματα της ροής εργασίας, όπου η έξοδος ενός βήματος μπορεί να χρησιμοποιηθεί ως είσοδος για ένα άλλο.",
      en: "The LDT chains workflow steps, where the output of one step can be used as the input for another."),
    req("R4.3",
      tr: "Το LDT παρακολουθεί την κατάσταση εκτέλεσης της ροής εργασίας, συμπεριλαμβανομένων ολοκληρωμένων, αποτυχημένων και διακοπεισών διαδικασιών.",
      en: "The LDT monitors workflow execution status, including completed, failed, and interrupted processes."),
    req("R4.4",
      tr: "Το LDT καταγράφει την προέλευση της ροής εργασίας, συμπεριλαμβανομένων των συνόλων δεδομένων που χρησιμοποιήθηκαν (συμπεριλαμβανομένης της έκδοσης και της χρονοσήμανσης), των μοντέλων που εκτελέστηκαν, των παραμέτρων που επιλέχθηκαν και των αποτελεσμάτων που παρήχθησαν.",
      en: "The LDT records workflow provenance, including datasets used (including version, timestamped), models executed, parameters selected, and outputs generated."),
    capability("C5", "Provide multiple visualisations of data and results (e.g. 2D, 3D, dashboards) from common underlying data and models for interaction and comparison",
      tr: "Παροχή πολλαπλών οπτικοποιήσεων δεδομένων και αποτελεσμάτων (π.χ. 2D, 3D, πίνακες εργαλείων) για αλληλεπίδραση"),
    req("R5.1",
      tr: "Το LDT παρέχει μεταδεδομένα που εξηγούν τι οπτικοποιείται, συμπεριλαμβανομένης χρονοσήμανσης, χωρικού εύρους, πηγής δεδομένων και παραδοχών σεναρίων και παραλλαγών, κατά περίπτωση.",
      en: "The LDT provides metadata explaining what is visualised, including timestamp, spatial scope, data source, and scenario- and variant-assumptions where relevant."),
    req("R5.2",
      tr: "Το LDT υποστηρίζει διαφορετικούς τύπους διαδραστικής οπτικοποίησης, όπως χάρτες 2D, σκηνές 3D, πίνακες εργαλείων, αναφορές ή δημόσιες προβολές.",
      en: "The LDT supports different interactive visualisation types, such as 2D maps, 3D scenes, dashboards, reports, or public-facing views."),
    capability("C6", "Ensure that data exchanged (and simulation outputs) within and between LDTs can be interpreted consistently through shared or mapped semantics and clear provenance",
      tr: "Διασφάλιση συνεπούς ερμηνείας των ανταλλασσόμενων δεδομένων μέσω κοινής σημασιολογίας και σαφούς προέλευσης"),
    req("R6.1",
      tr: "Το LDT πρέπει να τεκμηριώνει ανεπίλυτα σημασιολογικά κενά, υποθέσεις ή αντιστοιχίσεις που μπορεί να επηρεάσουν την ερμηνεία, την επαναχρησιμοποίηση ή τη σύγκριση αποτελεσμάτων.",
      en: "The LDT should document unresolved semantic gaps, assumptions, or mappings that may affect the interpretation, reuse, or comparison of results."),
    capability("M", "Mechanisms (under active development)",
      tr: "Μηχανισμοί (υπό ενεργό ανάπτυξη)"),
    req("M1",
      tr: "Πρόσβαση σε Πόρους LDT βάσει API",
      en: "API-based LDT Resource Access"),
    req("M2",
      tr: "Τυποποιημένοι Μορφότυποι Δεδομένων και Αποτελεσμάτων",
      en: "Standardised Data and Output Formats"),
    req("M3",
      tr: "Μοντέλο ως Υπηρεσία (Model-as-a-Service)",
      en: "Model-as-a-Service"),
    req("M4",
      tr: "Ενορχήστρωση Ροών Εργασίας LDT",
      en: "LDT Workflow Orchestration"),
    req("M5",
      tr: "Πρόσβαση σε Αποτελέσματα και Οπτικοποιήσεις Πολλαπλών Προβολών",
      en: "Multi-view Output and Visualisation Access"),
  )

  #spec-link("Πλήρης προδιαγραφή:", "https://mims.oascities.org/local-digital-twins")
]
