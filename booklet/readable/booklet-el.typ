    intro:    "Ένα ψηφιακό δίδυμο αποτελεί μακροπρόθεσμη επένδυση: δεδομένα, τρισδιάστατα μοντέλα, προσομοιώσεις, αποφάσεις. Το MIM8 προστατεύει αυτή την επένδυση — τα δεδομένα και τα μοντέλα του διδύμου παραμένουν προσβάσιμα και τεκμηριωμένα, τα αποτελέσματα μπορούν να αναπαραχθούν και τα συστατικά στοιχεία από ένα έργο μπορούν να εξυπηρετήσουν το επόμενο. Χρησιμοποιήστε αυτή τη σελίδα κατά την προμήθεια πλατφορμών διδύμων, μοντέλων προσομοίωσης ή εργαλείων 3D πόλεων.",
    list:     "Κατάλογος ελέγχου",
  )

  #item("Τα σύνολα δεδομένων, οι είσοδοι μοντέλων και οι έξοδοι προσομοίωσης είναι προσβάσιμα μέσω API (σύμφωνα με το MIM0) και δεν παραμένουν παγιδευμένα στο δίδυμο.",
    why:  "Τα αποτελέσματα τροφοδοτούν αναφορές, πίνακες οργάνων και το επόμενο έργο.",
    refs: "MIM8 R1.1",
    num:  "8.1")

  #item("Τα μοντέλα είναι τεκμηριωμένα (μέθοδος, παράμετροι, είσοδοι/έξοδοι) και προσπελάσιμα μέσω τεκμηριωμένης διεπαφής.",
    why:  "Ένα μοντέλο πλημμύρας που αγοράστηκε μία φορά μπορεί να επαναχρησιμοποιηθεί από διάφορες υπηρεσίες — και από άλλες πόλεις.",
    refs: "MIM8 R3.1, R3.2",
    num:  "8.2")

  #item("Τα αποτελέσματα χρησιμοποιούν τυποποιημένους μορφοτύπους (GeoJSON, CityJSON, 3D Tiles, NetCDF…) αναγνώσιμους από εργαλεία τρίτων.",
    why:  "Η οπτικοποίηση και η ανάλυση παραμένουν ανταγωνιστικές αγορές.",
    refs: "MIM8 M2",
    num:  "8.3")

  #item("Οι ροές εργασίας καταγράφουν την προέλευση: ποια έκδοση δεδομένων, ποιο μοντέλο και ποιες παράμετροι παρήγαγαν ένα αποτέλεσμα.",
    why:  "Οι αποφάσεις που βασίζονται στο δίδυμο μπορούν να εξηγηθούν και να τεκμηριωθούν εκ των υστέρων.",
    refs: "MIM8 R4.4",
    num:  "8.4")

  #panels(
    why:   ("Γιατί έχει σημασία", (
      "Το δίδυμο επιβιώνει από κάθε μεμονωμένο προμηθευτή ή προϋπολογισμό έργου.",
      "Οι προσομοιώσεις μπορούν να ελεγχθούν, να επαναληφθούν και να δικαιολογηθούν κατά τη λήψη δημοτικών αποφάσεων.",
      "Μοντέλα και συστατικά στοιχεία μπορούν να διαμοιραστούν μεταξύ πόλεων.",
    )),
    flags: ("Ενδείξεις κινδύνου", (
      "Αποτελέσματα προσομοίωσης ορατά μόνο στην πύλη του προμηθευτή.",
      "Μοντέλα ως ερμητικά κλειστά «μαύρα κουτιά» χωρίς μεταδεδομένα.",
    )),
  )
]
