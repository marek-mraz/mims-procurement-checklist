    req("RC7.2",
      tr: "Andmepakkujad peaksid saama kätte andmekasutajate taotlusi uute andmevarade järele.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Täielik spetsifikatsioon:", "https://mims.oascities.org/exchanging-data")
