//  MIM3 · RIGHT PAGE · WHAT THE SPECIFICATION SAYS
// ════════════════════════════════════════════════════════════════════════════
#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Mida spetsifikatsioon ütleb",
    leadin: "Selle MIMi iga nõue sõna-sõnalt standardist MIMs Plus 9.0: Spetsifikatsioon on koostatud ainult inglise keeles: eestikeelne tekst on käesoleva teatmiku autori mitteametlik tõlge; selle all olev ingliskeelne originaal on siduv.",
    back:   "tagasi kontroll-lehele",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Andmejagamise ökosüsteemi haldusreegleid saab määratleda"),
    req("RC1.1",
      tr: "Andmeökosüsteemi koordineerija peaks saama määratleda haldusmudeli (nt reeglistiku), mis kirjeldab liikmelisuse reegleid, ökosüsteemis osalejate rolle, kohustusi ja vastutust ning nende vahelist andmevahetust reguleerivaid üldpõhimõtteid.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Andmeökosüsteemis osalevad liikmed peaksid olema teadlikud selle haldusmudelist ja kõigist sellesse tehtud muudatustest.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Haldusmudel peaks olema kõigile ökosüsteemis osalejatele hõlpsasti mõistetav.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Andmejagamise tingimusi saab määratleda"),
    req("RC2.1",
      tr: "Andmepakkujad võivad vabalt määrata tingimused, mille alusel nad soovivad oma andmeid vahetada. (Märkus: enne andmevarade jagamist peaksid andmepakkujad veenduma, et neil on andmete omanikelt piisav luba.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Andmevahetuse tingimused peaksid olema kirjeldatud selgelt ja ühemõtteliselt, nii et need oleksid andmekasutajatele kergesti mõistetavad.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Andmevahetuse tingimused peaksid olema väljendatud andmelitsentside või andmejagamislepingute kaudu, mis põhinevad hästi määratletud mallidel või standarditel.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Tingimused peaksid olema kooskõlas andmeökosüsteemi üldise haldusmudeliga ega tohi olla sellega vastuolus. (Märkus: andmepakkuja võib otsustada andmeökosüsteemis mitte osaleda, kui aluseks olev haldusmudel on liiga piirav või liiga lubav.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Andmejagamise tingimustele vastavust saab kontrollida"),
    req("RC3.1",
      tr: "Andmeökosüsteemi koordineerija peab suutma veenduda selles osalejate vastavuses aluseks olevale haldusmudelile.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Andmepakkujad peaksid suutma veenduda, et andmekasutaja andmekasutus vastab eelnevalt kokkulepitud tingimustele.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Andmekasutajad peaksid suutma veenduda, et andmepakkuja andmete edastamine järgib eelnevalt kokkulepitud tingimusi.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Saadaolevaid andmevarasid saab avastada"),
    req("RC4.1",
      tr: "Andmekasutajad peaksid saama ilma eelneva teadmiseta avastada, millised andmed on andmejagamise ökosüsteemis saadaval.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Andmevarad peaksid olema piisavalt kirjeldatud metaandmetega, et andmekasutajad saaksid teha usaldusväärseid otsuseid nende edasise kavandatud kasutuse kohta.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Andmevarade kirjeldamiseks kasutatavad metaandmed peaksid põhinema hästi määratletud, kergesti mõistetavatel kirjeldusvormingutel, mis on nii inimesele kui ka masinale loetavad.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Ökosüsteemis osalejaid saab avastada"),
    req("RC5.1",
      tr: "Ökosüsteemis osalejad (nt andmekasutajad ja -pakkujad) peaksid suutma andmejagamise ökosüsteemis üksteist leida.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Iga ökosüsteemis osaleja kohta peaks olema kättesaadav piisavalt metaandmeid, et teha kindlaks nende andmevahetuseks vajalik usaldusväärsus.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Andmepakkujad peaksid suutma usaldusväärselt tuvastada andmekasutajaid, kes soovivad nende andmevaradele ligi pääseda, ning kontrollida nende metaandmeid enne juurdepääsu andmist.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Andmekasutajad peaksid suutma tuvastada andmepakkujaid, kes andmeökosüsteemis andmeid jagavad, enne nende andmete kasutamist või neile juurdepääsu.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Ökosüsteemis osalejad võivad otsustada jääda ka anonüümseks, kui andmejagamise ökosüsteemi haldusmudel seda võimaldab. Sel juhul võib punkte RC5.1 kuni RC5.4 eirata.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Andmevahetuses saab kokku leppida"),
    req("RC6.1",
      tr: "Andmekasutajad ja -pakkujad peaksid saama leppida kokku andmevahetuses ja sellega seotud tingimustes (nt tingimustega nõustumine, lepingu allkirjastamine või läbirääkimised).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
