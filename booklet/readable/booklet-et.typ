  #item("Identifikaatorid ei sisalda tarnija sisemisi tunnuseid (andmebaasi reaindeksid, serverinimed).",
    why:  "Vastasel juhul kaovad identifikaatorid koos lepinguga.",
    refs: "MIM1 M1 §3.1",
    num:  "1.4")

  #panels(
    why:   ("Miks see on oluline", (
      "Kümne aasta mõõtmistulemused jäävad seotuks õige valgustipostiga.",
      "Ametid ei pea enam samade varade kohta viit vasturääkivat registrit.",
      "Andmestike sidumine muutub lihtsaks päringuks, mitte konsultatsiooniprojektiks.",
