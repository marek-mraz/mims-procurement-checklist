      tr: "Dane są dostępne wyłącznie dla użytkowników, którzy powinni posiadać do nich dostęp"),
    req("R1.1",
      tr: "Zasady kontroli dostępu fizycznego i logicznego do informacji oraz powiązanych z nimi innych aktywów MAJĄ OBOWIĄZEK zostać ustalone i wdrożone w oparciu o wymagania biznesowe i bezpieczeństwa informacji. (ISO 27001 5.15 Kontrola dostępu)",
      en: "Rules to control physical and logical access to information and other associated assets SHALL be established and implemented based on business and information security requirements. (ISO 27001 5.15 Access control)"),
    req("R1.2",
      tr: "Przydzielanie informacji uwierzytelniających i zarządzanie nimi MA OBOWIĄZEK podlegać procedurze zarządczej, w tym instruowaniu personelu w zakresie właściwego obchodzenia się z informacjami uwierzytelniającymi. (ISO 27001 5.17 Informacje uwierzytelniające)",
      en: "Allocation and management of authentication information SHALL be controlled by a management process, including advising personnel on appropriate handling of authentication information. (ISO 27001 5.17: Authentication information)"),
    req("R1.3",
      tr: "Prawa dostępu do informacji oraz powiązanych z nimi innych aktywów MAJĄ OBOWIĄZEK być przydzielane, weryfikowane, modyfikowane i odbierane zgodnie z polityką i zasadami kontroli dostępu właściwymi dla danej organizacji. (ISO 27001 5.18 Prawa dostępu)",
      en: "Access rights to information and other associated assets SHALL be provisioned, reviewed, modified and removed in accordance with the organization’s topic-specific policy on and rules for access control. (ISO 27001 5.18: Access rights)"),
    capability("C2", "Data accessed by users has not been altered",
      tr: "Dane, do których uzyskują dostęp użytkownicy, nie zostały zmienione"),
    req("R2.1",
      tr: "Zasady efektywnego wykorzystania kryptografii, w tym zarządzania kluczami kryptograficznymi, MAJĄ OBOWIĄZEK zostać zdefiniowane i wdrożone. (ISO 27001 8.24 Wykorzystanie kryptografii)",
      en: "Rules for the effective use of cryptography, including cryptographic key management, SHALL be defined and implemented. (ISO 27001 8.24 Use of cryptography)"),
    capability("C3", "Data accessed by users originates from a verified source",
      tr: "Dane, do których dostęp uzyskują użytkownicy, pochodzą ze zweryfikowanego źródła"),
    req("R3.1",
      tr: "Bezpieczne technologie i procedury uwierzytelniania muszą zostać wdrożone w oparciu o ograniczenia dostępu do informacji oraz szczegółową politykę kontroli dostępu. (ISO 27001 8.5 Bezpieczne uwierzytelnianie)",
      en: "Secure authentication technologies and procedures shall be implemented based on information access restrictions and the topic-specific policy on access control. (ISO 27001 8.5 Secure authentication)"),
    capability("M1", "Mechanism candidate",
      tr: "Kandydat na mechanizm"),
    req("M1.1",
      tr: "Protokół Transport Layer Security (TLS), wersja 1.3",
      en: "The Transport Layer Security (TLS) Protocol, Version 1.3"),
    req("M1.2",
      tr: "Struktura autoryzacji OAuth 2.0 (The OAuth 2.0 Authorization Framework)",
      en: "The OAuth 2.0 Authorization Framework"),
    req("M1.3",
      tr: "OpenID Connect 1.0, warstwa tożsamości do uwierzytelniania w oparciu o protokół OAuth 2.0",
      en: "OpenID Connect 1.0, Identity layer for authentication on OAuth 2.0"),
    req("M1.4",
      tr: "OIDC4VCI / OIDC4VP, specyfikacja OpenID służąca do wydawania i prezentacji weryfikowalnych poświadczeń",
      en: "OIDC4VCI / OIDC4VP, OpenID for Verifiable Credential Issuance and Presentations"),
    capability("P", "Pre- and Post-requisites (based on ISO 27001 Annex A): the control this booklet refers to",
      tr: "Wymagania wstępne i następcze (w oparciu o Załącznik A do ISO 27001): środek bezpieczeństwa, do którego odwołuje się niniejszy poradnik"),
    req("8.15",
      tr: "Rejestrowanie zdarzeń. Dzienniki rejestrujące aktywność, wyjątki, usterki i inne istotne zdarzenia muszą być generowane, przechowywane, chronione i poddawane analizie.",
      en: "Logging. Logs that record activities, exceptions, faults and other relevant events shall be produced, stored, protected and analysed."),
  )

  #spec-link("Pełna treść specyfikacji:", "https://mims.oascities.org/securing-data")
]
