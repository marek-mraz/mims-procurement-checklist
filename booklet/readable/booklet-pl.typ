    req("R4.1",
      tr: "Cyfrowy bliźniak (LDT) obsługuje przepływy pracy (workflows) łączące źródła danych, przekształcenia danych, wykonywanie modeli, procesy symulacji oraz dane wynikowe.",
      en: "The LDT supports workflows that connect data sources, data transformations, model execution, simulation processes, and outputs."),
    req("R4.2",
      tr: "Cyfrowy bliźniak (LDT) łączy kroki przepływu pracy w łańcuchy, w których wynik jednego kroku może zostać wykorzystany jako dane wejściowe dla innego.",
      en: "The LDT chains workflow steps, where the output of one step can be used as the input for another."),
    req("R4.3",
