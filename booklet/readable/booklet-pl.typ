      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Uczestnicy biorący udział w ekosystemie danych powinni znać jego model zarządzania oraz wszelkie wprowadzane w nim zmiany.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Model zarządzania powinien być łatwo zrozumiały dla wszystkich uczestników ekosystemu.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Istnieje możliwość definiowania warunków wymiany danych"),
    req("RC2.1",
      tr: "Dostawcy danych mają swobodę definiowania warunków, na jakich chcą wymieniać swoje dane. (Uwaga: Przed udostępnieniem zasobów danych dostawcy danych powinni upewnić się, że posiadają odpowiednie uprawnienia od właścicieli danych).",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Warunki wymiany danych powinny być opisane w sposób jasny i jednoznaczny, tak aby były łatwo zrozumiałe dla użytkowników danych.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Warunki wymiany danych powinny być wyrażone za pomocą licencji na dane lub umów o współdzieleniu danych, opracowanych w oparciu o precyzyjnie zdefiniowane szablony lub standardy.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Warunki powinny być zgodne z ogólnym modelem zarządzania ekosystemem danych i nie mogą być z nim sprzeczne. (Uwaga: Dostawca danych może zdecydować o rezygnacji z udziału w ekosystemie danych, jeżeli leżący u jego podstaw model zarządzania jest zbyt restrykcyjny lub zbyt liberalny).",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Zgodność z warunkami wymiany danych może podlegać weryfikacji"),
    req("RC3.1",
      tr: "Koordynator ekosystemu danych musi mieć możliwość weryfikacji zgodności działań jego uczestników z obowiązującym modelem zarządzania.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Dostawcy danych powinni mieć możliwość upewnienia się, że wykorzystanie danych przez użytkownika danych jest zgodne z uprzednio uzgodnionymi warunkami.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Użytkownicy danych powinni mieć możliwość upewnienia się, że dostarczanie danych przez dostawcę danych odbywa się zgodnie z uprzednio uzgodnionymi warunkami.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Dostępne zasoby danych mogą być wyszukiwane i odkrywane"),
    req("RC4.1",
      tr: "Użytkownicy danych powinni mieć możliwość sprawdzenia, jakie dane są dostępne w ekosystemie wymiany danych, bez konieczności posiadania wcześniejszej wiedzy na ten temat.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Zasoby danych powinny być odpowiednio opisane metadanymi, aby użytkownicy danych mogli podejmować wiarygodne decyzje dotyczące ich dalszego, zamierzonego wykorzystania.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Metadane stosowane do opisu zasobów danych powinny opierać się na precyzyjnie zdefiniowanych, łatwych do zrozumienia formatach opisów, które są czytelne zarówno dla człowieka, jak i maszynowo.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Uczestnicy ekosystemu mogą być wyszukiwani i identyfikowani"),
    req("RC5.1",
      tr: "Uczestnicy ekosystemu (np. użytkownicy i dostawcy danych) powinni mieć możliwość wzajemnego wyszukiwania się w ramach ekosystemu wymiany danych.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "W odniesieniu do każdego uczestnika ekosystemu powinny być dostępne wystarczające metadane, aby możliwe było ustalenie jego wiarygodności istotnej z punktu widzenia wymiany danych.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Dostawcy danych powinni mieć możliwość niezawodnej identyfikacji użytkowników danych pragnących uzyskać dostęp do ich zasobów danych oraz weryfikacji ich metadanych przed udzieleniem dostępu.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Użytkownicy danych powinni mieć możliwość identyfikacji dostawców danych udostępniających dane w ekosystemie danych przed uzyskaniem dostępu do tych danych lub ich wykorzystaniem.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Uczestnicy ekosystemu mogą również zdecydować się na zachowanie anonimowości, o ile pozwala na to model zarządzania ekosystemem wymiany danych. W takim przypadku wymagania od RC5.1 do RC5.4 można pominąć.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Wymiana danych może zostać uzgodniona"),
    req("RC6.1",
      tr: "Użytkownicy i dostawcy danych powinni mieć możliwość wyrażenia zgody na wymianę danych oraz na powiązane z nią warunki (np. poprzez akceptację regulaminu, złożenie prawnie wiążącego podpisu pod umową lub w drodze negocjacji).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Użytkownicy i dostawcy danych powinni mieć możliwość zakończenia uprzednio uzgodnionej wymiany danych zgodnie z warunkami z nią powiązanymi.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "W miarę możliwości można zapewnić środki elektroniczne służące do zawierania porozumień i kończenia wymiany danych.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Można wnioskować o udostępnienie nowych danych, które są obecnie niedostępne"),
    req("RC7.1",
      tr: "Użytkownicy danych powinni mieć możliwość zgłaszania zapotrzebowania na zasoby danych, które są obecnie niedostępne w ekosystemie wymiany danych.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Dostawcy danych powinni mieć możliwość odbierania zapytań składanych przez użytkowników danych o nowe zasoby danych.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Pełna treść specyfikacji:", "https://mims.oascities.org/exchanging-data")
]
#pagebreak()


