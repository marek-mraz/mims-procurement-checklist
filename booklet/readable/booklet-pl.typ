  #spec-list(mim: "MIM7",
    capability("C1", "Cities and communities can easily transfer geospatial data between internal and external (including IoT-related) IT systems",
      tr: "Miasta i społeczności mogą z łatwością przesyłać dane geoprzestrzenne pomiędzy wewnętrznymi i zewnętrznymi systemami IT (w tym systemami IoT)"),
    req("R1.1",
      tr: "Dane geoprzestrzenne muszą być udostępniane za pośrednictwem interfejsu usługi sieciowej opartego na standardach.",
      en: "Geospatial data shall be exposed through a standards-based web service interface."),
    capability("C2", "Cities and communities can integrate 2D and 3D geospatial data coming from a variety of sources, for example geodata and building information models, and share that data within and between them in an interoperable way",
      tr: "Miasta i społeczności mogą integrować dwuwymiarowe (2D) i trójwymiarowe (3D) dane geoprzestrzenne pochodzące z różnych źródeł, np. geodane i modele informacji o budynku (BIM), oraz wymieniać je w sposób interoperacyjny w ramach własnych struktur i między sobą"),
    req("R2.1",
