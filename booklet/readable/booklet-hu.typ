#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "Mit ír elő a specifikáció",
    leadin: "A jelen MIM valamennyi követelménye, szó szerint a MIMs Plus 9.0-ból: A specifikáció kizárólag angol nyelven létezik: a magyar szöveg a jelen füzet szerzőjének nem hivatalos fordítása; az alatta lévő angol eredeti az irányadó.",
    back:   "vissza a listához",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Az adatforrásokban szereplő összes entitás konzisztens adatmodellekkel van leírva az alkalmazások és rendszerek együttműködésének lehetővé tétele érdekében"),
    req("R1.1",
      tr: "Bármely adatforrásban minden entitás esetében használt adatmodellt kifejezetté kell tenni. Ezeknek jól dokumentáltnak kell lenniük, és leíró metaadatokkal kell rendelkezniük, ahol a használt kifejezések szemantikailag egyértelműek. A mértékegységekhez, időformátumokhoz stb. kapcsolódó attribútumok esetében a használt egységeket, formátumokat stb. kifejezetté kell tenni. Az adatmodelleket ajánlott katalogizálni, hogy könnyen megtalálhatók legyenek.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "A használt adatmodelleknek (ahol csak lehetséges) az alább felsorolt, általánosan elfogadott szabványosított adatmodelleken kell alapulniuk",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Ahol nem lehetséges meglévő szabványosított adatmodellek használata, erőfeszítéseket kell tenni a leginkább illeszkedő meglévő szabványosított adatmodellek kiterjesztésére vagy újak meghatározására, követve az adatmodelleket meghatározó közösség vagy szervezet bevált gyakorlatát és konvencióit.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "A használt adatmodelleknek támogatniuk kell az adatcserét az adathozzáférésről és az adatok összekapcsolásáról szóló MIM-ek releváns követelményeinek alkalmazásával",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Ugyanazon entitásnak a közös adatmegosztási ökoszisztémában használt különböző adatmodelljei ajánlott, hogy könnyen átalakíthatók legyenek egy közös adatmodellre"),
    req("R2.1",
      tr: "Minden adat-ökoszisztéma számára ajánlott egy közös adatmodellt kidolgozni az egyes kulcsfontosságú entitásokhoz. Ennek a közös adatmodellnek ajánlott tartalmaznia mindazokat a mezőket, amelyek az adott adat-ökoszisztémán belül az adott entitáshoz használt különböző adatmodellekben szerepelnek. Az adott adat-ökoszisztémán belül használt minden egyes eltérő adatmodell ezután átalakítható a közös adatmodellre.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Bármely adat és a hozzá kapcsolódó metaadat megosztható nyílt, szabványosított adattovábbítási formátumokban, így az adatok konzisztensen cserélhetők és értelmezhetők a különböző eszközök és megvalósítások által"),
    req("R3.1",
      tr: "Minden használt adatmodellnek rendelkeznie kell legalább egy meghatározott, géppel olvasható adattovábbítási formátummal („szerializációval”), amely nyílt, nyilvánosan elérhető és megvalósítás-független.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "Az adattovábbítási formátum dokumentációjának elégségesnek kell lennie ahhoz, hogy lehetővé tegye egy olyan nem zárt forráskódú alkalmazás vagy értelmező létrehozását, amely képes az ilyen adatformátumban tárolt összes adat rekonstruálására.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Ahol ugyanazon adatmodellhez több adattovábbítási formátum támogatott, azoknak ugyanazt az információtartalmat kell képviselniük, következetesen és jelentésvesztés nélkül.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "A reprezentációnak ajánlott támogatnia a nyíltan közzétett sémák, nyelvtanok vagy egyenértékű, géppel olvasható megkötések használatával történő érvényesítést, amennyiben léteznek ilyen érvényesítési mechanizmusok a választott formátumhoz.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "Indokolt esetben ajánlott lehetővé tenni „alkalmazásprofilok” létrehozását egy adatmodellhez, hogy használatieset-specifikus attribútumok hozzáadhatók vagy megadhatók legyenek az alapul szolgáló adatmodell módosítása nélkül"),
    req("R4.1",
      tr: "Az adatmodellt kiterjesztő alkalmazásprofiloknak ajánlott nem érinteniük a már meglévő modellt és annak felhasználóit",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "A modell alkalmazásprofiljában bevezetett specializációkat vagy kiterjesztéseket ajánlott jól dokumentálni, az alap adatmodelltől elkülönítve",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("A teljes specifikáció:", "https://mims.oascities.org/representing-data")
]
#pagebreak()


