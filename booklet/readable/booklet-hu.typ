      tr: "Az adateszközök leírására használt metaadatoknak ajánlott jól meghatározott, könnyen érthető leíró formátumokon alapulniuk, amelyek ember és gép számára egyaránt olvashatók.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Az ökoszisztéma résztvevői felfedezhetők"),
    req("RC5.1",
      tr: "Az ökoszisztéma résztvevőinek (pl. adatfelhasználóknak és -szolgáltatóknak) ajánlott képesnek lenniük felfedezni egymást az adatmegosztási ökoszisztémán belül.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Elegendő metaadatnak ajánlott rendelkezésre állnia az egyes ökoszisztéma-résztvevőkről az adatcsere szempontjából releváns megbízhatóságuk megállapításához.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Az adatszolgáltatóknak ajánlott képesnek lenniük megbízhatóan azonosítani azokat az adatfelhasználókat, akik hozzá kívánnak férni az adateszközeikhez, és ellenőrizni a metaadataikat a hozzáférés megadása előtt.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Az adatfelhasználóknak ajánlott képesnek lenniük azonosítani az adatokat megosztó adatszolgáltatókat egy adat-ökoszisztémában, mielőtt hozzáférnének az adatokhoz vagy felhasználnák azokat.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
