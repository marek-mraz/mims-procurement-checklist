#fit-page("MIM7 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM7",
    title:  "Ką sako specifikacija",
    leadin: "Kiekvienas šio MIM reikalavimas, pažodžiui iš MIMs Plus 9.0: Specifikacija egzistuoja tik anglų kalba: tekstas lietuvių kalba yra neoficialus šio leidinio autoriaus vertimas; privalomas yra po juo esantis originalas anglų kalba.",
    back:   "atgal į kontrolinį sąrašą",
