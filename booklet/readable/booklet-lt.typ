    req("RC3.1",
      tr: "Duomenų ekosistemos koordinatorius privalo gebėti įsitikinti, kad jos dalyviai laikosi taikomo valdymo modelio.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Duomenų teikėjai turėtų gebėti įsitikinti, kad duomenų naudotojas duomenis naudoja laikydamasis anksčiau suderėtų sąlygų.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Duomenų naudotojai turėtų gebėti įsitikinti, kad duomenų teikėjas duomenis teikia laikydamasis anksčiau suderėtų sąlygų.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Galima atrasti prieinamus duomenų išteklius"),
    req("RC4.1",
      tr: "Duomenų naudotojai turėtų gebėti sužinoti, kokie duomenys yra prieinami duomenų dalijimosi ekosistemoje, neturėdami išankstinių žinių apie tai.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Duomenų ištekliai turėtų būti tinkamai aprašyti metaduomenimis, kad duomenų naudotojai galėtų priimti patikimus sprendimus dėl jų tolesnio numatomo naudojimo.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Duomenų ištekliams aprašyti naudojami metaduomenys turėtų būti pagrįsti aiškiai apibrėžtais, lengvai suprantamais aprašo formatais, kurie yra skaitomi ir žmogui, ir mašinai.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Galima atrasti ekosistemos dalyvius"),
    req("RC5.1",
      tr: "Ekosistemos dalyviai (pvz., duomenų naudotojai ir teikėjai) turėtų gebėti rasti vieni kitus duomenų dalijimosi ekosistemoje.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Apie kiekvieną ekosistemos dalyvį turėtų būti prieinami pakankami metaduomenys, kad būtų galima įsitikinti jo patikimumu, svarbiu duomenų mainams.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Duomenų teikėjai turėtų gebėti patikimai identifikuoti duomenų naudotojus, norinčius pasiekti jų duomenų išteklius, ir patikrinti jų metaduomenis prieš suteikdami prieigą.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Duomenų naudotojai turėtų gebėti identifikuoti duomenų teikėjus, kurie dalijasi duomenimis duomenų ekosistemoje, prieš pasiekdami ar naudodami tuos duomenis.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Ekosistemos dalyviai taip pat gali pasirinkti likti anonimiški, jei duomenų dalijimosi ekosistemos valdymo modelis tai leidžia. Tokiu atveju reikalavimų nuo RC5.1 iki RC5.4 galima nepaisyti.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Galima susitarti dėl duomenų mainų"),
    req("RC6.1",
      tr: "Duomenų naudotojai ir teikėjai turėtų gebėti susitarti dėl duomenų mainų ir su jais susijusių sąlygų (pvz., sąlygų priėmimo, teisinio sutarties pasirašymo ar derybų).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Duomenų naudotojai ir teikėjai turėtų gebėti nutraukti anksčiau suderėtus duomenų mainus pagal su jais susijusias sąlygas.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
      tr: "Kur įmanoma, gali būti suteiktos elektroninės priemonės duomenų mainų susitarimui sudaryti ir nutraukti.",
      en: "Where possible, electronic means for the agreement and termination of a data exchange may be provided."),
    capability("C7", "New data currently not available can be requested",
      tr: "Galima pateikti užklausą dėl naujų šiuo metu neprieinamų duomenų"),
    req("RC7.1",
      tr: "Duomenų naudotojai turėtų gebėti išreikšti savo suinteresuotumą duomenų ištekliais, kurie šiuo metu duomenų dalijimosi ekosistemoje neprieinami.",
      en: "Data users should be able to express their interest in data assets currently unavailable in the data sharing ecosystem."),
    req("RC7.2",
      tr: "Duomenų teikėjai turėtų gebėti gauti duomenų naudotojų užklausas dėl naujų duomenų išteklių.",
      en: "Data providers should be able to obtain requests made by data users for new data assets."),
  )

  #spec-link("Visa specifikacija:", "https://mims.oascities.org/exchanging-data")
]
