#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Ce prevede specificația",
    leadin: "Fiecare cerință a acestui MIM, reprodusă fidel din MIMs Plus 9.0: Specificația există doar în limba engleză: versiunea în limba română este o traducere neoficială realizată de autorul acestui ghid; textul original în limba engleză de sub aceasta este cel autentic.",
    back:   "înapoi la listă",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Regulile de guvernanță pentru ecosistemul de partajare a datelor pot fi definite"),
    req("RC1.1",
      tr: "Orchestratorul unui ecosistem de date ar trebui să poată defini un model de guvernanță (de exemplu un regulament) care conturează regulile de membru, rolurile, responsabilitățile și obligațiile participanților la ecosistem, precum și principiile generale care guvernează schimbul de date între aceștia.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Membrii care participă la un ecosistem de date ar trebui să cunoască modelul de guvernanță al acestuia și orice modificări aduse acestuia.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Modelul de guvernanță ar trebui să fie ușor de înțeles de către toți participanții la ecosistem.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Termenii și condițiile pentru partajarea datelor pot fi definiți"),
    req("RC2.1",
      tr: "Furnizorii de date sunt liberi să definească termenii și condițiile în care doresc să fie realizat schimbul datelor lor. (Notă: Înainte de a partaja resurse de date, furnizorii de date ar trebui să se asigure că dețin permisiunea adecvată din partea proprietarilor de date.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Termenii și condițiile pentru un schimb de date ar trebui să fie descrise clar și fără ambiguitate, astfel încât să fie ușor de înțeles pentru utilizatorii de date.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Termenii și condițiile pentru un schimb de date ar trebui exprimate prin licențe de date sau acorduri de partajare a datelor bazate pe modele sau standarde bine definite.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Termenii și condițiile ar trebui să fie în conformitate cu modelul general de guvernanță al ecosistemului de date și nu trebuie să intre în conflict cu acesta. (Notă: Un furnizor de date poate decide să nu participe la un ecosistem de date dacă modelul de guvernanță subiacent este prea restrictiv sau prea permisiv.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Conformitatea cu termenii și condițiile de partajare a datelor poate fi validată"),
    req("RC3.1",
      tr: "Orchestratorul unui ecosistem de date trebuie să poată verifica conformitatea participanților săi cu modelul de guvernanță subiacent.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Furnizorii de date ar trebui să poată verifica dacă utilizarea datelor de către un utilizator de date respectă termenii și condițiile convenite anterior.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Utilizatorii de date ar trebui să poată verifica dacă furnizarea datelor de către furnizorul de date respectă termenii și condițiile convenite anterior.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Resursele de date disponibile pot fi descoperite"),
    req("RC4.1",
      tr: "Utilizatorii de date ar trebui să poată descoperi ce date sunt disponibile într-un ecosistem de partajare a datelor fără a avea cunoștințe prealabile despre acesta.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Resursele de date ar trebui să fie descrise adecvat cu metadate, astfel încât utilizatorii de date să poată lua decizii fiabile cu privire la utilizarea lor preconizată ulterioară.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
      tr: "Metadatele utilizate pentru a descrie resursele de date ar trebui să se bazeze pe formate de descriere bine definite și ușor de înțeles, care sunt atât lizibile pentru om, cât și prelucrabile automat.",
      en: "Metadata used to describe data assets should be based on well-defined, easy-to-understand description formats that are both human- and machine-readable."),
    capability("C5", "Ecosystem participants can be discovered",
      tr: "Participanții la ecosistem pot fi descoperiți"),
    req("RC5.1",
      tr: "Participanții la ecosistem (de exemplu utilizatorii și furnizorii de date) ar trebui să se poată descoperi reciproc în cadrul unui ecosistem de partajare a datelor.",
      en: "Ecosystem participants (e.g. data users and providers) should be able to discover each other within a data-sharing ecosystem."),
    req("RC5.2",
      tr: "Ar trebui să fie disponibile metadate suficiente despre fiecare participant la ecosistem pentru a constata nivelul de încredere relevant pentru schimbul de date.",
      en: "Sufficient metadata about each ecosystem participant should be available to ascertain their trustworthiness relevant for data exchange."),
    req("RC5.3",
      tr: "Furnizorii de date ar trebui să poată identifica în mod fiabil utilizatorii de date care doresc să le acceseze resursele de date și să le verifice metadatele înainte de a acorda accesul.",
      en: "Data providers should be able to reliably identify data users who want to access their data assets and verify their metadata before granting access."),
    req("RC5.4",
      tr: "Utilizatorii de date ar trebui să poată identifica furnizorii de date care partajează date într-un ecosistem de date înainte de a accesa sau utiliza acele date.",
      en: "Data users should be able to identify data providers who share data in a data ecosystem before accessing or using that data."),
    req("RC5.5",
      tr: "Participanții la ecosistem pot de asemenea să aleagă să rămână anonimi dacă modelul de guvernanță al ecosistemului de partajare a datelor permite acest lucru. În acest caz, RC5.1 până la RC5.4 pot fi ignorate.",
      en: "Ecosystem participants may also choose to remain anonymous if the governance model of the data-sharing ecosystem allows for it. In this case, RC5.1 to RC5.4 can be ignored."),
    capability("C6", "Data exchange can be agreed upon",
      tr: "Schimbul de date poate fi convenit"),
    req("RC6.1",
      tr: "Utilizatorii și furnizorii de date ar trebui să poată conveni asupra unui schimb de date și a termenilor și condițiilor asociate acestuia (de exemplu acceptarea termenilor, semnarea juridică a unui acord sau negocierea).",
      en: "Data users and providers should be able to agree to a data exchange and the terms and conditions associated with it (e.g. acceptance of terms, legal signature of an agreement, or negotiation)."),
    req("RC6.2",
      tr: "Utilizatorii și furnizorii de date ar trebui să poată înceta un schimb de date convenit anterior, în conformitate cu termenii și condițiile asociate acestuia.",
      en: "Data users and providers should be able to terminate a previously agreed-upon data exchange in accordance with the terms and conditions associated with it."),
    req("RC6.3",
