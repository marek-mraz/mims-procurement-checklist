#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Što propisuje specifikacija",
    leadin: "Svaki zahtjev ovog MIM-a, doslovno iz specifikacije MIMs Plus 9.0: Specifikacija postoji samo na engleskom jeziku: tekst na hrvatskom jeziku neslužbeni je prijevod autora ove knjižice; engleski izvornik ispod njega je mjerodavan.",
    back:   "natrag na popis",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Mogu se definirati pravila upravljanja za ekosustav dijeljenja podataka"),
    req("RC1.1",
      tr: "Orkestrator podatkovnog ekosustava trebao bi moći definirati model upravljanja (npr. pravilnik) koji ocrtava pravila članstva, uloge, odgovornosti i obveze sudionika ekosustava te opća načela koja uređuju razmjenu podataka među njima.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Članovi koji sudjeluju u podatkovnom ekosustavu trebali bi biti upoznati s njegovim modelom upravljanja i svim izmjenama koje se u njemu unesu.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Model upravljanja trebao bi biti lako razumljiv svim sudionicima ekosustava.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Mogu se definirati uvjeti za dijeljenje podataka"),
    req("RC2.1",
      tr: "Pružatelji podataka slobodni su definirati uvjete pod kojima žele razmjenjivati svoje podatke. (Napomena: Prije dijeljenja podatkovnih resursa pružatelji podataka trebali bi osigurati odgovarajuće dopuštenje vlasnika podataka.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Uvjeti za razmjenu podataka trebali bi biti opisani jasno i nedvosmisleno kako bi bili lako razumljivi korisnicima podataka.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Uvjeti za razmjenu podataka trebali bi biti izraženi putem licencija za podatke ili ugovora o dijeljenju podataka temeljenih na dobro definiranim predlošcima ili normama.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Uvjeti bi trebali biti usklađeni s cjelokupnim modelom upravljanja podatkovnog ekosustava i ne smiju biti u sukobu s njim. (Napomena: Pružatelj podataka može odlučiti da neće sudjelovati u podatkovnom ekosustavu ako je temeljni model upravljanja previše restriktivan ili previše popustljiv.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Može se provjeriti usklađenost s uvjetima dijeljenja podataka"),
    req("RC3.1",
      tr: "Orkestrator podatkovnog ekosustava mora moći utvrditi usklađenost svojih sudionika s temeljnim modelom upravljanja.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Pružatelji podataka trebali bi moći utvrditi da je uporaba podataka od strane korisnika podataka u skladu s prethodno dogovorenim uvjetima.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Korisnici podataka trebali bi moći utvrditi da isporuka podataka od strane pružatelja podataka prati prethodno dogovorene uvjete.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
      tr: "Dostupni podatkovni resursi mogu se otkriti"),
    req("RC4.1",
      tr: "Korisnici podataka trebali bi moći otkriti koji su podaci dostupni u ekosustavu dijeljenja podataka bez prethodnog saznanja o njima.",
      en: "Data users should be able to discover what data is available in a data sharing ecosystem without prior knowledge of it."),
    req("RC4.2",
      tr: "Podatkovni resursi trebali bi biti prikladno opisani metapodacima kako bi korisnici podataka mogli donositi pouzdane odluke o njihovoj daljnjoj namjeravanoj uporabi.",
      en: "Data assets should be adequately described with metadata so that data users can make reliable decisions about their further intended use."),
    req("RC4.3",
