#fit-page("MIM3 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM3",
    title:  "Čo hovorí špecifikácia",
    leadin: "Všetky požiadavky tohto MIM zo špecifikácie MIMs Plus 9.0. Špecifikácia existuje len po anglicky: slovenské znenie je neoficiálny preklad autora brožúry, záväzný je anglický originál pod ním.",
    back:   "späť na zoznam",
  )

  #spec-list(mim: "MIM3",
    capability("C1", "Governance rules for the data sharing ecosystem can be defined",
      tr: "Je možné definovať pravidlá správy ekosystému zdieľania údajov"),
    req("RC1.1",
      tr: "Orchestrátor dátového ekosystému má mať možnosť definovať model správy (napr. súbor pravidiel), ktorý určuje pravidlá členstva, roly, zodpovednosti a povinnosti účastníkov ekosystému a celkové princípy výmeny údajov medzi nimi.",
      en: "The orchestrator of a data ecosystem should be able to define a governance model (e.g. a rulebook) that outlines membership rules, the roles, responsibilities and obligations of ecosystem participants, and the overall principles that govern data exchange between them."),
    req("RC1.2",
      tr: "Členovia, ktorí sa zúčastňujú na dátovom ekosystéme, majú poznať jeho model správy a všetky jeho zmeny.",
      en: "Members who participate in a data ecosystem should be aware of its governance model and any changes made to it."),
    req("RC1.3",
      tr: "Model správy má byť ľahko zrozumiteľný pre všetkých účastníkov ekosystému.",
      en: "The governance model should be easily comprehensible by all ecosystem participants."),
    capability("C2", "Terms and conditions for data sharing can be defined",
      tr: "Je možné definovať podmienky zdieľania údajov"),
    req("RC2.1",
      tr: "Poskytovatelia údajov môžu slobodne určiť podmienky, za ktorých chcú svoje údaje vymieňať. (Poznámka: Pred zdieľaním dátových aktív si majú poskytovatelia overiť, že majú primerané povolenie od vlastníkov údajov.)",
      en: "Data providers are free to define terms and conditions under which they want their data to be exchanged. (Note: Before sharing data assets, data providers should ensure they have adequate permission from data owners.)"),
    req("RC2.2",
      tr: "Podmienky výmeny údajov majú byť popísané jasne a jednoznačne, aby boli pre používateľov údajov ľahko zrozumiteľné.",
      en: "Terms and conditions for a data exchange should be described clearly and unambiguously so that they are easily understandable for data users."),
    req("RC2.3",
      tr: "Podmienky výmeny údajov majú byť vyjadrené prostredníctvom dátových licencií alebo zmlúv o zdieľaní údajov založených na dobre definovaných šablónach alebo štandardoch.",
      en: "Terms and conditions for a data exchange should be expressed through data licences or data sharing agreements based on well-defined templates or standards."),
    req("RC2.4",
      tr: "Podmienky majú byť v súlade s celkovým modelom správy dátového ekosystému a nesmú mu odporovať. (Poznámka: Poskytovateľ údajov sa môže rozhodnúť, že sa na dátovom ekosystéme nezúčastní, ak je jeho model správy príliš reštriktívny alebo príliš voľný.)",
      en: "Terms and conditions should be in line with the overall governance model of the data ecosystem and must not conflict with it. (Note: A data provider can decide not to participate in a data ecosystem if the underlying governance model is too restrictive or too permissive.)"),
    capability("C3", "Compliance with data sharing terms and conditions can be validated",
      tr: "Je možné overiť dodržiavanie podmienok zdieľania údajov"),
    req("RC3.1",
      tr: "Orchestrátor dátového ekosystému musí byť schopný overiť, či účastníci dodržiavajú príslušný model správy.",
      en: "The orchestrator of a data ecosystem must be able to ascertain compliance of its participants with the underlying governance model."),
    req("RC3.2",
      tr: "Poskytovatelia údajov majú mať možnosť overiť, že používateľ údajov ich používa v súlade s vopred dohodnutými podmienkami.",
      en: "Data providers should be able to ascertain that the use of data by a data user complies with previously agreed-upon terms and conditions."),
    req("RC3.3",
      tr: "Používatelia údajov majú mať možnosť overiť, že poskytovateľ dodáva údaje v súlade s vopred dohodnutými podmienkami.",
      en: "Data users should be able to ascertain that the data provider's supply of data follows previously agreed-upon terms and conditions."),
    capability("C4", "Available data assets can be discovered",
