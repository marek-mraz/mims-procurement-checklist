#fit-page("MIM2 specification", floor: 92, flow: true)[
  #spec-page(
    id:     "MIM2",
    title:  "Čo hovorí špecifikácia",
    leadin: "Všetky požiadavky tohto MIM zo špecifikácie MIMs Plus 9.0. Špecifikácia existuje len po anglicky: slovenské znenie je neoficiálny preklad autora brožúry, záväzný je anglický originál pod ním.",
    back:   "späť na zoznam",
  )

  #spec-list(mim: "MIM2",
    capability("C1", "All entities included in data sources are described using consistent data models to enable interoperability for applications and systems",
      tr: "Všetky entity v zdrojoch údajov sú popísané konzistentnými dátovými modelmi, aby boli aplikácie a systémy interoperabilné"),
    req("R1.1",
      tr: "Dátové modely použité pre všetky entity v ktoromkoľvek zdroji údajov musia byť explicitne uvedené. Musia byť dobre zdokumentované a mať popisné metadáta, v ktorých sú použité pojmy sémanticky jednoznačné. Pri atribútoch týkajúcich sa merných jednotiek, formátov času a pod. musia byť použité jednotky, formáty a pod. explicitne uvedené. Dátové modely majú byť katalogizované, aby sa dali ľahko nájsť.",
      en: "Data models used for all entities in any data source shall be made explicit. They shall be well documented and have descriptive metadata, where the terms used shall be semantically unambiguous. For attributes related to units of measurement, time formats etc, the units, formats etc, used shall be made explicit. The data models should be catalogued so that they can be easily findable."),
    req("R1.2a",
      tr: "Použité dátové modely musia (vždy, keď je to možné) vychádzať zo všeobecne uznávaných štandardizovaných dátových modelov uvedených v špecifikácii.",
      en: "Data models used shall be based (wherever possible) on commonly recognised standardised data models as listed below"),
    req("R1.2b",
      tr: "Ak nie je možné použiť existujúce štandardizované dátové modely, je potrebné usilovať sa o rozšírenie tých existujúcich štandardizovaných dátových modelov, ktoré sú najbližšie, alebo definovať nové, a to podľa osvedčených postupov a konvencií komunity alebo organizácie, ktorá dátové modely definuje.",
      en: "Where it is not possible to use existing standardised data models, efforts shall be made to extend existing standardised data models that are most closely aligned or to define new ones, following best practice and conventions of the community or organisation defining the data models."),
    req("R1.3",
      tr: "Použité dátové modely musia podporovať výmenu údajov uplatnením príslušných požiadaviek MIMs o prístupe k údajom a prepojení údajov.",
      en: "Data models used shall support the exchange of data by using the relevant requirements of the MIMs on Accessing data and Interlinking data"),
    capability("C2", "Different data models for the same entity that are used within a common data sharing ecosystem should be easily transformable into a common data model",
      tr: "Rôzne dátové modely tej istej entity používané v spoločnom ekosystéme zdieľania údajov majú byť ľahko transformovateľné do spoločného dátového modelu"),
    req("R2.1",
      tr: "Pre každý dátový ekosystém má byť vytvorený spoločný dátový model každej kľúčovej entity. Tento spoločný model má obsahovať všetky polia z rôznych dátových modelov danej entity, ktoré sa v ekosystéme používajú. Každý z týchto dátových modelov potom možno transformovať do spoločného dátového modelu.",
      en: "A common data model for each key entity should be developed for any data ecosystem. That common data model should contain all the fields included within the different data models for that entity that are used within that data ecosystem. Each different data model used within that data ecosystem could then be transformed into the common data model."),
    capability("C3", "Any data and its associated metadata can be shared in open, standardised, data transport formats so that data can be exchanged and interpreted consistently by different tools and implementations",
      tr: "Údaje aj ich metadáta možno zdieľať v otvorených, štandardizovaných prenosových formátoch, aby ich rôzne nástroje a implementácie vymieňali a interpretovali konzistentne"),
    req("R3.1",
      tr: "Každý použitý dátový model musí mať aspoň jeden definovaný strojovo čitateľný prenosový formát („serializáciu“), ktorý je otvorený, verejne dostupný a nezávislý od implementácie.",
      en: "Each data model used shall have at least one defined machine-readable data transport format (“serialisation”) that is open, publicly available and implementation-independent."),
    req("R3.2",
      tr: "Dokumentácia prenosového formátu má postačovať na vytvorenie neproprietárnej aplikácie alebo interpretera, ktorý dokáže zrekonštruovať všetky údaje uložené v tomto formáte.",
      en: "The documentation of the data transport format should be sufficient to allow the creation of non-proprietary application or interpretor that is able to reconstruct all the data stored in such a data format."),
    req("R3.3",
      tr: "Ak sa pre ten istý dátový model podporuje viacero prenosových formátov, musia reprezentovať ten istý informačný obsah konzistentne a bez straty významu.",
      en: "Where multiple data transport formats are supported for the same data model, they shall represent the same information content consistently and without loss of meaning."),
    req("R3.4",
      tr: "Reprezentácia má podporovať validáciu pomocou verejne publikovaných schém, gramatík alebo rovnocenných strojovo čitateľných obmedzení, ak pre zvolený formát takéto validačné mechanizmy existujú.",
      en: "The representation should support validation using openly published schemas, grammars, or equivalent machine-readable constraints, where such validation mechanisms exist for the chosen format."),
    capability("C4", "When useful, it should be possible to create \"Application Profiles\" for a data model, so that use case specific attributes can be added or specified without changing the underlying data model",
      tr: "Ak je to užitočné, má byť možné vytvárať pre dátový model „aplikačné profily“, aby sa dali pridať alebo spresniť atribúty špecifické pre prípad použitia bez zmeny základného dátového modelu"),
    req("R4.1",
      tr: "Aplikačné profily, ktoré rozširujú dátový model, nemajú ovplyvniť už existujúci model a jeho používateľov.",
      en: "Application Profiles that extend a data model should not impact the already existing model and its users"),
    req("R4.2",
      tr: "Špecializácie alebo rozšírenia zavedené v aplikačnom profile modelu majú byť dobre zdokumentované, oddelene od základného dátového modelu.",
      en: "The specialisations or extensions introduced in the Application Profile of the model should be well documented, separate from the base data model"),
  )

  #spec-link("Celé znenie špecifikácie:", "https://mims.oascities.org/representing-data")
]
